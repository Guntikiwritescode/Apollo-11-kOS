// PORT: Physical bank 12. Shared continuation entries, slots 12843–12843.
function agcAotUnit723 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE CONIC_SUBROUTINES.agc:1267
//# Page 1293
// PORT: SOURCE CONIC_SUBROUTINES.agc:1268
//		TC	POLY
// PORT: Fixed ROM slots 12843.
    if slot <> 12843 or instruction <> 3705 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3705, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[723] to agcAotUnit723@.

