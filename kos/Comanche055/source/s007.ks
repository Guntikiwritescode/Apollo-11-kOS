// PORT: Physical bank 12. Shared continuation entries, slots 12572–12572.
function agcAotUnit716 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE CONIC_SUBROUTINES.agc:852
//		TC	POLY
// PORT: Fixed ROM slots 12572.
    if slot <> 12572 or instruction <> 3705 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3705, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[716] to agcAotUnit716@.

