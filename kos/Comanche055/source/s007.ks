// bank 12, slots 12718-12719
function agcAotUnit720 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 12718 {
// CONIC_SUBROUTINES.agc:1009
//
// CONIC_SUBROUTINES.agc:1010
//CHECKCTR	CS	ONE
// slot 12718
        if slot <> 12718 or instruction <> 18959 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local fixedOperand is mod(readEffective:call(words, 2575), 32768).
            set words[0] to agcSignExtend(32767 - fixedOperand).
            return list(false, false, true, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// CONIC_SUBROUTINES.agc:1011
//		INDEX	FIXLOC
// slot 12719
        if slot <> 12719 or instruction <> 20560 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        if extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
