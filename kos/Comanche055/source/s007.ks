// PORT: Physical bank 12. Shared continuation entries, slots 13290–13290.
function agcAotUnit725 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE CONIC_SUBROUTINES.agc:1752
//		TC	POODOO
// PORT: Fixed ROM slots 13290.
    if slot <> 13290 or instruction <> 3025 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3025, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[725] to agcAotUnit725@.

