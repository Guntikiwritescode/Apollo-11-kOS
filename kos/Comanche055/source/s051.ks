                                return agcCoreControlExecute(words, 1231, words[0], readEffective).
                            }
                            return choose false if checkOnly else -1.
                        } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3109
//		CAF	ZERO
// slot 36740
                            if slot <> 36740 or instruction <> 14865 { return choose false if checkOnly else -1. }
