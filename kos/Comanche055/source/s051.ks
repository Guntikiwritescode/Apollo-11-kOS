// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2760
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2761
//ALMCYCLE	TC	FALTON		# TURN ON CHECK FAIL LIGHT.
// PORT: Fixed ROM slots 4209.
            if slot <> 4209 or instruction <> 2304 { return choose false if checkOnly else -1. }
            if not extended {
