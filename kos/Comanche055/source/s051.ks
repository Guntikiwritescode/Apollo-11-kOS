//# THE INPUT CODES ASSUMED FOR THE KEYBOARD ARE,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:320
//#	0		10000
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:321
//#	1		00001
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:322
//#	9		01001
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:323
//#	VERB		10001
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:324
//#	ERROR RES	10010
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:325
//#	KEY RLSE	11001
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:326
//#	+		11010
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:327
//#	-		11011
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:328
//#	ENTER		11100
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:329
//#	CLEAR		11110
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:330
//#	NOUN		11111
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:331
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:332
//# OUTPUT FORMAT FOR DISPLAY PANEL.  SET OUT0 TO AAAABCCCCCDDDDD.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:333
//# A'S 	SELECTS A RELAYWORD.  THIS DETERMINES WHICH PAIR OF CHARACTERS ARE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:334
//#     	ENERGIZED.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:335
//# B	FOR SPECIAL RELAYS SUCH AS SIGNS ETC.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:336
//# C'S	5 BIT RELAY CODE FOR LEFT CHAR OF PAIR SELECTED BY RELAYWORD.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:337
//# D'S	5 BIT RELAY CODE FOR RIGHT CHAR OF PAIR SELECTED BY RELAYWORD.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:338
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:339
//# THE PANEL APPEARS AS FOLLOWS,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:340
//#	MD1		MD2 (MAJOR MODE)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:341
//#	VD1		VD2 (VERB)			ND1		ND2 (NOUN)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:342
//#	R1D1		R1D2		R1D3		R1D4		R1D5 (R1)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:343
//#	R2D1		R2D2		R2D3		R2D4		R2D5 (R2)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:344
//#	R3D1		R3D2		R3D3		R3D4		R3D5 (R3)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:345
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:346
//# EACH OF THESE IS GIVEN A DSPCOUNT NUMBER FOR USE WITHIN COMPUTATION ONLY
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:347
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:348
