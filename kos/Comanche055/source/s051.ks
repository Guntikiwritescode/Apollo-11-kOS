// bank 02, slots 4240-4259
function agcAotUnit154 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4249 {
        if slot <= 4244 {
            if slot <= 4241 {
                if slot <= 4240 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3116
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3117
//# IF INTERNAL MACH CADR TO BE SPECIFIED, MPAC+2 WILL BE PLACED INTO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3118
//# NOUNCADR IN ENTPAS0 (INTMCTBS).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3119
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3120
//		SETLOC	NVSUBEND +2
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3121
//		COUNT	02/PIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3122
//					# FORCE BIT 15 OF MONSAVE1 TO .
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3123
//KILMONON	CAF	BIT15		# 	THIS IS THE KILL MONITOR BIT.
// slot 4240
                    if slot <> 4240 or instruction <> 14849 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        local fixedOperand is mod(readEffective:call(words, 2561), 32768).
                        set words[0] to agcSignExtend(fixedOperand).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3124
//		TS	MONSAVE1	# TURN OFF BIT 14, THE EXTERNAL
// slot 4241
                    if slot <> 4241 or instruction <> 23057 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 23057, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4242 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3125
//					# 	MONITOR BIT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3126
//		TC	Q
// slot 4242
                    if slot <> 4242 or instruction <> 2 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4243 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3127
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3128
//# LOADSTAT	+0	INACTIVE (WAITING FOR DATA).  SET BY NVSUB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3129
//#		+1	PROCEED NO DATA.  SET BY SPECIAL VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3130
//#		-1	TERMINATE.  SET BY SPECIAL VERB.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3131
//#		-0	DATA IN.  	SET BY END OF LOAD ROUTINE.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3132
//#			OR RESEQUENCE.  SET BY VERB 32
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3133
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3134
//# L TO ENDIDLE (FIXED FIXED).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3135
//# ROUTINES THAT REQUEST LOADS THROUGH NVSUB SHOULD USE ENDIDLE WHILE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3136
//# WAITING FOR THE DATA TO BE LOADED.  ENDIDLE PUTS CURRENT JOB TO SLEEP.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3137
//# ENDIDLE CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3138
//# SINCE JOB SLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3139
//# RECALTST TESTS LOADSTAT AND WAKES JOB UP TO,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3140
//#	L+1	FOR TERMINATE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3141
//#	L+2	FOR PROCEED WITHOUT DATA
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3142
//#	L+3	FOR DATA IN, OR RESEQUENCE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3143
//# IT DOES NOTHING IF LOADSTAT INDICATES WAITING FOR DTA.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3144
//# Page 373
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3145
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3146
//# ENDIDLE ABORTS (WITH CODE 1206) IF A SECOND JOB ATTEMPTS TO GO TO SLEEP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3147
//# IN PINBALL.  IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO ENDIDLE WHEN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3148
//#	1)	CADRSTOR NOT= +0.  THIS IS THE CASE WHERE THE CAPACITY OF ENDIDLE IS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3149
//#		EXCEEDED.  (+-NZ INDICATES A JOB IS ALREADY ASLEEP DUE TO ENDIDDLE.)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3150
//#	2)	DSPLIST NOT= +0.  THIS INDICATES A JOB IS ALREADY ASLEEP DUE TO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3151
//#		NVSUBUSY.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3152
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3153
//ENDIDLE		LXCH	Q		# RETURN ADDRESS INTO L.
// slot 4243
                        if slot <> 4243 or instruction <> 9218 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                            agcCoreExchange(words, 1, 2, readPhysical).
                            return list(false, false, inheritedTransient, false, false).
                        }
                        return choose false if checkOnly else -1.
                    } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3154
//		TC	ISCADR+0	# ABORT IF CADRSTOR NOT= +0.
// slot 4244
                        if slot <> 4244 or instruction <> 2204 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            return agcCoreControlExecute(words, 2204, words[0], readEffective).
                        }
                        return choose false if checkOnly else -1.
                    }
                }
            }
        } else {
            if slot <= 4246 {
                if slot <= 4245 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3155
//		TC	ISLIST+0	# ABORT IF DSPLIST NOT= +0
// slot 4245
                    if slot <> 4245 or instruction <> 2208 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2208, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3156
//		CA	L		# DON'T SET DSPLOC TO 1 SO CAN USE
// slot 4246
                    if slot <> 4246 or instruction <> 12289 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCA(words, 1).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4247 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3157
//		MASK	LOW10		# ENDIDLE WITH NVSUB INITIATE MONITOR.
// slot 4247
                    if slot <> 4247 or instruction <> 31276 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        set words[0] to agcOverflowCorrected(words[0]).
                        local fixedOperand is mod(readEffective:call(words, 2604), 32768).
                        if fixedOperand = 1023 {
                            set words[0] to agcSignExtend(mod(floor(words[0] / 1), 1024) * 1).
                        } else {
                            set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                        }
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4248 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3158
//		AD	FBANK		# SAME STRATEGY FOR CADR AS MAKECADR.
// slot 4248
                        if slot <> 4248 or instruction <> 24580 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                            agcCoreAD(words, 4).
                            return list(false, false, inheritedTransient, false, false).
                        }
                        return choose false if checkOnly else -1.
                    } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3159
//		TS	CADRSTOR
// slot 4249
                        if slot <> 4249 or instruction <> 23074 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            return agcCoreControlExecute(words, 23074, words[0], readEffective).
                        }
                        return choose false if checkOnly else -1.
                    }
                }
            }
        }
    } else {
        if slot <= 4254 {
            if slot <= 4251 {
                if slot <= 4250 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3160
//		TC	JOBSLEEP
// slot 4250
                    if slot <> 4250 or instruction <> 2685 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2685, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3161
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3162
//ENDINST		TC	ENDOFJOB
// slot 4251
                    if slot <> 4251 or instruction <> 2703 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2703, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4252 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3163
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3164
//ISCADR+0	CCS	CADRSTOR	# ABORTS (CODE 01206) IF CADRSTOR NOT= +0.
// slot 4252
                    if slot <> 4252 or instruction <> 4642 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCCS(words, 546).
                        return list(false, false, inheritedTransient, false, false).
