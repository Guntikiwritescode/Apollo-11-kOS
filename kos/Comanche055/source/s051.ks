//# NVSUBSY1 MUST BE IN BANK 27 OR LOWER, SO IT WILL PUT CALLER TO SLEEP
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3550
//# WITH HIS PROPER SUPERBITS.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3551
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3552
