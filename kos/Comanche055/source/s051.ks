                    return agcCoreControlExecute(words, 2208, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        }
    } else {
        if slot <= 6531 {
            if slot <= 6530 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3558
//		TC	RELDSPON
// PORT: Fixed ROM slots 6530.
