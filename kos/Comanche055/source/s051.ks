            } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3183
//		CS	VD1
// slot 4266
                if slot <> 4266 or instruction <> 18684 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local fixedOperand is mod(readEffective:call(words, 2300), 32768).
                    set words[0] to agcSignExtend(32767 - fixedOperand).
                    return list(false, false, true, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 4267 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3184
//		TS	DSPCOUNT
// slot 4267
