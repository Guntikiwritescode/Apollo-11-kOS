//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3555
//NVSUBSY1	TS	L
// PORT: Fixed ROM slots 6527.
            if slot <> 6527 or instruction <> 22529 { return choose false if checkOnly else -1. }
            if not extended {
