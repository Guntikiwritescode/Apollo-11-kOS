// PORT: Physical bank 02. Shared continuation entries, slots 4240–4259.
function agcAotUnit154 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4249 {
        if slot <= 4244 {
            if slot <= 4241 {
                if slot <= 4240 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3116
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3117
//# IF INTERNAL MACH CADR TO BE SPECIFIED, MPAC+2 WILL BE PLACED INTO
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3118
//# NOUNCADR IN ENTPAS0 (INTMCTBS).
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3119
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3120
//		SETLOC	NVSUBEND +2
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3121
//		COUNT	02/PIN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3122
//					# FORCE BIT 15 OF MONSAVE1 TO .
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3123
//KILMONON	CAF	BIT15		# 	THIS IS THE KILL MONITOR BIT.
// PORT: Fixed ROM slots 4240.
                    if slot <> 4240 or instruction <> 14849 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        local fixedOperand is mod(readEffective:call(words, 2561), 32768).
                        set words[0] to agcSignExtend(fixedOperand).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3124
//		TS	MONSAVE1	# TURN OFF BIT 14, THE EXTERNAL
// PORT: Fixed ROM slots 4241.
                    if slot <> 4241 or instruction <> 23057 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 23057, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4242 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3125
//					# 	MONITOR BIT.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3126
//		TC	Q
// PORT: Fixed ROM slots 4242.
                    if slot <> 4242 or instruction <> 2 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4243 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3127
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3128
//# LOADSTAT	+0	INACTIVE (WAITING FOR DATA).  SET BY NVSUB
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3129
//#		+1	PROCEED NO DATA.  SET BY SPECIAL VERB
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3130
//#		-1	TERMINATE.  SET BY SPECIAL VERB.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3131
//#		-0	DATA IN.  	SET BY END OF LOAD ROUTINE.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3132
//#			OR RESEQUENCE.  SET BY VERB 32
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3133
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3134
//# L TO ENDIDLE (FIXED FIXED).
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3135
//# ROUTINES THAT REQUEST LOADS THROUGH NVSUB SHOULD USE ENDIDLE WHILE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3136
//# WAITING FOR THE DATA TO BE LOADED.  ENDIDLE PUTS CURRENT JOB TO SLEEP.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3137
//# ENDIDLE CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3138
//# SINCE JOB SLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3139
//# RECALTST TESTS LOADSTAT AND WAKES JOB UP TO,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3140
//#	L+1	FOR TERMINATE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3141
//#	L+2	FOR PROCEED WITHOUT DATA
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3142
//#	L+3	FOR DATA IN, OR RESEQUENCE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3143
//# IT DOES NOTHING IF LOADSTAT INDICATES WAITING FOR DTA.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3144
//# Page 373
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3145
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3146
//# ENDIDLE ABORTS (WITH CODE 1206) IF A SECOND JOB ATTEMPTS TO GO TO SLEEP
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3147
//# IN PINBALL.  IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO ENDIDLE WHEN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3148
//#	1)	CADRSTOR NOT= +0.  THIS IS THE CASE WHERE THE CAPACITY OF ENDIDLE IS
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3149
//#		EXCEEDED.  (+-NZ INDICATES A JOB IS ALREADY ASLEEP DUE TO ENDIDDLE.)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3150
//#	2)	DSPLIST NOT= +0.  THIS INDICATES A JOB IS ALREADY ASLEEP DUE TO
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3151
//#		NVSUBUSY.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3152
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3153
//ENDIDLE		LXCH	Q		# RETURN ADDRESS INTO L.
// PORT: Fixed ROM slots 4243.
                        if slot <> 4243 or instruction <> 9218 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                            agcCoreExchange(words, 1, 2, readPhysical).
                            return list(false, false, inheritedTransient, false, false).
                        }
                        return choose false if checkOnly else -1.
                    } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3154
//		TC	ISCADR+0	# ABORT IF CADRSTOR NOT= +0.
// PORT: Fixed ROM slots 4244.
                        if slot <> 4244 or instruction <> 2204 { return choose false if checkOnly else -1. }
                        if not extended {
