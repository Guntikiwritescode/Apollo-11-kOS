// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2758
//		SETLOC	MID7 +1
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2759
