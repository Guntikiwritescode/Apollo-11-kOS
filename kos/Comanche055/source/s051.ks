//# NOUN CODE L/40, NORMAL NOUN CASE.  NOUN CODE G/E 40, MIXED NOUN CASE.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1103
//# FOR NORMAL CASE, NNADTAB CONTAINS ONE       ECADR FOR EACH NOUN.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1104
//# +0 INDICATES NOUN NOT USED.   - ENTRY INDICATES MACHINE CADR(E OR F) TO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1105
//# BE SPECIFIED. -1 INDICATES CHANNEL TO BE SPECIFIED. -0 INDICATES AUGMENT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1106
//# OF LAST MACHINE CADR SUPPLIED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1107
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1108
//# FOR MIXED CASE, NNADTAB CONTAINS ONE INDIRECT ADDRESS(IDADDREL) IN LOW
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1109
//# 10 BITS, AND THE COMPONENT CODE NUMBER IN THE HIGH 5 BITS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1110
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1111
//# NNTYPTAB IS A PACKED TABLE OF THE FORM MMMMMNNNNNPPPPP.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1112
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1113
//# FOR THE NORMAL CASE,  M-S ARE THE COMPONENT CODE NUMBER.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1114
//#                       N-S ARE THE SF ROUTINE CODE NUMBER.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1115
//#                       P-S ARE THE SF CONSTANT CODE NUMBER.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1116
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1117
//# MIXED-CASE,M-S ARE THE SF CONSTANT3 CODE NUMBER      3 COMPONENT CASE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1118
//#            N-S ARE THE SF CONSTANT2 CODE NUMBER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1119
//#            P-S ARE THE SF CONSTANT1 CODE NUMBER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1120
//#            N-S ARE THE SF CONSTANT2 CODE NUMBER      2 COMPONENT CASE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1121
//#            P-S ARE THE SF CONSTANT1 CODE NUMBER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1122
//#            P-S ARE THE SF CONSTANT1 CODE NUMBER       1 COMPONENT CASE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1123
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1124
//# THERE IS ALSO AN INDIRECT ADDRESS TABLE(IDADDTAB) FOR MIXED CASE ONLY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1125
//# EACH ENTRY CONTAINS ONE ECADR.    IDADDREL IS THE RELATIVE ADDRESS OF
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1126
//# THE FIRST OF THESE ENTRIES.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1127
//# THERE IS ONE ENTRY IN THIS TABEL FOR EACH COMPONENT OF A MIXED NOUN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1128
//# THEY ARE LISTED IN ORDER OF ASCENDING K.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1129
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1130
//# THERE IS ALSO A SCALE FACTOR ROUTINE NUMBER TABLE( RUTMXTAB ) FOR MIXED
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1131
//# CASE ONLY. THERE IS ONE ENTRY PER MIXED NOUN. THE FORM IS,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1132
//#       QQQQQRRRRRSSSSS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1133
//# Q-S ARE THE SF ROUTINE 3 CODE NUMBER     3 COMPONENT CASE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1134
//# R-S ARE THE SF ROUTINE 2 CODE NUMBER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1135
//# S-S ARE THE SF ROUTINE 1 CODE NUMBER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1136
//# R-S ARE THE SF ROUTINE 2 CODE NUMBER     2 COMPONENT CASE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1137
//# S-S ARE THE SF ROUTINE 1 CODE NUMBER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1138
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1139
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1140
//# IN OCTAL DISPLAY AND LOAD (OCT OR DEC) VERBS, EXCLUDE USE OF VERBS WHOSE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1141
//# COMPONENT NUMBER IS GREATER THAN THE NUMBER OF COMPONENTS IN NOUN.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1142
//# (ALL MACHINE ADDRESS TO BE SPECIFIED NOUNS ARE 3 COMPONENT.)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1143
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1144
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1145
//# IN MULTI-COMPONENT LOAD VERBS, NO MIXING OF OCTAL AND DECIMAL DATA
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1146
//# COMPONENT WORDS IS ALLOWED.  ALARM IF VIOLATION.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1147
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1148
//# IN DECIMAL LOADS OF DATA, 5 NUMERICAL CHARACTERS MUST BE KEYED IN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1149
//# BEFORE EACH ENTER. IF NOT, ALARM.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1150
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1151
//# Page 331
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1152
//# DISPLAY VERBS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1153
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1154
//DSPABC		CS	TWO
// slot 36075
        if slot <> 36075 or instruction <> 18958 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local fixedOperand is mod(readEffective:call(words, 2574), 32768).
            set words[0] to agcSignExtend(32767 - fixedOperand).
            return list(false, false, true, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
        if slot <= 36076 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1155
//		TC	COMPTEST
// slot 36076
            if slot <> 36076 or instruction <> 1300 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 1300, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1156
//		INDEX	NOUNADD
// slot 36077
            if slot <> 36077 or instruction <> 20581 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20581, words[0], readEffective).
            }
            if extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20581, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
set agcAotRoutes[2074] to agcAotUnit2074@.

