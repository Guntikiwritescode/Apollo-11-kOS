                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4253 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3165
//		TC	DSPABORT	# RETURNS IF CADRSTOR = +0.
// slot 4253
                        if slot <> 4253 or instruction <> 2211 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            return agcCoreControlExecute(words, 2211, words[0], readEffective).
                        }
                        return choose false if checkOnly else -1.
                    } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3166
//		TC	Q
// slot 4254
                        if slot <> 4254 or instruction <> 2 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            return agcCoreControlExecute(words, 2, words[0], readEffective).
                        }
                        return choose false if checkOnly else -1.
                    }
                }
            }
        } else {
            if slot <= 4256 {
                if slot <= 4255 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3167
//		TC	DSPABORT
// slot 4255
                    if slot <> 4255 or instruction <> 2211 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2211, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3168
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3169
//ISLIST+0	CCS	DSPLIST		# ABORTS (CODE 01206) IF DSPLIST NOT= +0.
// slot 4256
                    if slot <> 4256 or instruction <> 4643 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCCS(words, 547).
                        return list(false, false, inheritedTransient, false, false).
