// bank 02, slots 4216-4236
function agcAotUnit152 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4225 {
        if slot <= 4220 {
            if slot <= 4217 {
                if slot <= 4216 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2942
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2943
//ENDRELDS	EQUALS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2944
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2945
//# Page 369
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2946
//# NVSUB IS USED FOR SUBROUTINE CALLS FROM WITHIN COMPUTER.  IT CAN BE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2947
//# USED TO CALL THE COMBINATION OF ANY DISPLAY, LOAD, OR MONITOR VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2948
//# TOGETHER WITH ANY NOUN AVAILABLE TO THE KEYBOARD.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2949
//# PLACE 0VVVVVVVNNNNNNN INTO A.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2950
//# V'S ARE THE 7-BIT VERB CODE.  N'S ARE THE 7-BIT NOUN CODE.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2951
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2952
//# IF NVSUB IS CALLED WITH THE FOLLOWING NEGATIVE NUMBERS (RATHER THAN THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2953
//# VERB-NOUN CODE) IN A, THEN THE DISPLAY IS BLANKED AS FOLLOWS ---
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2954
//# -4 FULL BLANK, -3 LEAVE MODE, -2 LEAVE MODE AND VERB, -1 BLANK R'S ONLY.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2955
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2956
//# NVSUB CAN BE USED WITH MACHINE CADR TO BE SPECIFIED BY PLACING THE CADR INTO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2957
//# MPAC+2 BEFORE THE STANDARD NVSUB CALL.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2958
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2959
//# NVSUB RETURNS TO 2+ CALLING LOC AFTER PERFORMING TASK, IF DISPLAY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2960
//# SYSTEM IS AVAILABLE.  THE NEW NOUN AND VERB CODES ARE DISPLAYED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2961
//# IF V'S =0, THE NEW NOUN CODE IS DISPLAYED ONLY (RETURN WITH NO FURTHER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2962
//# ACTION).  IF N'S =0, THE NEW VERB CODE IS DISPLAYED ONLY (RETURN WITH NO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2963
//# FURTHER ACTION).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2964
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2965
//# IT RETURNS TO 1+ CALLING LOC WITHOUT PERFORMING TASK, IF DISPLAY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2966
//# SYSTEM IS BLOCKED (NOTHING IS DISPLAYED IN THIS CASE).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2967
//# IT DOES TC ABORT (WITH OCT 01501) IF IT ENCOUNTERS A DISPLAY PROGRAM
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2968
//# ALARM CONDITION BEFORE RETURN TO CALLER.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2969
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2970
//# THE DISPLAY SYSTEM IS BLOCKED BY THE DEPRESSION OF ANY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2971
//# KEY, EXCEPT ERROR LIGHT RESET.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2972
//# IT IS RELEASED BY THE KEY RELEASE BUTTON, ALL EXTENDED VERBS,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2973
//# PROCEED WITHOUT DATA, TERMINATE, RESEQUENCE, INITIALIZE EXECUTIVE,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2974
//# RECALL PART OF RECALTST IF ENDIDLE WAS USED,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2975
//# VB = REQUEST EXECUTIVE, VB = REQUEST WAITLIST,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2976
//# MONITOR SET UP.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2977
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2978
//# THE DISPLAY SYSTEM IS ALSO BLOCKED BY THE EXTERNAL MONITOR BIT, WHICH
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2979
//# INDICATES AND EXTERNALLY INITIATED MONITOR IS RUNNING (SEE MONITOR).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2980
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2981
//# A NVSUB CALL THAT PASSES DSPLOCK AND THE EXTERNAL MONITOR BIT ENDS OLD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2982
//# MONITOR.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2983
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2984
//# DSPLOCK IS THE INTERLOCK FOR USE OF KEYBOARD AND DISPLAY SYSTEM WHICH
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2985
//# LOCKS OUT INTERNAL USE WHENEVER THERE IS EXTERNAL KEYBOARD ACTION.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2986
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2987
//# NVSUB SHOULD BE USED TWICE IN SUCCESSION FOR `PLEASE PERFORM' SITUATIONS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2988
//# (SIMILARLY FOR PLEASE MARK).  FIRST PLACE THE CODED NUMBER FOR WHAT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2989
//# ACTION IS DESIRED OF OPERATOR INTO THEREGISTERS REFERRED TO BY THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2990
//# `CHECKLIST' NOUN.  GO TO NVSUB WITH A DISPLAY VERB AND THE `CHECKLIST'
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2991
//# NOUN.  GO TO NVSUB AGAIN WITH THE `PLEASE PERFORM' VERB AND ZEROS IN THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2992
//# LOW 7 BITS.  THIS `PASTES UP' THE `PLEASE PERFORM' VERB INTO THE VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2993
//# LIGHTS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2994
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2995
//# NVMONOPT IS AN ENTRY SIMILAR TO NVSUB, BUT REQUIRING AN ADDITIONAL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2996
//# Page 370
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2997
//# PARAMETER IN L.  IT SHOULD BE USED ONLY WITH A MONITOR VERB-NOUN CODE IN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2998
//# A.  AFTER EACH MONITOR DISPLAY A *PLEASE* VERB WILL BE PASTED IN THE VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2999
//# LIGHTS OR DATA WILL BE BLANKED (OR BOTH) ACCORDING TO THE OPTIONS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3000
//# SPECIFIED IN L.  IF BITS 8-14 OF L ARE OTHER THAN ZERO, THEN THEY WILL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3001
//# BE INTERPRETED AS A VERB CODE AND PASTED IN THE VERB LIGHTS.  (THIS VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3002
//# CODE SHOULD DESIGNATE ONE OF THE *PLEASE* VERBS.)  IF BITS 1-3 OF L ARE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3003
//# OTHER THAN ZERO, THEN THEY WILL BE USED BO BLANK DATA BY BEING FED TO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3004
//# BLANKSUB.  IF NVMONOPT IS USED WITH A VERB OTHER THAN A MONITOR VERB,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3005
//# THE PARAMETER IN L HAS NO EFFECT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3006
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3007
//# NVSUB IN FIXED-FIXED PLACES 2+CALLING LOC INTO NVQTEM, TC NVSUBEND INTO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3008
//# ENTRET.  (THIS WILL RESTORE OLD CALLING BANK BITS)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3009
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3010
//		SETLOC	ENDALM +1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3011
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3012
//		COUNT	02/PIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3013
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3014
//NVSUB		LXCH	7		# ZERO NVMONOPT OPTIONS
// slot 4216
                    if slot <> 4216 or instruction <> 9223 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreExchange(words, 1, 7, readPhysical).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3015
//NVMONOPT	TS	NVTEMP
// slot 4217
                    if slot <> 4217 or instruction <> 22611 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22611, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4218 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3016
//		CAF	BIT14
// slot 4218
                    if slot <> 4218 or instruction <> 14850 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        local fixedOperand is mod(readEffective:call(words, 2562), 32768).
                        set words[0] to agcSignExtend(fixedOperand).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4219 {
