                }
                return choose false if checkOnly else -1.
            } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3181
//		CAF	34DEC
// slot 4264
                if slot <> 4264 or instruction <> 14510 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
