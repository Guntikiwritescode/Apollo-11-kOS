                    set words[0] to agcSignExtend(fixedOperand).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        }
    } else {
        if slot <= 4266 {
            if slot <= 4265 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3182
//		TS	REQRET		# LEAVE ENTER SET FOR ENTPASS0.
// PORT: Fixed ROM slots 4265.
                if slot <> 4265 or instruction <> 23051 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 23051, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3183
//		CS	VD1
// PORT: Fixed ROM slots 4266.
                if slot <> 4266 or instruction <> 18684 { return choose false if checkOnly else -1. }
