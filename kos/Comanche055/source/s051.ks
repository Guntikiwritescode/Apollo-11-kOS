//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3175
//# JAMTERM ALLOWS PROGRAMS TO PERFORM THE TERMINATE FUNCTION.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3176
//# IT DOES ENDOFJOB.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3177
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3178
//JAMTERM		CAF	PINSUPBT
