//# EXCEPT ERROR LIGHT RESET.  IT BEGINS AGAIN WHEN KEY RELEASE IS PERFORMED.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2305
//# MONITOR SAVES THE NOUN AND APPROPRIATE DISPLAY VERB IN MONSAVE.  IT SAVES
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2306
//# NOUNCADR IN MONSAVE1, IF NOUN = MACHINE CADR TO BE SPECIFIED.  BIT 15 OF
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2307
//# MONSAVE1 IS THE KILL MONITOR SIGNAL (KILLER BIT).  BIT 14 OF MONSAVE1
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2308
//# INDICATES THE CURRENT MONITOR WAS EXTERNALLY INITIATED (EXTERNAL
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2309
//# MONITOR BIT).  IT IS TURNED OFF BY RELDSP AND KILMONON.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2310
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2311
//# MONSAVE INDICATES IF MONITOR IS ON (+=ON, +0=OFF)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2312
//# IF MONSAVE IS +, MONITOR ENTERS NO REQUEST, BUT TURNS KILLER BIT OFF.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2313
//# IF MONSAVE IS +0, MONITOR ENTERS REQUEST AND TURNS KILLER BIT OFF.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2314
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2315
//# NVSUB (IF EXTERNAL MONITOR BIT IS OFF), VB=PROCEED WITHOUT DATA,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2316
//# VB=RESEQUENCE, AND VB=TERMINATE TURN KILL MONITOR BIT ON.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2317
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2318
//# IF KILLER BIT IS ON, MONREQ ENTERS NO FURTHER REQUESTS, ZEROS MONSAVE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2319
//# AND MONSAVE1 (TURNING OFF KILLER BIT AND EXTERNAL MONITOR BIT).
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2320
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2321
//# MONITOR DOESN'T TEST FOR MATBS SINCE NVSUB CAN HANDLE INTERNAL MATBS NOW.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2322
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2323
//		SETLOC	ENDRUTIN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2324
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2325
//		COUNT	41/PIN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2326
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2327
//MONITOR		CS	BIT15/14
// PORT: Fixed ROM slots 36504.
            if slot <> 36504 or instruction <> 18079 { return choose false if checkOnly else -1. }
            if not extended {
