// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3174
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3175
//# JAMTERM ALLOWS PROGRAMS TO PERFORM THE TERMINATE FUNCTION.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3176
//# IT DOES ENDOFJOB.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3177
