// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:232
//#EXITEM		=	INTB15+		# RETURN FOR SCALE FACTOR ROUTINE SELECT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:233
//#BLANKRET	=	INTB15+		# RETURN FOR 2BLANK
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:234
//#WRDRET		=	INTBIT15	# RETURN FOR 5BLANK.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:235
//#WDRET		=	INTBIT15	# RETURN FOR DSPWD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:236
//#DECRET		=	INTBIT15	# RETURN FOR PUTCOM(DEC LOAD)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:237
//#21/22REG	=	INTBIT15	# TEMP FOR CHARIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:238
//#UPDATRET	=	POLISH		# RETURN FOR UPDATNN, UPDATVB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:239
//#CHAR		=	POLISH		# TEMP FOR CHARIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:240
//#ERCNT		=	POLISH		# COUNTER FOR ERROR LIGHT RESET
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:241
//#DECOUNT	=	POLISH		# COUNTER FOR SCALING AND DISPLAY (DEC)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:242
//#SGNON		=	VBUF		# TEMP FOR +,- ON
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:243
//#NOUNTEM	=	VBUF		# COUNTER FOR MIXNOUN FETCH
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:244
//#DISTEM		= 	VBUF		# COUNTER FOR OCTAL DISPLAY VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:245
//#DECTEM		=	VBUF		# COUNTER FOR FETCH (DEC DISPLAY VERBS)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:246
//#SGNOFF		=	VBUF +1		# TEMP FOR +,- ON
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:247
//#NVTEMP		=	VBUF +1		# TEMP FOR NVSUB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:248
//#SFTEMP1	=	VBUF +1		# STORAGE FOR SF CONST HI PART (=SFTEMP2-1)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:249
//#HITEMIN	=	VBUF +1		# TEMP FOR LOAD OF HRS,MIN,SEC
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:250
//#					# 	MUST = LOTEMIN-1.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:251
//#CODE		=	VBUF +2		# FOR DSPIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:252
//#SFTEMP2	=	VBUF +2		# STORAGE FOR SF CONST LO PART (=SFTEMP1+1)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:253
//#LOTEMIN	=	VBUF +2		# TEMP FOR LOAD OF HRS,MIN,SEC
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:254
//#					# 	MUST = HITEMIN+1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:255
//#MIXTEMP	=	VBUF +3		# FOR MIXNOUN DATA
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:256
//#SIGNRET	=	VBUF +3		# RETURN FOR +,- ON
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:257
//# ALSO MIXTEMP+1 = VBUF+4, MIXTEMP+2 = VBUF+5
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:258
//#ENTRET		=	DOTINC		# EXIT FROM ENTER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:259
//#WDONT		=	DOTRET		# CHAR COUNTER FOR DSPWD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:260
//#INREL		=	DOTRET		# INPUT BUFFER SELECTOR (X,Y,Z, REG )
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:261
//#DSPMMTEM	=	MATINC		# DSPCOUNT SAVE FOR DSPMM
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:262
//#MIXBR		=	MATINC		# INDICATOR FOR MIXED OR NORMAL NOUN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:263
//#TEM1		ERASE			# EXEC TEMP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:264
//#DSREL		=	TEM1		# REL ADDRESS FOR DSPIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:265
//#TEM2		ERASE			# EXEC TEMP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:266
//#DSMAG		=	TEM2		# MAGNITUDE STORE FOR DSPIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:267
//#IDADDTEM	=	TEM2		# MIXNOUN INDIRECT ADDRESS STORAGE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:268
//#TEM3		ERASE			# EXEC TEMP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:269
//#COUNT		=	TEM3		# FOR DSPIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:270
//# Page 312
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:271
//#TEM4		ERASE			# EXEC TEMP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:272
//#LSTPTR		=	TEM4		# LIST POINTER FOR GRABUSY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:273
//#RELRET		=	TEM4		# RETURN FOR RELDSP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:274
//#FREERET	=	TEM4		# RETURN FOR FREEDSP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:275
//#DSPWDRET	=	TEM4		# RETURN FOR DSPSIGN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:276
//#SEPSCRET	=	TEM4		# RETURN FOR SEPSEC
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:277
//#SEPMNRET	=	TEM4		# RETURN FOR SEPMIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:278
//#TEM5		ERASE			# EXEC TEMP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:279
//#NOUNADD	=	TEM5		# TEMP STORAGE FOR NOUN ADDRESS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:280
//#NNADTEM	ERASE			# TEMP FOR NOUN ADDRESS TABLE ENTRY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:281
//#NNTYPTEM	ERASE			# TEMP FOR NOUN TYPE TABLE ENTRY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:282
//#IDAD1TEM	ERASE			# TEMP FOR INDIR ADDRESS TABLE ENTRY (MIXNN)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:283
//#					# MUST = IDAD2TEM-1, = IDAD3TEM-2
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:284
//#IDAD2TEM	ERASE			# TEMP FOR INDIR ADDRESS TABLE ENTRY (MIXNN)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:285
//#					# MUST = IDAD1TEM+1, IDAD3TEM-1.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:286
//#IDAD3TEM	ERASE			# TEMP FOR INDIR ADDRESS TABLE ENTRY (MIXNN)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:287
//#					# MUST = IDAD1TEM+2, IDAD2TEM+1.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:288
//#RUTMXTEM	ERASE			# TEMP FOR SF ROUT TABLE ENTRY (MIXNN ONLY)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:289
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:290
//# END OF TEMPORARIES FOR PINBALL EXECUTIVE ACTION.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:291
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:292
//# ADDITIONAL TEMPORARIES FOR PINBALL EXECUTIVE ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:293
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:294
//#	MPAC, THRU MPAC +6
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:295
//#	BUF, +1, +2
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:296
//#	BUF2, +1, +2
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:297
//#	MPTEMP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:298
//#	ADDRWD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:299
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:300
//# END OF ADDITIONAL TEMPS FOR PINBALL EXEC ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:301
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:302
//# RESERVED FOR PINBALL INTERRUPT ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:303
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:304
//#DSPCNT		ERASE			# COUNTER FOR DSPOUT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:305
//#UPLOCK		ERASE			# BIT1 = UPLINK INTERLOCK (ACTIVATED BY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:306
//#					# RECEPTION OF A BAD MESSAGE IN UPLINK)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:307
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:308
//# END OF ERASABLES RESERVED FOR PINBALL INTERRUPT ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:309
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:310
//# TEMPORARIES FOR PINBALL INTERRUPT ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:311
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:312
//#KEYTEMP1	=	WAITEXIT	# TEMP FOR KEYRUPT, UPRUPT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:313
//#DSRUPTEM	=	WAITEXIT	# TEMP FOR DSPOUT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:314
//#KEYTEMP2	=	RUPTAGN		# TEMP FOR KEYRUPT, UPRUPT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:315
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:316
//# END OF TEMPORARIES FOR PINBALL INTERRUPT ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:317
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:318
//# Page 313
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:319
//# THE INPUT CODES ASSUMED FOR THE KEYBOARD ARE,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:320
//#	0		10000
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:321
//#	1		00001
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:322
//#	9		01001
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:323
//#	VERB		10001
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:324
//#	ERROR RES	10010
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:325
//#	KEY RLSE	11001
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:326
//#	+		11010
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:327
//#	-		11011
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:328
//#	ENTER		11100
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:329
//#	CLEAR		11110
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:330
//#	NOUN		11111
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:331
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:332
//# OUTPUT FORMAT FOR DISPLAY PANEL.  SET OUT0 TO AAAABCCCCCDDDDD.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:333
//# A'S 	SELECTS A RELAYWORD.  THIS DETERMINES WHICH PAIR OF CHARACTERS ARE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:334
//#     	ENERGIZED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:335
//# B	FOR SPECIAL RELAYS SUCH AS SIGNS ETC.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:336
//# C'S	5 BIT RELAY CODE FOR LEFT CHAR OF PAIR SELECTED BY RELAYWORD.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:337
//# D'S	5 BIT RELAY CODE FOR RIGHT CHAR OF PAIR SELECTED BY RELAYWORD.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:338
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:339
//# THE PANEL APPEARS AS FOLLOWS,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:340
//#	MD1		MD2 (MAJOR MODE)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:341
//#	VD1		VD2 (VERB)			ND1		ND2 (NOUN)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:342
//#	R1D1		R1D2		R1D3		R1D4		R1D5 (R1)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:343
//#	R2D1		R2D2		R2D3		R2D4		R2D5 (R2)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:344
//#	R3D1		R3D2		R3D3		R3D4		R3D5 (R3)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:345
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:346
//# EACH OF THESE IS GIVEN A DSPCOUNT NUMBER FOR USE WITHIN COMPUTATION ONLY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:347
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:348
//#	MD1	25		R2D1	11		ALL ARE OCTAL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:349
//#	MD2	24		R2D2	10
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:350
//#	VD1	23		R2D3	7
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:351
//#	VD2	22		R2D4	6
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:352
//#	ND1	21		R2D5	5
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:353
//#	ND2	20		R3D1	4
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:354
//#	R1D1	16		R3D2	3
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:355
//#	R1D2	15		R3D3	2
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:356
//#	R1D3	14		R3D4	1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:357
//#	R1D4	13		R3D5	0
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:358
//#	R1D5	12
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:359
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:360
//# THERE IS AN 11-REGISTER TABLE (DSPTAB) FOR THE DISPLAY PANEL.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:361
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:362
//#	DSPTAB		RELAYWD		BIT11		BITS 10-6	BITS 5-1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:363
//#	RELADD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:364
//#	10		1011				MD1 (25)	MD2  (24)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:365
//#	9		1010				VD1 (23)	VD2  (22)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:366
//#	8		1001				ND1 (21)	ND2  (20)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:367
//#	7		1000						R1D1 (16)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:368
//# Page 314
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:369
//#	6		0111		+R1		R1D2 (15)	R1D3 (14)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:370
//#	5		0110		-R1		R1D4 (13)	R1D5 (12)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:371
//#	4		0101		+R2		R2D1 (11)	R2D2 (10)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:372
//#	3		0100		-R2		R2D3 (7)	R2D4 (6)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:373
//#	2		0011				R2D5 (5)	R3D1 (4)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:374
//#	1		0010		+R3		R3D2 (3)	R3D3 (2)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:375
//#	0		0001		-R3		R3D4 (1)	R3D5 (0)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:376
//#			0000	    NO RELAYWORD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:377
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:378
//# THE 5-BIT OUTOUT RELAY CODES ARE:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:379
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:380
//#	BLANK	00000
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:381
//#	0	10101
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:382
//#	1	00011
