                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 6532 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3560
//		TS	DSPLIST
// PORT: Fixed ROM slots 6532.
                if slot <> 6532 or instruction <> 23075 { return choose false if checkOnly else -1. }
                if not extended {
