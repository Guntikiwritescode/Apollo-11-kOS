            } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3559
//		CA	L
// PORT: Fixed ROM slots 6531.
                if slot <> 6531 or instruction <> 12289 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCA(words, 1).
