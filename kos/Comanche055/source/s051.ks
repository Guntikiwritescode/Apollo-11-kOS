        } else {
            if slot <= 4246 {
                if slot <= 4245 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3155
//		TC	ISLIST+0	# ABORT IF DSPLIST NOT= +0
// PORT: Fixed ROM slots 4245.
                    if slot <> 4245 or instruction <> 2208 { return choose false if checkOnly else -1. }
                    if not extended {
