// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:29
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:30
//#	This AGC program shall also be referred to as
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:31
//#			Colossus 2A
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:32
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:33
//# Page 307
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:34
//# PROGRAM NAME -- KEYBOARD AND DISPLAY PROGRAM
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:35
//# MOD NO -- 4		DATE -- 27 APRIL 1967		ASSEMBLY -- PINDISK REV 17
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:36
//# MOD BY -- FILENE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:37
//# LOG SECTION -- PINBALL GAME BUTTONS AND LIGHTS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:38
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:39
//# FUNCTIONAL DESCRIPTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:40
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:41
//# THE KEYBOARD AND DISPLAY SYSTEM PROGRAM OPERATES UNDER EXECUTIVE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:42
//# CONTROL AND PROCESSES INFORMATION EXCHANGED BETWEEN THE AGC AND THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:43
//# COMPUTER OPERATOR.  THE INPUTS TO THE PROGRAM ARE FROM THE KEYBOARD,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:44
//# FROM INTERNAL PROGRAM, AND FROM THE UPLINK.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:45
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:46
//# THE LANGUAGE OF COMMUNICATION WITH THE PROGRAM IS A PAIR OF WORDS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:47
//# KNOWN AS VERB AND NOUN.  EACH OF THESE IS REPRESENTED BY A 2 CHARACTER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:48
//# DECIMAL NUMBER.  THE VERB CODE INDICATES WHAT ACTION IS TO BE TAKEN, THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:49
//# NOUN CODE INDICATES TO WHAT THIS ACTION IS APPLIED.  NOUNS USUALLY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:50
//# REFER TO A GROUP OF ERASABLE REGISTERS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:51
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:52
//# VERBS ARE GROUPED INTO DISPLAYS, LOADS, MONITORS (DISPLAYS THAT ARE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:53
//# UPDATED ONCE PER SECOND), SPECIAL FUNCTIONS, AND EXTENDED VERBS (THESE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:54
//# ARE OUTSIDE OF THE DOMAIN OF PINBALL AND CAN BE FOUND UNDER LOG SECTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:55
//# `EXTENDED VERBS').
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:56
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:57
//# A LIST OF VERBS AND NOUNS IS GIVEN IN LOG SECTION `ASSEMBLY AND
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:58
//# OPERATION INFORMATION'.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:59
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:60
//# CALLING SEQUENCES --
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:61
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:62
//# KEYBOARD:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:63
//# EACH DEPRESSION OF A MAIN (NAVIGATION) KEYBOARD BUTTON ACTIVATES
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:64
//# INTERRUPT KEYRUPT1 (KEYRUPT2) AND PLACES THE 5 BIT KEY CODE INTO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:65
//# CHANNEL 15 (CHANNEL 16).  KEYRUPT1 (KEYRUPT2) PLACES THE KEY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:66
//# CODE INTO MPAC, ENTERS AN EXECUTIVE REQUEST FOR THE KEYBOARD AND DISPLAY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:67
//# PROGRAM (AT `CHARIN'), AND EXECUTES A RESUME.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:68
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:69
//# UPLINK:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:70
//# EACH WORD RECEIVED BY THE UPLINK ACTIVATES INTERRUPT UPRUPT, WHICH
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:71
//# PLACES THE 5 BIT KEY CODE INTO MPAC, ENTERS AN EXECUTIVE REQUEST FOR THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:72
//# KEYBOARD AND DISPLAY PROGRAM (AT `CHARIN') AND EXECUTES A RESUME.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:73
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:74
//# INTERNAL PROGRAMS:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:75
//# INTERNAL PROGRAMS CALL PINBALL AT `NVSUB' WITH THE DESIRED VERB/NOUN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:76
//# CODE IN A (LOW 7 BITS FOR NOUN, NEXT 7 BITS FOR VERB).  DETAILS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:77
//# DESCRIBED ON REMARKS CARDS JUST BEFORE `NVSUB' AND `NVSBWAIT' (SEE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:78
//# SYMBOL TABLE FOR PAGE NUMBERS).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:79
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:80
//# NORMAL EXIT MODES --
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:81
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:82
//#	IF PINBALL WAS CALLED BY EXTERNAL ACTION, THERE ARE FOUR EXITS:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:83
//#		1)	ALL BUT (2), (3), AND (4) EXIT DIRECTLY TO ENDOFJOB.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:84
//# Page 308
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:85
//#		2)	EXTENDED VERBS TO TO THE EXTENDED VERB FAN AS PART OF THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:86
//#			PINBALL EXECUTIVE JOB WITH PRIORITY 30000.  IT IS THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:87
//#			RESPONSIBILITY OF THE EXTENDED VERB CALLED TO EVENTUALLY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:88
//#			CHANGE PRIORITY (IF NECESSARY) AD DO AN ENDOFJOB.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:89
//#			ALSO PINBALL IS A NOVAC JOB.  EBANK SET FOR COMMON.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:90
//#		3)	VERB 37.  CHANGE OF PROGRAM (MAJOR MODE) CALLS `V37' IN THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:91
//#			SERVICE ROUTINES AS PART OF THE PINBALL EXEC JOB WITH PRIO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:92
//#			30000.  THE NEW PROGRAM CODE (MAJOR MODE) IS LEFT IN A.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:93
//#		4)	KEY RELEASE BUTTON CALLS `PINBRNCH' IN THE DISPLAY INTERFACE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:94
//#			ROUTINES AS PART OF THE PINBALL EXEC JOB WITH PRIO 30000 IF
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:95
//#			THE KEY RELEASE LIGHT IS OFF AND `CADRSTOR' IS NOT 40.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:96
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:97
//# IF PINBALL WAS CALLED BY INTERNAL PROGRAMS, EXIT FROM PINBALL IS BACK
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:98
//# TO CALLING ROUTINE.  DETAILS DESCRIBED IN REMARKS CARDS JUST BEFORE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:99
//# `NVSUB' AND `NVSBWAIT' (SEE SYMBOL TABLE FOR PAGE NUMBERS).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:100
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:101
//# ALARM OR ABORT EXIT MODES --
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:102
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:103
//# 	EXTERNAL INITIATION:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:104
//#		IF SOME IMPROPER SEQUENCE OF KEY CODES IS DETECTED, THE OPERATOR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:105
//#		ERROR LIGHT IS TURNED ON AND EXIT IS TO `ENDOFJOB'.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:106
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:107
//#	INTERNAL PROGRAM INITIATION:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:108
//#		IF AN ILLEGAL V/N COMBINATION IS ATTEMPTED, AN ABORT IS CAUSED
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:109
//#		(WITH OCTAL 01501).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:110
//#		IF A SECOND ATTEMPT IS MADE TO GO TO SLEEP IN PINBALL, AN ABORT IS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:111
//#		CAUSED (WITH OCTAL 01206).  THERE ARE TWO WAYS TO GO TO SLEEP IN PINBALL:
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:112
//#		1)	ENDIDLE OR DATAWAIT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:113
//#		2)	NVSBWAIT, PRENVBSY, OR NVSUBUSY.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:114
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:115
//# CONDITIONS LEADING TO THE ABOVE ARE DESCRIBED IN FORTHCOMING MIT/IL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:116
//# E-REPORT DESCRIBING KEYBOARD AND DISPLAY OPERATION FOR 278.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:117
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:118
//# OUTPUT --
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:119
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:120
//# INFORMATION TO BE SENT TO THE DISPLAY PANEL IS LEFT IN THE `DSPTAB'
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:121
//# BUFFERS REGISTERS (UNDER EXEC CONTROL).  `DSPOUT' (A PART OF T4RUPT)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:122
//# HANDLES THE PLACING OF THE `DSPTAB' INFORMATION INTO OUTPUT CHANNEL 10
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:123
//# IN INTERRUPT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:124
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:125
//# ERASABLE INITIALIZATION --
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:126
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:127
//# FRESH START AND RESTART INITIALIZE THE NECESSARY E REGISTERS FOR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:128
//# PINBALL IN `STARTSUB'.  REGISTERS ARE:  DSPTAB BUFFER, CADRSTOR,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:129
//# REQRET, CLPASS, DSPLOCK, MONSAVE, MONSAVE1, VERBREG, NOUNREG, DSPLIST,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:130
//# DSPCOUNT, NOUT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:131
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:132
//# Page 309
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:133
//# A COMPLETE LIST OF ALL THE ERASABLES (BOTH RESERVED AND TEMPORARIES) FOR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:134
//# PINBALL IS GIVEN BELOW.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:135
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:136
//# THE FOLLOWING ARE OF GENERAL INTEREST --
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:137
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:138
//# REMARKS CARDS PRECEDE THE REFERENCED SYMBOL DEFINITION.  SEE SYMBOL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:139
//# TABLE TO FIND APPROPRIATE PAGE NUMBERS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:140
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:141
//#	NVSUB		CALLING POINT FOR INTERNAL USE OF PINBALL.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:142
//#			OF RELATED INTEREST	NVSBWAIT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:143
//#						NVSUBUSY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:144
//#						PRENVBSY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:145
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:146
//#	ENDIDLE		ROUTINE FOR INTERNAL PROGRAMS WISHING TO TO SLEEP WHILE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:147
//#			AWAITING OPERATOR'S RESPONSE.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:148
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:149
//#	DSPMM		ROUTINE BY WHICH AN INTERNAL PROGRAM MAY DISPLAY A DECIMAL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:150
//#			PROGRAM CODE (MAJOR MODE) IN THE PROGRAM (MAJOR MODE) LIGHT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:151
//#			(DSPMM DOES NOT DISPLAY DIRECTLY BUT ENTERS EXEC REQUEST
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:152
//#			FOR DSPMMJB WITH PRIO 30000 AND RETURNS TO CALLER.)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:153
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:154
//#	BLANKSUB	ROUTINE BY WHICH AN INTERNAL PROGRAM MAY BLANK ANY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:155
//#			COMBINATION OF THE DISPLAY REGISTERS R1, R2, R3.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:156
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:157
//#	JAMTERM		ROUTINE BY WHICH AN INTERNAL PROGRAM MAY PERFORM THE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:158
//#	JAMPROC		TERMINATE (V 34) OR PROCEED (V33) FUNCTION.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:159
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:160
//#	MONITOR		VERBS FOR PERIODIC (1 PER SEC) DISPLAY.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:161
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:162
//#	PLEASE PERFORM, PLEASE MARK SITUATIONS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:163
//#		REMARKS DESCRIBING HOW AN INTERNAL ROUTINE SHOULD HANDLE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:164
//#		THESE SITUATIONS CAN BE FOUND JUST BEFORE `NVSUB' (SEE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:165
//#		SYMBOL TABLE FOR PAGE NUMBER).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:166
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:167
//#	THE NOUN TABLE FORMAT IS DESCRIBED ON A PAGE OF REMARKS CARDS JUST
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:168
//#	BEFORE `DSPABC' (SEE SYMBOL TABLE FOR PAGE NUMBER).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:169
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:170
//#	THE NOUN TABLES THEMSELVES ARE FOUND IN LOG SECTION `PINBALL NOUN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:171
//#	TABLES'.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:172
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:173
//# FOR FURTHER DETAILS ABOUT OPERATION OF THE KEYBOARD AND DISPLAY SYSTEM
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:174
//# PROGRAM, SEE THE MISSION PLAN AND/OR MIT/IL E-2129
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:175
//# DESCRIBING KEYBOARD AND DISPLAY OPERATION FOR 278.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:176
//# (Note that this doc by Green and Filene is/was available online at
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:177
//# http://hrst.mit.edu/hrs/apollo/public/archive/1706.pdf --- RSB 6/2004.)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:178
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:179
//# THE FOLLOWING QUOTATION IS PROVIDED THROUGH THE COURTESY OF THE AUTHORS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:180
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:181
//#	"IT WILL BE PROVED TO THY FACE THAT THOU HAST MEN ABOUT THEE THAT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:182
//# Page 310
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:183
//#	USUALLY TALK OF A NOUN AND A VERB, AND SUCH ABOMINABLE WORDS AS NO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:184
//#	CHRISTIAN EAR CAN ENDURE TO HEAR."
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:185
//#					HENRY 6, ACT 2, SCENE 4
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:186
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:187
//# THE FOLLOWING ASSIGNMENTS FOR PINBALL ARE MADE ELSEWHERE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:188
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:189
//# RESERVED FOR PINBALL EXECUTIVE ACTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:190
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:191
//#DSPCOUNT	ERASE			# DISPLAY POSITION INDICATOR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:192
//#DECBRNCH	ERASE			# +DEC, -DEC, OCT INDICATOR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:193
//#VERBREG	ERASE			# VERB CODE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:194
//#NOUNREG	ERASE			# NOUN CODE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:195
//#XREG		ERASE			# R1 INPUT BUFFER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:196
//#YREG		ERASE			# R2 INPUT BUFFER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:197
//#ZREG		ERASE			# R3 INPUT BUFFER
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:198
//#XREGLP		ERASE			# LO PART OF XREG (FOR DEC CONV ONLY)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:199
//#YREGLP		ERASE			# LO PART OF YREG (FOR DEC CONV ONLY)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:200
//#HITEMOUT	=	YREGLP		# TEMP FOR DISPLAY OF HRS,MIN,SEC
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:201
//#					# MUST = LOTEMOUT-1.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:202
//#ZREGLP		ERASE			# LO PART OF ZREG (FOR DEC CONV ONLY)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:203
//#LOTEMOUT	=	ZREGLP		# TEMP FOR DISPLAY OF HRS,MIN,SEC
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:204
//#					# MUST = HITEMOUT+1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:205
//#MODREG		ERASE			# MODE CODE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:206
//#DSPLOCK	ERASE			# KEYBOARD/SUBROUTINE CALL INTERLOCK
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:207
//#REQRET		ERASE			# RETURN REGISTER FOR LOAD
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:208
//#LOADSTAT	ERASE			# STATUS INDICATOR FOR LOADTST
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:209
//#CLPASS		ERASE			# PASS INDICATOR FOR CLEAR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:210
//#NOUT		ERASE			# ACTIVITY COUNTER FOR DSPTAB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:211
//#NOUNCADR	ERASE			# MACHINE CADR FOR NOUN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:212
//#MONSAVE	ERASE			# N/V CODE FOR MONITOR. (= MONSAVE1-1)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:213
//#MONSAVE1	ERASE			# NOUNCADR FOR MONITOR (MATBS1) = MONSAVE+1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:214
//#MONSAVE2	ERASE			# NVMONOPT OPTIONS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:215
//#DSPTAB		ERASE	+13D		# 0-10, DISPLAY PANEL BUFFER 11-13, C RELAYS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:216
//#CADRSTOR	ERASE			# ENDIDLE STORAGE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:217
//#NVQTEM		ERASE			# NVSUB STORAGE FOR CALLING ADDRESS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:218
//#					# MUST = NVBNKTEM-1.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:219
//#NVBNKTEM	ERASE			# NVSUB STORAGE FOR CALLING BANK
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:220
//#					# MUST = NVQTEM+1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:221
//#VERBSAVE	ERASE			# NEEDED FOR RECYCLE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:222
//#DSPLIST	ERASE			# WAITING REG FOR DSP SYST INTERNAL USE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:223
//#EXTVBACT	ERASE			# EXTENDED VERB ACTIVITY INTERLOCK
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:224
//#DSPTEM1	ERASE	+2		# BUFFER STORAGE AREA 1 (MOSTLY FOR TIME)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:225
//#DSPTEM2	ERASE	+2		# BUFFER STORAGE AREA 2 (MOSTLY FOR DEG)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:226
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:227
//# END OF ERASABLES RESERVED FOR PINBALL EXECUTIVE ACTION.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:228
//#
