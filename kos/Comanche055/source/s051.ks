//ENDPINBF	EQUALS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3621
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3622
//# Page 384
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3623
//# PINTEST IS NEEDED FOR AUTO CHECK OF PINBALL.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3624
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3625
//PINTEST		EQUALS	LST2FAN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3626
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3627
//# Page 385
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3628
//# VBTSTLTS TURNS ON ALL DISPLAY PANEL LIGHTS.  AFTER 5 SEC, IT TURNS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3629
//# OFF THE CAUTION AND STATUS LIGHTS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3630
