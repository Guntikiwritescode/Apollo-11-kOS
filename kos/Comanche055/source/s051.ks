// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3631
//		SETLOC	ENDNVSB1 +1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3632
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3633
//		COUNT	41/PIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3634
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3635
//VBTSTLTS	TC	BANKCALL
// slot 36747
    if slot <> 36747 or instruction <> 2482 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2482, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
