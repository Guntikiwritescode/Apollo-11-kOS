            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 23051, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2764
//		TC	BANKCALL	# PUTS ORIGINAL VERB INTO VERBREG AND
// PORT: Fixed ROM slots 4212.
