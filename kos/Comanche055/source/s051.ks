                    }
                    return choose false if checkOnly else -1.
                } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3156
//		CA	L		# DON'T SET DSPLOC TO 1 SO CAN USE
// PORT: Fixed ROM slots 4246.
                    if slot <> 4246 or instruction <> 12289 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCA(words, 1).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4247 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3157
//		MASK	LOW10		# ENDIDLE WITH NVSUB INITIATE MONITOR.
// PORT: Fixed ROM slots 4247.
                    if slot <> 4247 or instruction <> 31276 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        set words[0] to agcOverflowCorrected(words[0]).
                        local fixedOperand is mod(readEffective:call(words, 2604), 32768).
                        if fixedOperand = 1023 {
                            set words[0] to agcSignExtend(mod(floor(words[0] / 1), 1024) * 1).
                        } else {
                            set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                        }
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4248 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3158
//		AD	FBANK		# SAME STRATEGY FOR CADR AS MAKECADR.
// PORT: Fixed ROM slots 4248.
                        if slot <> 4248 or instruction <> 24580 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                            agcCoreAD(words, 4).
                            return list(false, false, inheritedTransient, false, false).
                        }
                        return choose false if checkOnly else -1.
                    } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3159
//		TS	CADRSTOR
// PORT: Fixed ROM slots 4249.
                        if slot <> 4249 or instruction <> 23074 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            return agcCoreControlExecute(words, 23074, words[0], readEffective).
                        }
                        return choose false if checkOnly else -1.
                    }
                }
            }
        }
    } else {
        if slot <= 4254 {
            if slot <= 4251 {
                if slot <= 4250 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3160
//		TC	JOBSLEEP
// PORT: Fixed ROM slots 4250.
                    if slot <> 4250 or instruction <> 2685 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2685, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3161
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3162
//ENDINST		TC	ENDOFJOB
// PORT: Fixed ROM slots 4251.
                    if slot <> 4251 or instruction <> 2703 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2703, words[0], readEffective).
