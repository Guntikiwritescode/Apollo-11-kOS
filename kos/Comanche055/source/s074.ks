//# Notations on the hardcopy document read, in part:
// PORT: SOURCE TIME_OF_FREE_FALL.agc:24
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:25
//#    Assemble revision 055 of AGC program Comanche by NASA
// PORT: SOURCE TIME_OF_FREE_FALL.agc:26
//#    2021113-051.  10:28 APR. 1, 1969
// PORT: SOURCE TIME_OF_FREE_FALL.agc:27
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:28
//#    This AGC program shall also be referred to as
// PORT: SOURCE TIME_OF_FREE_FALL.agc:29
//#            Colossus 2A
// PORT: SOURCE TIME_OF_FREE_FALL.agc:30
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:31
//# Page 1373
// PORT: SOURCE TIME_OF_FREE_FALL.agc:32
//# 	THE TFF SUBROUTINES MAY BE USED IN EITHER EARTH OR MOON CENTERED COORDINATES.  THE TFF ROUTINES NEVER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:33
//# KNOW WHICH ORIGIN APPLIES.  IT IS THE USER WHO KNOWS, AND WHO SUPPLIES RONE, VONE AND 1/SQRT(MU) AT THE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:34
//# APPROPRIATE SCALE LEVEL FOR THE PROPER PRIMARY BODY.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:35
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:36
//#	EARTH ORIGIN	POSITION	-29	METERS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:37
//#			VELOCITY	-7	METERS/CENTISECOND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:38
//#			1/SQRT(MU)	+17	SQRT(CS SQ/METERS CUBED)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:39
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:40
//#	MOON ORIGIN	POSITION	-27	METERS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:41
//#			VELOCITY	-5	METERS/CENTISECONDS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:42
//#			1/SQRT(MU)	+14	SQRT(CS SQ/METERS CUBED)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:43
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:44
//# ALL DATA PROVIDED TO AND RECEIVED FROM ANY TFF SUBROUTINE WILL BE AT ONE OF THE LEVELS ABOVE.  IN ALL CASES,
// PORT: SOURCE TIME_OF_FREE_FALL.agc:45
//# THE FREE FALL TIME IS RETURNED IN CENTISECONDS AT (-28).  PROGRAM TFF/CONIC WILL GENERATE VONE/RTMU AND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:46
//# LEAVE IT IN VONE' AT (+10) IF EARTH ORIGIN AND (+9) IF MOON ORIGIN.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:47
//# 	THE USER MUST STORE THE STATE VECTOR IN RONE, VONE AND MU IN THE FORM 1/SQRT(MU) IN TFF/RTMU
// PORT: SOURCE TIME_OF_FREE_FALL.agc:48
//# AT THE PROPER SCALE BEFORE CALLING TFF/CONIC.  SINCE RONE, VONE ARE IN THE EXTENDED VERB STORAGE AREA,
// PORT: SOURCE TIME_OF_FREE_FALL.agc:49
//# THE USER MUST ALSO LOCK OUT THE EXTENDED VERBS, AND RELEASE THEM WHEN FINISHED.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:50
//# 	PROGRAMS CALC/TFF AND CALC/TPER ASSUME THAT THE TERMINAL RADIUS IS LESS THAN THE PRESENT
// PORT: SOURCE TIME_OF_FREE_FALL.agc:51
//# RADIUS.  THIS RESTRICTION CAN BE REMOVED BY A 15 W CODING CHANGE, BUT AT PRESENT IT IS NOT DEEMED NECESSARY.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:52
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:53
//# 	THE FOLLOWING ERASABLE QUANTITIES ARE USED BY THE TFF ROUTINES, AND ARE LOCATED IN THE PUSH LIST.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:54
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:55
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:56
//#				BELOW	E:  IS USED FOR EARTH ORIGIN SCALE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:57
//#					M:  IS USED FOR MOON  ORIGIN SCALE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:58
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:59
//#TFFSW		=	119D	# BIT1	0 = CALCTFF		1 = CALCTPER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:60
//TFFDELQ		=	10D	#	Q2-Q1			E: (-16)  M: (-15)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:61
//RMAG1		=	12D	#	ABVAL(RN) M		E: (-29)  M: (-27)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:62
//#RPER		=	14D	#	PERIGEE RADIUS M	E: (-29)  M: (-27)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:63
//TFFQ1		=	14D	#	R.V / SQRT(MUE)		E: (-16)  M: (-15)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:64
//#SDELF/2			#	SIN(THETA) /2
// PORT: SOURCE TIME_OF_FREE_FALL.agc:65
//CDELF/2		=	14D	#	COS(THETA) /2
// PORT: SOURCE TIME_OF_FREE_FALL.agc:66
//#RAPO		=	16D	#	APOGEE RADIUS M		E: (-29)  M: (-27)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:67
//NRTERM		=	16D	#	TERMINAL RADIUS M	E: (-29+NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:68
//				#				M: (-27+NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:69
//RTERM		=	18D	#	TERMINAL RADIUS M	E: (-29)  M: (-27)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:70
//TFFVSQ		=	20D	#	-(V SQUARED/MU)       1/M  E: (20)   M: (18)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:71
//TFF1/ALF	=	22D	#	SEMI MAJ AXIS  M	E: (-22-2 NA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:72
//				#				M: (-20-2 NA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:73
//TFFRTALF	=	24D	#	SQRT(ALFA)	E:(10+NA) M: (9+NA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:74
//TFFALFA		=	26D	#	ALFA  1/M	E:(26-NR) M: (24-NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:75
//TFFNP		=	28D	#	SEMI LATUS RECTUM	M  E: (-38+2 NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:76
//				#				   M: (-36+2 NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:77
//TFF/RTMU	=	30D	#	1/SQRT(MU)		E: (17)   M: (14)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:78
//NRMAG		=	32D	#	PRESENT RADIUS  M	E: (-29+NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:79
//				#				M: (-27+NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:80
//TFFX		=	34D     #
// PORT: SOURCE TIME_OF_FREE_FALL.agc:81
//TFFTEM		=	36D	#	TEMPORARY
// PORT: SOURCE TIME_OF_FREE_FALL.agc:82
//# Page 1374
// PORT: SOURCE TIME_OF_FREE_FALL.agc:83
//#		REGISTERS S1, S2 ARE UNTOUCHED BY ANY TFF SUBROUTINE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:84
//#		INDEX REGISTERS X1, X2 ARE USED BY ALL TFF SUBROUTINES.  THEY ARE ESTAB-
// PORT: SOURCE TIME_OF_FREE_FALL.agc:85
//#		LISHED IN TFF/CONIC AND MUST BE PRESERVED BETWEEN CALLS TO SUBSEQUENT
// PORT: SOURCE TIME_OF_FREE_FALL.agc:86
//#		SUBROUTINES.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:87
//#		-NR				C(X1) = NORM COUNT OF RMAG
// PORT: SOURCE TIME_OF_FREE_FALL.agc:88
//#		-NA				C(X2)= NORM COUNT OF SQRT(ABS(ALFA))
// PORT: SOURCE TIME_OF_FREE_FALL.agc:89
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:90
//# Page 1375
// PORT: SOURCE TIME_OF_FREE_FALL.agc:91
//# SUBROUTINE NAME:	TFFCONIC						DATE: 01.29.67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:92
//# MOD NO: 0									LOG SECTION: TIME OF FREE FALL
// PORT: SOURCE TIME_OF_FREE_FALL.agc:93
//# MOD BY: RR BAIRNSFATHER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:94
//# MOD NO: 1		MOD BY: RR BAIRNSFATHER		DATE: 11 APR 67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:95
//# MOD NO: 2		MOD BY: RR BAIRNSFATHER		DATE: 21 NOV 67		ADD MOON MU.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:96
//# MOD NO: 3		MOD BY: RR BAIRNSFATHER		DATE: 21 MAR 68		ACCEPT DIFFERENT EARTH/MOON SCALES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:97
//# FUNCTIONAL DESCRIPTION:	THIS SUBROUTINE IS CALLED TO COMPUTE THOSE CONIC PARAMETERS REQUIRED BY THE TFF
// PORT: SOURCE TIME_OF_FREE_FALL.agc:98
//#	SUBROUTINES AND TO ESTABLISH THEM IN THE PUSH LIST AREA.  THE PARAMETERS ARE LISTED UNDER OUTPUT.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:99
//#	THE EQUATIONS ARE:
// PORT: SOURCE TIME_OF_FREE_FALL.agc:100
//#		-   -  -
// PORT: SOURCE TIME_OF_FREE_FALL.agc:101
//#		H = RN*VN			ANGULAR MOMENTUM
// PORT: SOURCE TIME_OF_FREE_FALL.agc:102
//#		      - -
// PORT: SOURCE TIME_OF_FREE_FALL.agc:103
//#		LCP = H.H / MU			SEMI LATUS RECTUM
// PORT: SOURCE TIME_OF_FREE_FALL.agc:104
//#		              -  -
// PORT: SOURCE TIME_OF_FREE_FALL.agc:105
//#		ALFA = 2/RN - VN.VN / MU	RECIPROCAL SEMI MAJ AXIS, SIGNED
// PORT: SOURCE TIME_OF_FREE_FALL.agc:106
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:107
//# 	AND ALFA IS POS FOR ELLIPTIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:108
//#	              0 FOR PARABOLIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:109
//#	            NEG FOR HYPERBOLIC ORBITS.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:110
//#	SUBROUTINE ALSO COMPUTES AND SAVES RMAG.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:111
//# CALLING SEQUENCE:
// PORT: SOURCE TIME_OF_FREE_FALL.agc:112
//#	TFFCONIC EXPECTS CALLER TO ENTER WITH CORRECT GRAVITATIONAL CONSTANT IN MPAC, IN THE FORM
// PORT: SOURCE TIME_OF_FREE_FALL.agc:113
//#	1/SQRT(MU).  THE PROGRAM WILL SAVE IN TFF/RTMU .  THE SCALE IS DETERMINED BY WHETHER EARTH OR MOON
// PORT: SOURCE TIME_OF_FREE_FALL.agc:114
//#	ORIGIN IS USED.  THE CALLER MUST LOCK OUT THE EXTENDED VERBS BEFORE PROVIDING STATE VECTOR IN RONE,
// PORT: SOURCE TIME_OF_FREE_FALL.agc:115
//#	VONE AT PROPER SCALE.  THE EXTENDED VERBS MUST BE RESTORED WHEN THE CALLER IS FINISHED USING THE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:116
//#	TFF ROUTINES.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:117
//#	ENTRY POINT TFFCONMU EXPECTS THAT TFF/RTMU IS ALREADY LOADED.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:118
//#	TO SPECIFY MU:	DLOAD	CALL		# IF MU ALREADY STORED:		CALL
// PORT: SOURCE TIME_OF_FREE_FALL.agc:119
//#				YOURMU	# 1/RTMU	E:(17) M:(14)			TFFCONMU
// PORT: SOURCE TIME_OF_FREE_FALL.agc:120
//#				TFFCONIC
// PORT: SOURCE TIME_OF_FREE_FALL.agc:121
//#	PUSHLOC = PDL+0, ARBITRARY IF LEQ 18D
// PORT: SOURCE TIME_OF_FREE_FALL.agc:122
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:123
//# SUBROUTINES CALLED:	NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:124
//# NORMAL EXIT MODES:	RVQ
// PORT: SOURCE TIME_OF_FREE_FALL.agc:125
//# ALARMS:	NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:126
//# OUTPUT:	THE FOLLOWING ARE STORED IN THE PUSH LIST AREA.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:127
//#		RMAG1	E:(-29) M:(-27)	M  RN, PRESENT RADIUS LENGTH.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:128
//#		NRMAG	E:(-29+NR)	M  RMAG, NORMALIZED
// PORT: SOURCE TIME_OF_FREE_FALL.agc:129
//#			M:(-27+NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:130
//#		X1			-NR, NORM COUNT
// PORT: SOURCE TIME_OF_FREE_FALL.agc:131
//#		TFFNP	E:(-38+2NR)	M  LCP, SEMI LATUS RECTUM, WEIGHTED BY NR.	FOR VGAMCALC
// PORT: SOURCE TIME_OF_FREE_FALL.agc:132
//#			M:(-36+2NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:133
//#		TFF/RTMU E:(17) M:(14)		1/SQRT(MU)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:134
//#		TFFVSQ E:(20) M:(18)	1/M  -(V SQ/MU): PRESENT VELOCITY,NORMLIZED.	FOR VGAMCALC
// PORT: SOURCE TIME_OF_FREE_FALL.agc:135
//#		TFFALFA	E:(26-NR)	1/M  ALFA, WEIGHTED BY NR
// PORT: SOURCE TIME_OF_FREE_FALL.agc:136
//#			M:(24-NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:137
//#		TFFRTALF E:(10+NA)	SQRT(ALFA), NORMALIZED
// PORT: SOURCE TIME_OF_FREE_FALL.agc:138
//#			 M:(9+NA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:139
//# Page 1376
// PORT: SOURCE TIME_OF_FREE_FALL.agc:140
//#		X2			-NA, NORM COUNT
// PORT: SOURCE TIME_OF_FREE_FALL.agc:141
//#		TFF1/ALF E: (-22-2NA)	SIGNED SEMI MAJ AXIS, WEIGHTED BY NA
// PORT: SOURCE TIME_OF_FREE_FALL.agc:142
//#			 M: (-20-2NA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:143
//#		PUSHLOC AT PDL+0
// PORT: SOURCE TIME_OF_FREE_FALL.agc:144
//#		THE FOLLOWING IS STORED IN GENERAL ERASABLE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:145
//#		VONE'	E:(10) M:(9)	V/RT(MU), NORMALIZED VELOCITY
// PORT: SOURCE TIME_OF_FREE_FALL.agc:146
//# ERASABLE INITIALIZATION REQUIRED:
// PORT: SOURCE TIME_OF_FREE_FALL.agc:147
//#		RONE	E:(-29) M:(-27)	M	STATE VECTOR		LEFT BY CALLER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:148
//#		VONE	E:(-7) M:(-5)	M/CS	STATE VECTOR		LEFT BY CALLER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:149
//#		TFF/RTMU E:(17) M:(14)	1/RT(CS SQ/M CUBE)		IF ENTER VIA TFFCONMU.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:150
//# DEBRIS:	QPRET.		PDL+0 ... PDL+3
// PORT: SOURCE TIME_OF_FREE_FALL.agc:151
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:152
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:153
//		BANK	33
// PORT: SOURCE TIME_OF_FREE_FALL.agc:154
//		SETLOC	TOF-FF
// PORT: SOURCE TIME_OF_FREE_FALL.agc:155
//		BANK
// PORT: SOURCE TIME_OF_FREE_FALL.agc:156
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:157
//		COUNT*	$$/TFF
// PORT: SOURCE TIME_OF_FREE_FALL.agc:158
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:159
//TFFCONIC	STORE	TFF/RTMU	# 1/SQRT(MU)		E: (17)  M: (14)
// PORT: Fixed ROM slots 26095.
    26095, 62
)).

agcAotInstallSourceRope(list(
