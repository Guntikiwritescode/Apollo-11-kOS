// PORT: Physical bank 27. Shared continuation entries, slots 26332–26332.
function agcAotUnit1516 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:609
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:610
//# Page 1387
// PORT: SOURCE TIME_OF_FREE_FALL.agc:611
//# PROGRAM NAME:		T(X)				DATE:	01.17.67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:612
//# MOD NO:	0					LOG SECTION:	TIME OF FREE FALL
// PORT: SOURCE TIME_OF_FREE_FALL.agc:613
//# MOD BY:  	RR BAIRNSFATHER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:614
//# FUNCTIONAL DESCRIPTION:	THE POLYNOMIAL T(X) IS USED BY TIME OF FLIGHT SUBROUTINES CALCTFF AND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:615
//#	CALCTPER TO APPROXIMATE THE SERIES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:616
//#			  2	3
// PORT: SOURCE TIME_OF_FREE_FALL.agc:617
//#		1/3 -X/5 +X /7 -X /9 ...
// PORT: SOURCE TIME_OF_FREE_FALL.agc:618
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:619
//#	WHERE	X = ALFA Z Z		IF ALFA Z Z LEQ	1
// PORT: SOURCE TIME_OF_FREE_FALL.agc:620
//#		X = 1/(ALFA Z Z )	IF ALFA Z Z  G	1
// PORT: SOURCE TIME_OF_FREE_FALL.agc:621
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:622
//#	ALSO	X IS NEG FOR HYPERBOLIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:623
//#		X = 0 FOR PARABOLIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:624
//#		X IS POSITIVE FOR ELLIPTIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:625
//#	FOR FLIGHT 278, THE POLYNOMIAL T(X) IS FITTED OVER THE RANGE (0,+1) AND HAS A MAXIMUM
// PORT: SOURCE TIME_OF_FREE_FALL.agc:626
//#	DEVIATION FROM THE SERIES OF 2 E-5	(T(X) IS A CHEBYCHEV TYPE FIT AND WAS OBTAINED USING
// PORT: SOURCE TIME_OF_FREE_FALL.agc:627
//#	MAC PROGRAM AUTCURFIT294RRB AND IS VALID TO THE SAME TOLERANCE OVER THE RANGE (-.08,+1). )
// PORT: SOURCE TIME_OF_FREE_FALL.agc:628
//# CALLING SEQUENCE:	RTB
// PORT: SOURCE TIME_OF_FREE_FALL.agc:629
//#				T(X)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:630
//#		C(MPAC) = X
// PORT: SOURCE TIME_OF_FREE_FALL.agc:631
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:632
//# SUBROUTINE CALLED:	NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:633
//# NORMAL EXIT MODE:	TC DANZIG
// PORT: SOURCE TIME_OF_FREE_FALL.agc:634
//# ALARMS:	NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:635
//# OUTPUT:	C(MPAC) = T(X)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:636
//# ERASABLE INITIALIZATION REQUIRED:
// PORT: SOURCE TIME_OF_FREE_FALL.agc:637
//#		C(MPAC) = X
// PORT: SOURCE TIME_OF_FREE_FALL.agc:638
//# DEBRIS:	NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:639
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:640
//T(X)		TC	POLY
// PORT: Fixed ROM slots 26332.
    if slot <> 26332 or instruction <> 3705 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3705, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[1516] to agcAotUnit1516@.

