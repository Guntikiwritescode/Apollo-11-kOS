//# SUBROUTINE NAME:	CALCTPER / CALCTFF					DATE:	01.29.67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:288
//# MOD NO: 0									LOG SECTION:	TIME OF FREE FALL
// PORT: SOURCE TIME_OF_FREE_FALL.agc:289
//# MOD BY: RR BAIRNSFATHER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:290
//# MOD NO: 1		MOD BY: RR BAIRNSFATHER		DATE: 21 MAR 67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:291
//# MOD NO: 2		MOD BY: RR BAIRNSFATHER		DATE: 14 APR 67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:292
//# MOD BY: 3		MOD BY: RR BAIRNSFATHER		DATE: 8 JUL 67		NEAR EARTH MUE AND NEG TFF (GONEPAST)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:293
//# MOD BY: 4		MOD BY: RR BAIRNSFATHER		DATE: 21 NOV 67		ADD VARIABLE MU.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:294
//# MOD BY: 5		MOD BY: RR BAIRNSFATHER		DATE: 21 MAR 68		ACCEPT DIFFERENT EARTH/MOON SCALES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:295
//# FUNCTIONAL DESCRIPTION:	PROGRAM CALCULATES THE FREE-FALL TIME OF FLIGHT FROM PRESENT POSITION RN AND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:296
//#	VELOCITY VN TO A RADIUS LENGTH SPECIFIED BY RTERM , SUPPLIED BY THE USER.  THE POSITION VECTOR
// PORT: SOURCE TIME_OF_FREE_FALL.agc:297
//#	RN MAY BE ON EITHER SIDE OF THE CONIC, BUT RTERM IS CONSIDERED ON THE INBOUND SIDE.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:298
//#	THE EQUATIONS ARE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:299
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:300
//#		Q2 = -SQRT(RTERM (2-RTERM ALFA) - LCP)	(INBOUND SIDE))	LEQ +- LCE/SQRT(ALFA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:301
//#		     -	-
// PORT: SOURCE TIME_OF_FREE_FALL.agc:302
//#		Q1 = RN.VN / SQRT(MU)					LEQ +- LCE/SQRT(ALFA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:303
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:304
//# 		Z = NUM / DEN						LEQ +- 1/SQRT(ALFA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:305
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:306
//#	WHERE, IF INBOUND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:307
//#		NUM = RTERM -RN						LEQ +- 2 LCE/ALFA
// PORT: SOURCE TIME_OF_FREE_FALL.agc:308
//#		DEN = Q2+Q1						LEQ +- 2 LCE/SQRT(ALFA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:309
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:310
//# 	AND, IF OUTBOUND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:311
//#		NUM = Q2-Q1						LEQ +- 2 LCE/SQRT(ALFA)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:312
//#		DEN = 2 - ALFA (RTERM + RN) .				LEQ +- 2 LCE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:313
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:314
//#	IF 	ALFA ZZ < 1.0		(FOR ALL CONICS EXCEPT ELLIPSES HAVING ABS(DEL ECC ANOM) G 90 DEG)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:315
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:316
//#	THEN	X = ALFA Z Z
// PORT: SOURCE TIME_OF_FREE_FALL.agc:317
//#	AND	TFF = (RTERM +RN -2 ZZ T(X) ) Z/SQRT(MU)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:318
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:319
//#		EXCEPT 	IF ALFA PNZ, AND IF TFF NEG,
// PORT: SOURCE TIME_OF_FREE_FALL.agc:320
//#		THEN	TFF = 2 PI /(ALFA SQRT(ALFA)) + TFF
// PORT: SOURCE TIME_OF_FREE_FALL.agc:321
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:322
//#	OR IF	ALFA ZZ GEQ 1.0		(FOR ELLIPSES HAVING ABS(DEL ECC ANOM) GEQ 90 DEG)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:323
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:324
//#	THEN	X = 1/ALFA Z Z
// PORT: SOURCE TIME_OF_FREE_FALL.agc:325
//#	AND	TFF = (PI/SQRT(ALFA) -Q2 +Q1 +2(X T(X) -1) /ALFA Z) /ALFA SQRT(MU)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:326
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:327
//#	WHERE	T(X) IS A POLYNOMIAL APPROXIMATION TO THE SERIES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:328
//#			   2	 3			  2
// PORT: SOURCE TIME_OF_FREE_FALL.agc:329
//#		1/3 -X/5 +X /7 -X /9...			(X < 1.0)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:330
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:331
//# CALLING SEQUENCE:	TIME TO RTERM			TIME TO PERIGEE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:332
//#			CALL				CALL
// PORT: SOURCE TIME_OF_FREE_FALL.agc:333
//#				CALCTFF				CALCTPER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:334
//#			C(MPAC) = TERMNL RAD M		C(MPAC) = PERIGEE RAD M
// PORT: SOURCE TIME_OF_FREE_FALL.agc:335
//#	FOR EITHER,	E: (-29)	M: (-27)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:336
//#	FOR EITHER, PUSHLOC = PDL+0 , ARBITRARY IF LEQ 8D.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:337
//# Page 1381
// PORT: SOURCE TIME_OF_FREE_FALL.agc:338
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:339
//# SUBROUTINES CALLED:	T(X), VIA RTB
// PORT: SOURCE TIME_OF_FREE_FALL.agc:340
//# NORMAL EXIT MODE: RVQ
// PORT: SOURCE TIME_OF_FREE_FALL.agc:341
//#		HOWEVER, PROGRAM EXITS WITH ONE OF THE FOLLOWING VALUES FOR TFF (-28) CS IN MPAC.  USER MUST STORE.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:342
//#			A. TFF = FLIGHT TIME.  NORMAL CASE FOR POSITIVE FLIGHT TIME LESS THAN ONE ORBITAL PERIOD.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:343
//#			B. (THIS OPTION IS NO LONGER USED.)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:344
//#			C. TFF = POSMAX.  THIS INDICATES THAT THE CONIC FROM THE PRESENT POSITION WILL NOT RETURN TO
// PORT: SOURCE TIME_OF_FREE_FALL.agc:345
//#			   THE SPECIFIED ALTITUDE.  ALSO INDICATES OUTBOUND PARABOLA OR HYPERBOLA.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:346
//# OUTPUT:	C(MPAC)		(-28) CS	TIME OF FLIGHT, OR TIME TO PERIGEE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:347
//#		TFFX		(0)		X,					LEFT FOR ENTRY DISPLAY TFF ROUTINES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:348
//#		NRTERM		E: (-29+NR)	M RTERM, WEIGHTED BY NR			LEFT FOR ENTRY DISPLAY TFF ROUTINES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:349
//#				M: (-27+NR)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:350
//#		TFFTEM		E: (-59+2NR)	LCP Z Z SGN(SDELF)			LEFT FOR ENTRY DISPLAY TFF ROUTINES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:351
//#				M: (-55+2NR)	LCP /ALFA SGN(SDELF)			LEFT FOR ENTRY DISPLAY TFF ROUTINES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:352
//#		NOTE:	TFFTEM = PDL 36D AND WILL BE DESTROYED BY .:UNIT:.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:353
//#		RMAG1	E:(-29) M:(-27)	PDL 12 NOT TOUCHED.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:354
//#		TFFQ1	E:(-16) M:(-15)	PDL 14D
// PORT: SOURCE TIME_OF_FREE_FALL.agc:355
//#		TFFDELQ	E:(-16) M:(-15)	PDL 10D
// PORT: SOURCE TIME_OF_FREE_FALL.agc:356
//#		PUSHLOC	AT PDL+0
// PORT: SOURCE TIME_OF_FREE_FALL.agc:357
