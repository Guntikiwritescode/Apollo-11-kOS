// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:32
//
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:33
//# Page 785
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:34
//# MUN AND KERBOL EPHEMERIDES SUBROUTINES
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:35
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:36
//# FUNCTIONAL DESCRIPTION
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:37
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:38
//#	THESE SUBROUTINES ARE USED TO DETERMINE THE POSITION AND VELOCITY
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:39
//#	VECTORS OF KERBOL AND THE MUN RELATIVE TO KERBIN AT THE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:40
//#	SPECIFIED GROUND ELAPSED TIME INPUT BY THE USER.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:41
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:42
//#	THE POSITION OF THE MUN IS STORED IN THE COMPUTER IN THE FORM OF
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:43
//#	A NINTH DEGREE POLYNOMIAL APPROXIMATION WHICH IS VALID OVER A 15
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:44
//#	DAY INTERVAL BEGINNING SHORTLY BEFORE LAUNCH.  THEREFORE THE TIME
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:45
//#	INPUT BY THE USER SHOULD FALL WITHIN THIS 15 DAY INTERVAL.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:46
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:47
//#	LSPOS COMPUTES THE POSITION VECTORS OF KERBOL AND THE MUN.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:48
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:49
//#	LUNPOS COMPUTES THE POSITION VECTOR OF THE MUN.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:50
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:51
//#	LUNVEL COMPUTES THE VELOCITY VECTOR OF THE MUN.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:52
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:53
//#	SOLPOS COMPUTES THE POSITION VECTOR OF KERBOL.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:54
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:55
//# CALLING SEQUENCE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:56
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:57
//#	DLOAD	CALL
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:58
//#		TIME		GROUND ELAPSED TIME
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:59
//#		SUBROUTINE	LSPOS OR LUNPOS OR LUNVEL OR SOLPOS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:60
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:61
//# INPUT
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:62
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:63
//#	1) SPECIFIED GROUND ELAPSED TIME IN CS x B-28 LOADED IN MPAC.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:64
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:65
//#	2) TIMEMO - TIME AT THE CENTER OF THE RANGE OVER WHICH THE MUN
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:66
//#	   POSITION POLYNOMIAL IS VALID IN CS x B-42.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:67
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:68
//#	3) VECOEM - VECTOR COEFFICIENTS OF THE MUN POSITION POLYNOMIAL
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:69
//#	   LOADED IN DESCENDING SEQUENCE IN METERS/CS**N x B-2
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:70
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:71
//#	4) RESO - POSITION VECTOR OF KERBOL RELATIVE TO KERBIN AT
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:72
//#	   TIMEMO IN METERS x B-38.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:73
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:74
//#	5) VESO - VELOCITY VECTOR OF KERBOL RELATIVE TO KERBIN AT
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:75
//#	   TIMEMO IN METERS/CS x B-9.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:76
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:77
//#	6) OMEGAES - ANGULAR VELOCITY OF THE VECTOR RESO AT TIMEMO IN
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:78
//#	   REV/CS x B+26.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:79
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:80
//#	ALL EXCEPT THE FIRST INPUT ARE INCLUDED IN THE PRE-LAUNCH
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:81
//#	ERASABLE DATA LOAD.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:82
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:83
//# OUTPUT - LSPOS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:84
//# Page 786
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:85
//#	1) 2D OF VAC AREA CONTAINS THE POSITION VECTOR OF KERBOL RELATIVE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:86
//#	   TO KERBIN AT TIME INPUT BY THE USER IN METERS x B-38.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:87
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:88
//#	2) MPAC CONTAINS THE POSITION VECTOR OF THE MUN RELATIVE TO THE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:89
//#	   KERBIN AT TIME INPUT BY THE USER IN METERS x B-29.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:90
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:91
//# OUTPUT - LUNPOS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:92
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:93
//#	MPAC CONTAINS THE POSITION VECTOR OF THE MUN RELATIVE TO THE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:94
//#	KERBIN AT THE TIME INPUT BY USER IN METERS x B-29.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:95
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:96
//# OUTPUT - LUNVEL
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:97
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:98
//#	MPAC CONTAINS THE VELOCITY VECTOR OF THE MUN RELATIVE TO THE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:99
//#	KERBIN AT THE TIME INPUT BY THE USER IN METERS/CS x B-7.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:100
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:101
//# OUTPUT - SOLPOS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:102
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:103
//#	MPAC CONTAINS THE POSITION VECTOR OF KERBOL RELATIVE TO KERBIN
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:104
//#	AT TIME INPUT BY THE USER IN METERS x B-38.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:105
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:106
//# SUBROUTINES USED
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:107
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:108
//#	NONE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:109
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:110
//# REMARKS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:111
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:112
//#	THE VAC AREA IS USED FOR STORAGE OF INTERMEDIATE AND FINAL RESULTS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:113
//#	OF COMPUTATIONS.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:114
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:115
//#	S1, X1 AND X2 ARE USED BY THESE SUBROUTINES.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:116
//#	PRELAUNCH ERASABLE DATA LOAD ARE ONLY ERASABLE STORAGE USED BY
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:117
//#	THESE SUBROUTINES.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:118
//#	RESTARTS DURING OPERATION OF THESE SUBROUTINES MUST BE HANDLED BY
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:119
//#	THE USER.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:120
//
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:121
//		BANK	36
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:122
