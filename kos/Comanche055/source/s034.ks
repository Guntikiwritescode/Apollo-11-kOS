// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:124
//
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:125
//		COUNT*	$$/EPHEM
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:126
//		EBANK=	END-E7
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:127
//LSPOS		AXT,2			# COMPUTES POSITION VECTORS OF BOTH THE
// slot 24648
    24648, 65528,
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:128
//			RESA		# KERBOL AND THE MUN.  THE POSITION VECTOR
// slot 24649
    24649, 45282
)).

