// PORT: SOURCE LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:124
//
// PORT: SOURCE LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:125
//		COUNT*	$$/EPHEM
// PORT: SOURCE LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:126
//		EBANK=	END-E7
// PORT: SOURCE LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:127
//LSPOS		AXT,2			# COMPUTES POSITION VECTORS OF BOTH THE
// PORT: Fixed ROM slots 24648.
    24648, 65528,
