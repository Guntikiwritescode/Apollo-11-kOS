function agcAotUnit217 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4951 {
        if slot <= 4950 {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:1
//# Copyright:    Public domain.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:2
