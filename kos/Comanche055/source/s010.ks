// PORT: Physical bank 10. Shared continuation entries, slots 10603–10660.
function agcAotUnit658 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 10631 {
        if slot <= 10616 {
            if slot <= 10609 {
                if slot <= 10605 {
                    if slot <= 10603 {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:530
//
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:531
//# *** ALL EXTENDED VERB ROUTINES THAT HAVE AT LEAST ONE FLASHING DISPLAY MUST TCF ENDMARK OR TCF ENDEXT WHEN
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:532
//# FINISHED.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:533
//
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:534
//		BANK	10
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:535
//		SETLOC	DISPLAYS
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:536
//		BANK
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:537
//
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:538
//		COUNT	10/DSPLA
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:539
