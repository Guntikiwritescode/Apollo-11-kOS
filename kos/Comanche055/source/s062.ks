// PORT: Physical bank 02. Shared continuation entries, slots 4172–4174.
function agcAotUnit144 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4172 {
// PORT: SOURCE RESTART_TABLES.agc:461
//
// PORT: SOURCE RESTART_TABLES.agc:462
//# Page 220
// PORT: SOURCE RESTART_TABLES.agc:463
//# PROGRAM DESCRIPTION: NEWPHASE						DATE:  11 NOV 1966
// PORT: SOURCE RESTART_TABLES.agc:464
//# MOD: 1								ASSEMBLY:  SUNBURST REV
// PORT: SOURCE RESTART_TABLES.agc:465
//# MOD BY: COPPS								LOG SECTION: PHASE TABLE MAINTENANCE
// PORT: SOURCE RESTART_TABLES.agc:466
//# FUNCTIONAL DESCRIPTION:
// PORT: SOURCE RESTART_TABLES.agc:467
//#
// PORT: SOURCE RESTART_TABLES.agc:468
//#	NEWPHASE IS THE QUICK WAY TO MAKE A NON VARIABLE PHASE CHANGE. IT INCLUDES THE OPTION OF SETTING
// PORT: SOURCE RESTART_TABLES.agc:469
//#	TBASE OF THE GROUP.  IF TBASE IS TO BE SET, -C(TIME1) IS STORED IN THE TBASE TABLE AS FOLLOWS:
// PORT: SOURCE RESTART_TABLES.agc:470
//#
// PORT: SOURCE RESTART_TABLES.agc:471
//#		(L-1)	TBASE0
// PORT: SOURCE RESTART_TABLES.agc:472
//#		(L)	TBASE1	(IF GROUP=1)
// PORT: SOURCE RESTART_TABLES.agc:473
//#		(L+1)
// PORT: SOURCE RESTART_TABLES.agc:474
//#		(L+2)	TBASE2	(IF GROUP=2)
// PORT: SOURCE RESTART_TABLES.agc:475
//#		-----
// PORT: SOURCE RESTART_TABLES.agc:476
//#		(L+6)	TBASE4	(IF GROUP=4)
// PORT: SOURCE RESTART_TABLES.agc:477
//#		(L+7)
// PORT: SOURCE RESTART_TABLES.agc:478
//#		(L+8)	TBASE5	(IF GROUP=5)
// PORT: SOURCE RESTART_TABLES.agc:479
//#
// PORT: SOURCE RESTART_TABLES.agc:480
//#	IN ANY CASE, THE NEGATIVE OF THE PHASE, FOLLOWED (IN THE NEXT REGISTER) BY THE PHASE, IS STORED IN THE
// PORT: SOURCE RESTART_TABLES.agc:481
//#	PHASE TABLE AS FOLLOWS:
// PORT: SOURCE RESTART_TABLES.agc:482
//#
// PORT: SOURCE RESTART_TABLES.agc:483
//#		(L)	-PHASE1	(IF GROUP=1)
// PORT: SOURCE RESTART_TABLES.agc:484
//#		(L+1)	PHASE1
// PORT: SOURCE RESTART_TABLES.agc:485
//#		(L+2)	-PHASE2	(IF GROUP=2)
// PORT: SOURCE RESTART_TABLES.agc:486
//#		(L+3)	PHASE2
// PORT: SOURCE RESTART_TABLES.agc:487
//#		-----
// PORT: SOURCE RESTART_TABLES.agc:488
//#		(L+7)	PHASE4
// PORT: SOURCE RESTART_TABLES.agc:489
//#		(L+8)	-PHASE5	(IF GROUP=5)
// PORT: SOURCE RESTART_TABLES.agc:490
//#		(L+9)	PHASE5
// PORT: SOURCE RESTART_TABLES.agc:491
//#
// PORT: SOURCE RESTART_TABLES.agc:492
//# CALLING SEQUENCE:
// PORT: SOURCE RESTART_TABLES.agc:493
//#	EXAMPLE IS FOR PLACING A PHASE OF FIVE INTO GROUP THREE:
// PORT: SOURCE RESTART_TABLES.agc:494
//#
// PORT: SOURCE RESTART_TABLES.agc:495
//#	1) IF TBASE IS NOT TO BE SET:
// PORT: SOURCE RESTART_TABLES.agc:496
//#			L-1	CA	FIVE
// PORT: SOURCE RESTART_TABLES.agc:497
//#			L	TC	NEWPHASE
// PORT: SOURCE RESTART_TABLES.agc:498
//#			L+1	OCT	00003
// PORT: SOURCE RESTART_TABLES.agc:499
//#
// PORT: SOURCE RESTART_TABLES.agc:500
//#	2) IF TBASE IS TO BE SET:
// PORT: SOURCE RESTART_TABLES.agc:501
//#			L-1	CS	FIVE
// PORT: SOURCE RESTART_TABLES.agc:502
//#			L	TC	NEWPHASE
// PORT: SOURCE RESTART_TABLES.agc:503
//#			L+1	OCT	00003
// PORT: SOURCE RESTART_TABLES.agc:504
//#
// PORT: SOURCE RESTART_TABLES.agc:505
//# SUBROUTINES CALLED: NONE
// PORT: SOURCE RESTART_TABLES.agc:506
//#
// PORT: SOURCE RESTART_TABLES.agc:507
//# NORMAL EXIT MODE: AT L+2 OF CALLING SEQUENCE
// PORT: SOURCE RESTART_TABLES.agc:508
//#
// PORT: SOURCE RESTART_TABLES.agc:509
//# ALARM OR ABORT EXITS: NONE
// PORT: SOURCE RESTART_TABLES.agc:510
//#
// PORT: SOURCE RESTART_TABLES.agc:511
//# OUTPUT: PHASE TABLE AND TBASE TABLE UPDATED
// PORT: SOURCE RESTART_TABLES.agc:512
//#
// PORT: SOURCE RESTART_TABLES.agc:513
//# ERASABLE INITIALIZATION REQ'D: NONE
// PORT: SOURCE RESTART_TABLES.agc:514
//# Page 221
// PORT: SOURCE RESTART_TABLES.agc:515
//# DEBRIS:  A,L,TEMPG
// PORT: SOURCE RESTART_TABLES.agc:516
//
// PORT: SOURCE RESTART_TABLES.agc:517
//# ***WARNING*** THIS PROGRAM IS TO BE PLACED IN FIXED-FIXED AND UNSWITCHED ERASABLE.
// PORT: SOURCE RESTART_TABLES.agc:518
//
// PORT: SOURCE RESTART_TABLES.agc:519
//		BLOCK	02
// PORT: SOURCE RESTART_TABLES.agc:520
//		SETLOC	FFTAG1
// PORT: SOURCE RESTART_TABLES.agc:521
//		BANK
// PORT: SOURCE RESTART_TABLES.agc:522
//
// PORT: SOURCE RESTART_TABLES.agc:523
//		COUNT*	$$/PHASE
// PORT: SOURCE RESTART_TABLES.agc:524
//
// PORT: SOURCE RESTART_TABLES.agc:525
//NEWPHASE	INHINT
// PORT: Fixed ROM slots 4172.
        if slot <> 4172 or instruction <> 4 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 4, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    } else {
        if slot <= 4173 {
// PORT: SOURCE RESTART_TABLES.agc:526
//
// PORT: SOURCE RESTART_TABLES.agc:527
//		TS	L			# SAVE FOR FURTHER USE
// PORT: Fixed ROM slots 4173.
            if slot <> 4173 or instruction <> 22529 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 22529, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE RESTART_TABLES.agc:528
//		NDX	Q			# OBTAIN THE GROUP NUMBER
// PORT: Fixed ROM slots 4174.
            if slot <> 4174 or instruction <> 20482 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20482, words[0], readEffective).
            }
            if extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20482, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
set agcAotRoutes[144] to agcAotUnit144@.

agcAotInstallSourceRope(list(
// PORT: SOURCE RESTART_TABLES.agc:529
