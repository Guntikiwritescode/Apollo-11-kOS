// PORT: Physical bank 13. Shared continuation entries, slots 14005–14006.
function agcAotUnit768 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 14005 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:678
//		CA	MPAC
// PORT: Fixed ROM slots 14005.
        if slot <> 14005 or instruction <> 12396 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreCA(words, 108).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:679
//		INDEX	FIXLOC
// PORT: Fixed ROM slots 14006.
        if slot <> 14006 or instruction <> 20560 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        if extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
