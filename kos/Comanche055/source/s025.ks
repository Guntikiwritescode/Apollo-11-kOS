// PORT: Physical bank 13. Shared continuation entries, slots 14270–14271.
function agcAotUnit784 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 14270 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:1083
//		INCR	IRETURN1	# SET ERROR EXIT (CALLOC +2)
// PORT: Fixed ROM slots 14270.
        if slot <> 14270 or instruction <> 10839 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreINCR(words, 599).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:1084
//		TC	ALARM		# INSUFFICIENT TIME FOR INTEGRATION --
// PORT: Fixed ROM slots 14271.
        if slot <> 14271 or instruction <> 2984 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 2984, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
set agcAotRoutes[784] to agcAotUnit784@.

