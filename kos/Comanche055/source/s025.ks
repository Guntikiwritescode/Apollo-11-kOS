//# IS DONE AS IT IS FOR MIDTOAV2.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:959
//# RETURN IS IN BASIC TO THE RETURN ADDRESS PLUS ONE.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:960
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:961
//# IF THE INTEGRATION IS FINISHED TO THE DESIRED TIME, RETURN IS IN BASIC
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:962
//# TO THE RETURN ADDRESS.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:963
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:964
//# IN EITHER CASE , BEFORE RETURNING, THE EXTRAPOLATED STATE VECTOR IS TRAN
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:965
//# FERRED FROM R,VATT TO R,VN1-PIPTIME1 IS SET TO THE FINISHING INTEGRA-
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:966
//# TION TIME AND MPAC IS SET TO THE DELTA TIME---
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:967
//#			TAT MINUS CURRENT TIME.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:968
//
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:969
//# MIDTOAV2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:970
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:971
//# THIS ROUTINE INTEGRATES THE CSM STATE VECTOR TO CURRENT TIME PLUS
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:972
//# INCREMENTS OF TIMEDELT SUCH THAT THE DIFFERENCE BETWEEN CURRENT TIME
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:973
//# AND THE STATE VECTOR TIME AT THE END OF THE LAST STEP IS AT LEAST 5.6
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:974
//# SECS.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:975
//# NO INPUTS ARE REQUIRED OF THE CALLER.  RETURN IS IN BASIC TO THE RETURN
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:976
//# ADDRESS WITH THE ABOVE TRANSFERS TO R,VN1-PIPTIME1-AND MPAC DONE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:977
//
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:978
