// PORT: Physical bank 13. Shared continuation entries, slots 13876–13879.
function agcAotUnit764 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 13877 {
        if slot <= 13876 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:463
//
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:464
//SETBANK		CAF	INTBANK
// PORT: Fixed ROM slots 13876.
            if slot <> 13876 or instruction <> 13880 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                local fixedOperand is mod(readEffective:call(words, 1592), 32768).
                set words[0] to agcSignExtend(fixedOperand).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:465
//		TS	BBANK
// PORT: Fixed ROM slots 13877.
            if slot <> 13877 or instruction <> 22534 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 22534, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 13878 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:466
//		CAF	FORTYONE
// PORT: Fixed ROM slots 13878.
            if slot <> 13878 or instruction <> 14151 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                local fixedOperand is mod(readEffective:call(words, 1863), 32768).
                set words[0] to agcSignExtend(fixedOperand).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:467
//		TC	Q
// PORT: Fixed ROM slots 13879.
            if slot <> 13879 or instruction <> 2 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 2, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
