// PORT: Physical bank 13. Shared continuation entries, slots 13721–13722.
function agcAotUnit744 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 13721 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:277
