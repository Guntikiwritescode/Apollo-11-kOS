// bank 13, slots 14228-14234
function agcAotUnit783 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 14230 {
        if slot <= 14228 {
// INTEGRATION_INITIALIZATION.agc:1034
//
// INTEGRATION_INITIALIZATION.agc:1035
//		INHINT
// slot 14228
            if slot <> 14228 or instruction <> 4 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 4, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
            if slot <= 14229 {
// INTEGRATION_INITIALIZATION.agc:1036
//		EXTEND
// slot 14229
                if slot <> 14229 or instruction <> 6 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 6, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// INTEGRATION_INITIALIZATION.agc:1037
//		DCS	TIME2
// slot 14230
                if slot <> 14230 or instruction <> 16405 { return choose false if checkOnly else -1. }
                if extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    if not agcCoreDoubleExchange(words, "DCS", 21, readPhysical, readAdjacent) { return -1. }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        }
    } else {
        if slot <= 14232 {
            if slot <= 14231 {
// INTEGRATION_INITIALIZATION.agc:1038
//		DAS	MPAC
// slot 14231
                if slot <> 14231 or instruction <> 8301 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    if not agcCoreDas(words, 109) { return -1. }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
// INTEGRATION_INITIALIZATION.agc:1039
//		TC	TPAGREE
// slot 14232
                if slot <> 14232 or instruction <> 3734 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 3734, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 14233 {
// INTEGRATION_INITIALIZATION.agc:1040
//
// INTEGRATION_INITIALIZATION.agc:1041
//		CA	IRETURN1
// slot 14233
                if slot <> 14233 or instruction <> 12887 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCA(words, 599).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
// INTEGRATION_INITIALIZATION.agc:1042
//		TC	BANKJUMP
// slot 14234
                if slot <> 14234 or instruction <> 2500 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 2500, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        }
    }
}
