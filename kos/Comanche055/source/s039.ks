// PORT: Physical bank 11. Shared continuation entries, slots 12155–12155.
function agcAotUnit711 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE ORBITAL_INTEGRATION.agc:734
//		TC	PHASCHNG
// PORT: Fixed ROM slots 12155.
    if slot <> 12155 or instruction <> 2826 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2826, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[711] to agcAotUnit711@.

