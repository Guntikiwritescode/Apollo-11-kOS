// PORT: Physical bank 11. Shared continuation entries, slots 11782–11782.
function agcAotUnit710 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE ORBITAL_INTEGRATION.agc:321
//		TC	POODOO
// PORT: Fixed ROM slots 11782.
    if slot <> 11782 or instruction <> 3025 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3025, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[710] to agcAotUnit710@.

