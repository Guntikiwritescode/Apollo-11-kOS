// PORT: Physical bank 23. Shared continuation entries, slots 22266–22266.
function agcAotUnit1256 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE INFLIGHT_ALIGNMENT_ROUTINES.agc:205
//		TC	ALARM
// PORT: Fixed ROM slots 22266.
    if slot <> 22266 or instruction <> 2984 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2984, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[1256] to agcAotUnit1256@.

