//#	Assemble revision 055 of AGC program Comanche by NASA
// ERASABLE_ASSIGNMENTS.agc:35
//#	2021113-051.  10:28 APR. 1, 1969
// ERASABLE_ASSIGNMENTS.agc:36
//#
