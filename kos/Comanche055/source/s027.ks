//#	BITS 1-4	SWITCH BIT NUMBER (1-15).
// INTERPRETER.agc:2990
//#	BITS 5-8	SWITCH OPERATION NUMBER
// INTERPRETER.agc:2991
//#	BITS 9-		SWITCH WORD NUMBER (UP TO 64 SWITCH WORDS).
// INTERPRETER.agc:2992
//# THE ADDRESS ITSELF IS MADE UP BY THE YUL SYSTEM ASSEMBLER.  THE BRANCH INSTRUCTIONS REQUIRE TWO
// INTERPRETER.agc:2993
//# ADDRESSES, THE SECOND TAKEN AS THE DIRECT (OR INDIRECT IF IN ERASABLE) ADDRESS OF THE BRANCH.
// INTERPRETER.agc:2994
//
// INTERPRETER.agc:2995
//SWITCHES	CAF	LOW4		# LEAVE THE SWITCH BIT IN SWBIT.
// slot 3427
            if slot <> 3427 or instruction <> 14870 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                local fixedOperand is mod(readEffective:call(words, 2582), 32768).
                set words[0] to agcSignExtend(fixedOperand).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 3428 {
// INTERPRETER.agc:2996
//		MASK	POLISH
// slot 3428
            if slot <> 3428 or instruction <> 28751 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                agcCoreMASK(words, 79).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// INTERPRETER.agc:2997
//		INDEX	A
// slot 3429
            if slot <> 3429 or instruction <> 20480 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20480, words[0], readEffective).
            }
            if extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20480, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
