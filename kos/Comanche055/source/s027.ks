    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 20573, words[0], readEffective).
    }
    if extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 20573, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
