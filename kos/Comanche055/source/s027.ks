// INTERPRETER.agc
// bank 03, slots 5126-5138
function agcAotUnit246 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5131 {
        if slot <= 5128 {
            if slot <= 5126 {
// INTERPRETER.agc:1
//# Copyright:	Public domain.
// INTERPRETER.agc:2
//# Filename:	INTERPRETER.agc
// INTERPRETER.agc:3
//# Purpose:	Part of the source code for Colossus 2A, AKA Comanche 055.
// INTERPRETER.agc:4
//#		It is part of the source code for the Command Module's (CM)
// INTERPRETER.agc:5
//#		Apollo Guidance Computer (AGC), for Apollo 11.
// INTERPRETER.agc:6
//# Assembler:	yaYUL
// INTERPRETER.agc:7
//# Contact:	Burkey Kerman <info@sandroid.org>.
// INTERPRETER.agc:8
//# Website:	www.ibiblio.org/apollo.
// INTERPRETER.agc:9
//# Pages:	1107-1199
// INTERPRETER.agc:10
//# Mod history:	2009-05-08 RSB	Adapted from the Luminary131/ file of the
// INTERPRETER.agc:11
//#				same name, using Comanche055 page images.
// INTERPRETER.agc:12
//#		2009-05-20 RSB	Corrections:  P00D00 -> P00DOO, fixed a
// INTERPRETER.agc:13
//#				"Page N" reference.
// INTERPRETER.agc:14
//#		2009-05-21 RSB	Corrected definition of 5B10, which overflowed
// INTERPRETER.agc:15
//#				integer arithmetic.
// INTERPRETER.agc:16
//#
// INTERPRETER.agc:17
//# This source code has been transcribed or otherwise adapted from digitized
// INTERPRETER.agc:18
//# images of a hardcopy from the MIT Museum.  The digitization was performed
// INTERPRETER.agc:19
//# by Fjeld Kerman, and arranged for by Douglas Kerman of the Museum.  Many
// INTERPRETER.agc:20
//# thanks to both.  The images (with suitable reduction in storage size and
// INTERPRETER.agc:21
//# consequent reduction in image quality as well) are available online at
// INTERPRETER.agc:22
//# www.ibiblio.org/apollo.  If for some reason you find that the images are
// INTERPRETER.agc:23
//# illegible, contact me at info@sandroid.org about getting access to the
// INTERPRETER.agc:24
//# (much) higher-quality images which Fjeld Kerman actually created.
// INTERPRETER.agc:25
//#
// INTERPRETER.agc:26
//# Notations on the hardcopy document read, in part:
// INTERPRETER.agc:27
//#
// INTERPRETER.agc:28
//#	Assemble revision 055 of AGC program Comanche by NASA
// INTERPRETER.agc:29
//#	2021113-051.  10:28 APR. 1, 1969
// INTERPRETER.agc:30
//#
// INTERPRETER.agc:31
//#	This AGC program shall also be referred to as
// INTERPRETER.agc:32
//#			Colossus 2A
// INTERPRETER.agc:33
//
// INTERPRETER.agc:34
//# Page 1107
// INTERPRETER.agc:35
//# SECTION 1:  DISPATCHER
// INTERPRETER.agc:36
//#
// INTERPRETER.agc:37
//# ENTRY TO THE INTERPRETER.  INTPRET SETS LOC TO THE FIRST INSTRUCTION, BANKSET TO THE BBANK OF THE
// INTERPRETER.agc:38
//# OBJECT INTERPRETIVE PROGRAM, AND INTBIT15 TO THE BIT15 CONTENTS OF FBANK.  INTERPRETIVE PROGRAMS MAY BE IN
// INTERPRETER.agc:39
//# VIRTUALLY ALL BANKS PRESENT UNDER ANY SUPER-BANK SETTING, WITH THE RESTRICTION THAT PROGRAMS IN HIGH BANKS
// INTERPRETER.agc:40
//# (BIT15 OF FBANK = 1) DO NOT REFER TO LOWBANKS, AND VICE-VERSA.  THE INTERPRETER DOES NOT SWITCH SUPERBANKS.
// INTERPRETER.agc:41
//# E-BANK SWITCHING OCCURS WHENEVER GENERAL ERASABLE (100-3777) IS ADDRESSED.
// INTERPRETER.agc:42
//
// INTERPRETER.agc:43
//		BLOCK	03
// INTERPRETER.agc:44
//
// INTERPRETER.agc:45
//		COUNT	03/INTER
// INTERPRETER.agc:46
//
// INTERPRETER.agc:47
//INTPRET		RELINT
// slot 5126
                if slot <> 5126 or instruction <> 3 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 3, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5127 {
// INTERPRETER.agc:48
//		EXTEND				# SET LOC TO THE WORD FOLLOWING THE TC.
// slot 5127
                    if slot <> 5127 or instruction <> 6 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 6, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:49
//		QXCH	LOC
// slot 5128
                    if slot <> 5128 or instruction <> 9332 { return choose false if checkOnly else -1. }
                    if extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreExchange(words, 2, 116, readPhysical).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5129 {
// INTERPRETER.agc:50
//
// INTERPRETER.agc:51
//	+2	CA	BBANK			# INTERPRETIVE BRANCHES FINISH HERE.
// slot 5129
                if slot <> 5129 or instruction <> 12294 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCA(words, 6).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5130 {
// INTERPRETER.agc:52
//		TS	BANKSET
// slot 5130
                    if slot <> 5130 or instruction <> 22645 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22645, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:53
//		MASK	BIT15			# GET 15TH BIT FOR INDEXABLE ADDRESSES.
// slot 5131
                    if slot <> 5131 or instruction <> 31233 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        set words[0] to agcOverflowCorrected(words[0]).
                        local fixedOperand is mod(readEffective:call(words, 2561), 32768).
                        if fixedOperand = 16384 {
                            set words[0] to agcSignExtend(mod(floor(words[0] / 16384), 2) * 16384).
                        } else {
                            set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                        }
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    } else {
        if slot <= 5134 {
            if slot <= 5132 {
// INTERPRETER.agc:54
//		TS	INTBIT15
// slot 5132
                if slot <> 5132 or instruction <> 22605 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22605, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5133 {
// INTERPRETER.agc:55
//
// INTERPRETER.agc:56
//		TS	EDOP			# MAKE SURE NO INSTRUCTIONS LEFT OVER
// slot 5133
                    if slot <> 5133 or instruction <> 22547 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22547, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:57
//
// INTERPRETER.agc:58
//		TCF	NEWOPS			# PICK UP OP CODE PAIR AND BEGIN.
// slot 5134
                    if slot <> 5134 or instruction <> 7199 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7199, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5136 {
                if slot <= 5135 {
// INTERPRETER.agc:59
//
// INTERPRETER.agc:60
//
// INTERPRETER.agc:61
//INTRSM		LXCH	BBANK			# RESUME SUSPENDED INTERPRETIVE JOB
// slot 5135
                    if slot <> 5135 or instruction <> 9222 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreExchange(words, 1, 6, readPhysical).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:62
//		TCF	INTPRET +3
// slot 5136
                    if slot <> 5136 or instruction <> 7177 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7177, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 5137 {
// INTERPRETER.agc:63
//# DLOAD LOADS MPAC, MPAC +1, LEAVING ZERO IN MPAC +2.
// INTERPRETER.agc:64
//
// INTERPRETER.agc:65
//DLOAD		EXTEND
// slot 5137
                    if slot <> 5137 or instruction <> 6 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 6, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:66
//		INDEX	ADDRWD
// slot 5138
                    if slot <> 5138 or instruction <> 20558 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20558, words[0], readEffective).
                    }
                    if extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20558, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    }
}
set agcAotRoutes[246] to agcAotUnit246@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:67
//		DCA	0			# LOAD DP C(C(ADDRWD)) INTO MPAC,MPAX +1
// slot 5139
    5139, 24578
)).

// bank 03, slots 5140-5151
function agcAotUnit247 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5145 {
        if slot <= 5142 {
            if slot <= 5140 {
// INTERPRETER.agc:68
//SLOAD2		DXCH	MPAC
// slot 5140
                if slot <> 5140 or instruction <> 21613 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    if not agcCoreDoubleExchange(words, "DXCH", 109, readPhysical, readAdjacent) { return -1. }
                    return list(false, false, true, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5141 {
// INTERPRETER.agc:69
//		CAF	ZERO			# ZERO MPAC +2
// slot 5141
                    if slot <> 5141 or instruction <> 14865 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        local fixedOperand is mod(readEffective:call(words, 2577), 32768).
                        set words[0] to agcSignExtend(fixedOperand).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:70
//
// INTERPRETER.agc:71
//# Page 1108
// INTERPRETER.agc:72
//# AT THE END OF MOST INSTRUCTIONS, CONTROL IS GIVEN TO DANZIG TO DISPATCH THE NEXT OPERATION.
// INTERPRETER.agc:73
//
// INTERPRETER.agc:74
//		TS	MPAC +2			# AND DECLARE DP MODE
// slot 5142
                    if slot <> 5142 or instruction <> 22638 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22638, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5143 {
// INTERPRETER.agc:75
//
// INTERPRETER.agc:76
//NEWMODE		TS	MODE			# PROLOGUE FOR MODE-CHANGING INSTRUCTIONS.
// slot 5143
                if slot <> 5143 or instruction <> 22643 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22643, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5144 {
// INTERPRETER.agc:77
//
// INTERPRETER.agc:78
//DANZIG		CA	BANKSET			# SET BBANK BEFORE TESTING NEWJOB SO THAT
// slot 5144
                    if slot <> 5144 or instruction <> 12405 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCA(words, 117).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:79
//		TS 	BBANK			# IT MAY BE SAVED DIRECTLY BY CHANJOB.
// slot 5145
                    if slot <> 5145 or instruction <> 22534 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22534, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    } else {
        if slot <= 5148 {
            if slot <= 5146 {
// INTERPRETER.agc:80
//
// INTERPRETER.agc:81
//NOIBNKSW	CCS	EDOP			# SEE IF AN ORDER CODE IS LEFT OVER FROM
// slot 5146
                if slot <> 5146 or instruction <> 4115 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCCS(words, 19).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5147 {
// INTERPRETER.agc:82
//		TCF	OPJUMP			# THE LAST PAIR RETRIEVED.  IF SO, EXECUTE.
// slot 5147
                    if slot <> 5147 or instruction <> 7206 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7206, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:83
//						# EDOP IS SET TO ZERO ON ITS RE-EDITING.
// INTERPRETER.agc:84
//
// INTERPRETER.agc:85
//		CCS	NEWJOB			# SEE IF A JOB OF HIGHER PRIORITY IS
// slot 5148
                    if slot <> 5148 or instruction <> 4151 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCCS(words, 55).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5149 {
// INTERPRETER.agc:86
//		TCF	CHANG2			# PRESENT, AND IF SO, CHANGE JOBS.
// slot 5149
                if slot <> 5149 or instruction <> 6776 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 6776, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5150 {
// INTERPRETER.agc:87
//
// INTERPRETER.agc:88
//		INCR	LOC			# ADVANCE THE LOCATION COUNTER.
// slot 5150
                    if slot <> 5150 or instruction <> 10356 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreINCR(words, 116).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:89
//
// INTERPRETER.agc:90
//# ITRACE (1) REFERS TO "NEWOPS".
// INTERPRETER.agc:91
//NEWOPS		INDEX	LOC			# ENTRY TO BEGIN BY PICKING OP CODE PAIR.
// slot 5151
                    if slot <> 5151 or instruction <> 20596 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20596, words[0], readEffective).
                    }
                    if extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20596, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    }
}
set agcAotRoutes[247] to agcAotUnit247@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:92
//		CA	0			# MAY BE AN OPCODE PAIR OR A STORE CODE.
// slot 5152
    5152, 24576
)).

// bank 03, slots 5153-5154
function agcAotUnit248 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5153 {
// INTERPRETER.agc:93
//		CCS	A			# TEST SIGN AND GET DABS(A).
// slot 5153
        if slot <> 5153 or instruction <> 4096 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreCCS(words, 0).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// INTERPRETER.agc:94
//		TCF	DOSTORE			# PROCESS STORE CODE.
// slot 5154
        if slot <> 5154 or instruction <> 7385 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 7385, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
set agcAotRoutes[248] to agcAotUnit248@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:95
//
// INTERPRETER.agc:96
//LOW7		OCT	177
// slot 5155
    5155, 254
)).

// bank 03, slots 5156-5165
function agcAotUnit249 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5160 {
        if slot <= 5157 {
            if slot <= 5156 {
// INTERPRETER.agc:97
//
// INTERPRETER.agc:98
//		TS	EDOP			# OP CODE PAIR.  LEAVE THE OTHER IN EDOP
// slot 5156
                if slot <> 5156 or instruction <> 22547 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22547, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// INTERPRETER.agc:99
//		MASK	LOW7			# WHERE CCS EDOP WILL HONOR IT NEXT.
// slot 5157
                if slot <> 5157 or instruction <> 31779 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    set words[0] to agcOverflowCorrected(words[0]).
                    local fixedOperand is mod(readEffective:call(words, 3107), 32768).
                    if fixedOperand = 127 {
                        set words[0] to agcSignExtend(mod(floor(words[0] / 1), 128) * 1).
                    } else {
                        set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                    }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 5158 {
// INTERPRETER.agc:100
//
// INTERPRETER.agc:101
//OPJUMP		TS	CYR			# LOWWD ENTERS HERE IF A RIGHT-HAND OP
// slot 5158
                if slot <> 5158 or instruction <> 22544 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22544, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5159 {
// INTERPRETER.agc:102
//		CCS	CYR			# CODE IS TO BE PROCESSED.  TEST PREFICES.
// slot 5159
                    if slot <> 5159 or instruction <> 4112 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCCS(words, 16).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:103
//		TCF	OPJUMP2			# TEST SECOND PREFIX BIT.
// slot 5160
                    if slot <> 5160 or instruction <> 7310 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7310, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    } else {
        if slot <= 5162 {
            if slot <= 5161 {
// INTERPRETER.agc:104
//
// INTERPRETER.agc:105
//		TCF	EXIT			# +0 OP CODE IS EXIT
// slot 5161
                if slot <> 5161 or instruction <> 7626 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 7626, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// INTERPRETER.agc:106
//
// INTERPRETER.agc:107
//# Page 1109
// INTERPRETER.agc:108
//# PROCESS ADDRESSES WHICH MAY BE DIRECT, INDEXED, OR REFERENCE THE PUSHDOWN LIST.
// INTERPRETER.agc:109
//
// INTERPRETER.agc:110
//ADDRESS		MASK	BIT1			# SEE IF ADDRESS IS INDEXED.  CYR CONTAINED
// slot 5162
                if slot <> 5162 or instruction <> 31247 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    set words[0] to agcOverflowCorrected(words[0]).
                    local fixedOperand is mod(readEffective:call(words, 2575), 32768).
                    if fixedOperand = 1 {
                        set words[0] to agcSignExtend(mod(floor(words[0] / 1), 2) * 1).
                    } else {
                        set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                    }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 5163 {
// INTERPRETER.agc:111
//		CCS	A			# 400XX, SO BIT 1 IS NOW AS IT WAS IN CYR.
// slot 5163
                if slot <> 5163 or instruction <> 4096 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCCS(words, 0).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5164 {
// INTERPRETER.agc:112
//		TCF	INDEX			# FORM INDEXED ADDRESS.
// slot 5164
                    if slot <> 5164 or instruction <> 7245 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7245, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:113
