// PLANETARY_INERTIAL_ORIENTATION.agc:37
//#
// PLANETARY_INERTIAL_ORIENTATION.agc:38
//# SUBROUTINES USED
// PLANETARY_INERTIAL_ORIENTATION.agc:39
//#  EARTHMX,MOONMX,EARTHL
// PLANETARY_INERTIAL_ORIENTATION.agc:40
