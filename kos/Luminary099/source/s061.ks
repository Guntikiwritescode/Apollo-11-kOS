//# ..... RP-TO-R SUBROUTINE .....
// PLANETARY_INERTIAL_ORIENTATION.agc:29
//# SUBROUTINE TO CONVERT RP (VECTOR IN PLANETARY COORDINATE SYSTEM,EITHER
// PLANETARY_INERTIAL_ORIENTATION.agc:30
//#  EARTH-FIXED OR MOON-FIXED) TO R (SAME VECTOR IN THE BASIC REF. SYSTEM)
// PLANETARY_INERTIAL_ORIENTATION.agc:31
//#
// PLANETARY_INERTIAL_ORIENTATION.agc:32
//#  R=MT(T)*(RP+LPXRP)	 MT= M MATRIX TRANSPOSE
// PLANETARY_INERTIAL_ORIENTATION.agc:33
