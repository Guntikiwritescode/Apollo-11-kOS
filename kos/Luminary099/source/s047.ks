// PORT: Physical bank 11. Shared continuation entries, slots 11792–11792.
function agcAotUnit735 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE ORBITAL_INTEGRATION.agc:327
//		TC	POODOO
// PORT: Fixed ROM slots 11792.
    if slot <> 11792 or instruction <> 2986 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2986, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[735] to agcAotUnit735@.

