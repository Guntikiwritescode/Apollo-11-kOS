// PORT: Physical bank 11. Shared continuation entries, slots 12171–12171.
function agcAotUnit736 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE ORBITAL_INTEGRATION.agc:742
//		TC	PHASCHNG
// PORT: Fixed ROM slots 12171.
    if slot <> 12171 or instruction <> 2795 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2795, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[736] to agcAotUnit736@.

