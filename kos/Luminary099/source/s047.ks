// bank 11, slots 12224-12224
function agcAotUnit739 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// ORBITAL_INTEGRATION.agc:798
//		TC	ALARM
// slot 12224
    if slot <> 12224 or instruction <> 2935 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2935, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[739] to agcAotUnit739@.

