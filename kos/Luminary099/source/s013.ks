                    set words[0] to agcSignExtend(32767 - fixedOperand).
                    return list(false, false, true, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 11066 {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:1388
//		TC	NVSUB
// PORT: Fixed ROM slots 11066.
                if slot <> 11066 or instruction <> 2156 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 2156, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 11067 {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:1389
//		TCF	ENDOFJOB
// PORT: Fixed ROM slots 11067.
                    if slot <> 11067 or instruction <> 6765 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 6765, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:1390
//		TCF	ENDOFJOB
// PORT: Fixed ROM slots 11068.
                    if slot <> 11068 or instruction <> 6765 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 6765, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    }
}
