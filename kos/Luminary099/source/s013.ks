//# -------------------
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:362
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:363
//# ALARM OR ABORT EXIT MODE --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:364
//#	PRIOBORT	TC	ABORT
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:365
//#			OCT	1502
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:366
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:367
//#	PRIOBORT IS BRANCHED TO WHEN (1) A NORMAL DISPLAY IS REQUESTED AND ANOTHER NORMAL DISPLAY IS ALREADY ACTIVE
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:368
//#	(REFLASH AND REGODSP ARE EXCEPTIONS) OR (2) A PRIORITY DISPLAY IS REQUESTED WHEN ANOTHER PRIORITY DISPLAY IS
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:369
//#	ALREADY ACTIVE (A PRIORITY WITH LINUS BIT14 IS AN EXCEPTION).
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:370
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:371
//# ERASABLE INITIALIZATION REQUIRED --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:372
//#	ACCOMPLISHED BY FRESH START --	1.  FLAGWRD4 (USED EXCLUSIVELY BY DISPLAY INTERFACE ROUTINES)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:373
//#					2.  NVSAVE = NORMAL VERB AND NOUN REGISTER.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:374
//#					3.  EBANKTEM = NORMAL INACTIVE FLAGWORD (ALSO CONTAINS NORMALS EBANK).
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:375
//#					5.  R1SAVE = MARKBRAN CONTROL WORD
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:376
//#					4.  RESTREG = PRIORITY 30 AND SUPERBANK 3.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:377
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:378
//# OUTPUT --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:379
//#	NVWORD = PRIO VERB AND NOUN
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:380
//#	NVWORD +1 (MARKNV) = MARK VERB AND NOUN
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:381
//#	NVWORD +2 (NVSAVE) = NORMAL VERB AND NOUN
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:382
//#	DSPFLG (EBANKSAV) = PRIO FLAGWORD (INCLUDING EBANK)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:383
//#	DSPFLG +1 (MARKEBAN) = MARK FLAGWORD (INCLUDING EBANK)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:384
//#	DSPFLG +2 (EBANKTEM) = NORMAL FLAGWORD (INCLUDING EBANK)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:385
//#	CADRFLSH = PRIO USER'S CALL CADR +1 LOCATION
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:386
//#	CADRFLSH +1 (MARKFLSH) = MARK USER'S CALL CADR +1 LOCATION
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:387
//#	CADRFLSH +2 (TEMPFLSH) = NORMAL USER'S CALL CADR +1 LOCATION
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:388
//#	PRIOTIME = TIME EACH PRIO REQUEST FIRST SENT OUT
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:389
//#	OPTION1 = DESIRED OPTION FROM GOPERF4
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:390
//#	FLAGWRD4 = BIT INFO FOR CONTROL OF ALL DISPLAY ROUTINES
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:391
//#	DSPTEM1 = R1 INFO FOR ASTRONAUT FROM PERFORM DISPLAYS (NORMAL)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:392
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:393
//# SUBROUTINES USED -- NVSUB, FLAGUP, FLAGDOWN, ENDOFJOB, BLANKSUB, ABORT, JOBWAKE, JOBSLEEP, FINDVAC, PRIOCHNG,
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:394
//#	JAMTERM, NVSUBUSY, FLASHON, ENDIDLE, CHANG1, BANKJUMP, MAKECADR, NOVAC
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:395
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:396
//# DEBRIS -- (STORED INTO)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:397
//#	TEMPORARY TEMPORARIES -- A, Q, L, MPAC +2, MPAC +3, MPAC +4, MPAC +5, MPAC +6, RUPREG2, RUPTREG3, CYL,
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:398
//#		EBANK, RUPTREG4, LOC, BANKSET, MODE, MPAC, MPAC +1, FACEREG
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:399
//#	ERASABLES (SHARED AND USED WITH OTHER PROGRAMS) -- CADRSTOR, DSPLIST, LOC, DSPTEM1, OPTION1
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:400
//#	ERASABLES (USED ONLY BY DISPLAY ROUTINES) -- NVWORD,+1,+2, DSPFLAG,+1,+2, CADRFLSH,+1,+2, PRIOTIME, FLAGWRD4,
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:401
//# Page 1352
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:402
//#		R1SAVE, MARK2PAC
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:403
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:404
//# DEBRIS -- (USED BUT NOT STORED INTO) -- NOUNREG, VERBREG, LOCCTR, MONSAVE1
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:405
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:406
//# FLAGWORD DESCRIPTIONS --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:407
//#	FLAGWRD4 -- SEE DESCRIPTION UNDER LOG SECTION ERASABLE ASSIGNMENTS
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:408
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:409
//#	DSPFLG, DSPFLG+1, DSPFLG+2
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:410
//#	--------------------------
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:411
//#	BITS 1	BLANK R1
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:412
//#	     2	BLANK R2
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:413
//#	     3	BLANK R3
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:414
//#	     4	FLASHING DISPLAY REQUESTED
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:415
//#	     5	PERFORM DISPLAY REQUESTED
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:416
//#	     6	-----			EXDSPRET		GODSPRET
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:417
//#	     7	PRIO DISPLAY		-----			-----
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:418
//#	     8	-----			DEC MARK PERFORM	-----
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:419
//#	     9	EBANK
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:420
//#	    10	EBANK
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:421
//#	    11	EBANK
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:422
//#	    12	-----			-----			V99PASTE
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:423
//#	    13	2ND PART OF PERFORM
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:424
//#	    14	REFLASH OR REDO		-----			REFLASH OR REDO
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:425
//#	    15	-----			MARK REQUEST		-----
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:426
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:427
//# RESTARTING DISPLAYS --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:428
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:429
//# RULES FOR THE DSKY OPERATOR --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:430
//#	1.  PROCEED AND TERMINATE SERVE AS RESPONSES TO REQUESTS FOR OPERATOR RESPONSE (FLASHING V/N).  AS LONG
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:431
//#	    AS THERE IS ANY REQUEST AWAITING OPERATOR RESPONSE, ANY USE OF PROCEED OR TERMINATE WILL SERVE AS
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:432
//#	    RESPONSES TO THAT REQUEST.  CARE SHOULD BE EXERCISED IN ATTEMPTING TO KILL AN OPERATOR INITIATED MONITOR
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:433
//#	    WITH PROCEED AND TERMINATE FOR THIS REASON.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:434
//#	2.  THE ASTRONAUT MUST RESPOND TO A PRIORITY DISPLAY NO SOONER THAN 2 SECONDS FROM THE TIME THE
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:435
//#	    PROGRAM SENT OUT THE REQUEST FOR OPERATOR RESPONSE (THE ASTRONAUT WOULD SEE THIS DISPLAY FOR LESS TIME
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:436
//#	    DUE TO TIME IT TAKES TO GET DISPLAY SENT OUT.)  IF THE ASTRONAUT RESPONDS TOO SOON, THE PRIORITY DISPLAY
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:437
//#	    IS SENT OUT AGAIN -- AND AGAIN UNTIL AN ACCUMULATED 2 SECS FROM THE TIME THE FIRST PRIORITY DISPLAY
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:438
//#	    OUT.  THE SAME 2 SEC. DELAY WILL OCCUR AT 163.84 SECS OR IN ANY MULTIPLE OF THAT TIME DUE TO PROGRAM
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:439
//#	    CONSIDERATION.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:440
//#	3.  KEY RELEASE BUTTON --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:441
//#	    A)  IF THE KEY RELEASE LIGHT IS ON, IT SIMPLY RELEASES THE KEYBOARD AND DISPLAY FOR INTERNAL USE.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:442
//#	    B)  IF THE KEY RELEASE LIGHT IS OFF, AND IF SOME REQUEST FOR OPERATOR RESPONSE (FLASHING V/N) IS STILL
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:443
//#	        AWAITING RESPONSE THEN IT RE-ESTABLISHES THE DISPLAYS THAT ORIGINALLY REQUESTED RESPONSE.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:444
//#	    IF AN OPERATOR WANTS THEREFORE TO RE-ESTABLISH BUT CONDITION (A) IS ENCOUNTERED, A SECOND DEPRESSION OF
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:445
//#	    KEY RELEASE BUTTON MAY BE NECESSARY.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:446
//#	4.  IT IS IMPORTANT TO ANSWER ALL REQUESTS FOR OPERATOR RESPONSE.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:447
//#	5.  IT IS ALWAYS GOOD PRACTICE TO TERMINATE AN EXTENDED VERB BEFORE ASKING FOR ANOTHER ONE OR THE SAME ONE
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:448
//#	    OVER AGAIN.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:449
//#
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:450
//# SPECIAL CONSIDERATONS --
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:451
//# Page 1353
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:452
//#	1.  MPAC +2 SAVED ONLY IN MARK DISPLAYS
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:453
//#	2.  GODSP(R), REGODSP(R), GOMARK(R) ALWAYS TURN ON THE FLASH IF ENTERED WITH A PASTE VERB REQUEST.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:454
//#	3.  ALL NORMAL DISPLAYS ARE RESTARTABLE EXCEPT GODSP(R), REGODSP(R)
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:455
//#	4.  ALL EXTENDED VERBS WITH DISPLAYS SHOULD START WITH A TC TESTXACT AND FINISH WITH A TC ENDEXT.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:456
//#	5.  GODSP(R) AND REGODSP(R) MUST BE IN THE SAME EBANK AND SUPERBANK AS THE LAST NORMAL DISPLAY RESTARTED
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:457
//#	    BY A .1 RESTART PHASE CHANGE.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:458
//#	6.  IN ORDER TO SET UP A NON DISPLAY .1 RESTART POINT, THE USER MUST MAKE CERTAIN THAT RESTREG CONTAINS THE
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:459
//#	    CORRECT PRIORITY AND SUPERBANK AND THAT EBANKTEM CONTAINS THE CO
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:460
//#	7.  IF CLEANDSP IS RESTARTED VIA A .1 PHASE CHANGE, CAF ZERO SHOULD BE EXECUTED BEFORE THE TC BANKCALL.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:461
//
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:462
//# Page 1354
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:463
//# CALLING SEQUENCE FOR BLANKING
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:464
//#		CAF	BITX		# X=1,2,3 BLANK R1,R2,R3 RESPECTIVELY
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:465
//#		TC	BLANKET
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:466
//#		...	...		# RETURN TO USER HERE
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:467
//# IN ORDER TO USE BLANKET CORRECTLY, THE USER MUST USE A DISPLAY ROUTINE THAT ENDS IN R FIRST FOLLOWED BY THE CALL
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:468
//# TO BLANKET AT THE IMMEDIATE RETURN LOC.
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:469
//		BLOCK	02
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:470
//		SETLOC	FFTAG4
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:471
//		BANK
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:472
//
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:473
//		COUNT*	$$/DSPLA
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:474
//BLANKET		TS	MPAC 	+6
// PORT: Fixed ROM slots 4916.
            if slot <> 4916 or instruction <> 22642 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 22642, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:475
//		CS	PLAYTEM4
// PORT: Fixed ROM slots 4917.
            if slot <> 4917 or instruction <> 16496 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                agcCoreCS(words, 112).
                return list(false, false, true, false, false).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 4918 {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:476
//		MASK	MPAC 	+6
// PORT: Fixed ROM slots 4918.
            if slot <> 4918 or instruction <> 28786 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                agcCoreMASK(words, 114).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE DISPLAY_INTERFACE_ROUTINES.agc:477
//		INDEX	MPAC 	+5
// PORT: Fixed ROM slots 4919.
            if slot <> 4919 or instruction <> 20593 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20593, words[0], readEffective).
            }
            if extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 20593, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
