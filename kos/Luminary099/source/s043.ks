// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:20
//# actually created.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:21
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:22
//# Notations on the hardcopy document read, in part:
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:23
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:24
//#	Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:25
//#	16:27 JULY 14, 1969
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:26
//
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:27
//# Page 984
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:28
//# NAME - LSPOS  - LOCATE SUN AND MOON			DATE - 25 OCT 67
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:29
//# MOD NO.1
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:30
//# MOD BY NEVILLE					ASSEMBLY SUNDANCE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:31
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:32
//# FUNCTIONAL DESCRIPTION
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:33
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:34
//#        COMPUTES UNIT POSITION VECTOR OF THE SUN AND MOON IN THE BASIC REFERENCE SYSTEM. THE SUN VECTOR S IS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:35
//# LOCATED VIA TWO ANGLES. THE FIRST ANGLE(OBLIQUITY) IS THE ANGLE BETWEEN THE EARTH EQUATOR AND THE ECLIPTIC. THE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:36
//# SECOND ANGLE IS THE LONGITUDE OF THE SUN MEASURED IN THE ECLIPTIC.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:37
//# THE POSITION VECTOR OF THE SUN IS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:38
//#	 -
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:39
//#	 S=(COS(LOS), COS(OBL)*SIN(LOS), SIN(OBL)*SIN(LOS)), WHERE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:40
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:41
//#      LOS=LOS +LOS *T-(C *SIN(2PI*T)/365.24 +C *COS(2PI*T)/365.24)
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:42
//#	      0    R     0                     1
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:43
//#      LOS  (RAD) IS THE LONGITUDE OF THE SUN FOR MIGNIGHT JUNE 30TH OF THE PARTICULAR YEAR.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:44
//#         0
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:45
//#      LOS  (RAD/DAY) IS THE MEAN RATE FOR THE PARTICULAR YEAR.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:46
//#    	  R
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:47
//# LOS  AND LOS  ARE STORED AS LOSO AND LOSR IN RATESP.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:48
//#    0        R
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:49
//# COS(OBL) AND SIN(OBL) ARE STORED IN THE MATRIX KONMAT.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:50
//# T, TIME MEASURED IN DAYS(24 HOURS), IS STORED IN TIMEP.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:51
//# C  AND C  ARE FUDGE FACTORS TO MINIMIZE THE DEVIATION. THEY ARE STORED AS ONE CONSTANT(CMOD), SINCE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:52
//#  0      1                               2  2 1/2
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:53
//# C *SIN(X)+C *COS(X) CAN BE WRITTEN AS (C +C )   *SIN(X+PHI), WHERE PHI=ARCTAN(C /C ).
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:54
//#  0         1                            0  1                                   1  0
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:55
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:56
//# THE MOON IS LOCATED VIA FOUR ANGLES. THE FIRST IS THE OBLIQUITY. THE SECOND IS THE MEAN LONGITUDE OF THE MOON,
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:57
//# MEASURED IN THE ECLIPTIC FROM THE MEAN EQUINOX TO THE MEAN ASCENDING NODE OF THE LUNAR ORBIT, AND THEN ALONG THE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:58
//# ORBIT. THE THIRD ANGLE IS THE ANGLE BETWEEN THE ECLIPTIC AND THE LUNAR ORBIT. THE FOURTH ANGLE IS THE LONGITUDE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:59
//# OF THE NODE OF THE MOON, MEASURED IN THE LUNAR ORBIT. LET THESE ANGLES BE OBL,LOM,IM, AND LON RESPECTIVELY.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:60
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:61
//# THE SIMPLIFIED POSITION VECTOR OF THE MOON IS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:62
//#   -
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:63
//#   M=(COS(LOM), COS(OBL)*SIN(LOM)-SIN(OBL)*SIN(IM)*SIN(LOM-LON), SIN(OBL)*SIN(LOM)+COS(OBL)*SIN(IM)*SIN(LOM-LON))
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:64
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:65
//#   WHERE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:66
//#      LOM=LOM +LOM *T-(A *SIN(2PI*T/27.5545)+A *COS(2PI*T/27.5545)+B *SIN(2PI*T/32)+B *COS(2PI*T/32)), AND
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:67
//#	      0    R     0                     1                     0                1
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:68
//#      LON=LON +LON
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:69
//#	      0    R
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:70
//# A , A , B  AND B  ARE STORED AS AMOD AND BMOD (SEE DESCRIPTION OF CMOD, ABOVE).  COS(OBL), SIN(OBL)*SIN(IM),
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:71
//#  0   1   0      1
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:72
//# SIN(OBL), AND COS(OBL)*SIN(IM) ARE STORED IN KONMAT AS K1, K2, K3 AND K4, RESPECTIVELY. LOM , LOM , LON , LON
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:73
//# ARE STORED AS LOMO, LOMR, LONO, AND LONR IN RATESP.                                        0     R     0     R
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:74
//# THE THREE PHIS ARE STORED AS AARG, BARG, AND CARG(SUN).  ALL CONSTANTS ARE UPDATED BY YEAR.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:75
//#
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:76
//# CALLING SEQUENCE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:77
//# Page 985
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:78
//#   CALL LSPOS.  RETURN IS VIA QPRET.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:79
//# ALARMS OR ABORTS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:80
//#   NONE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:81
//# ERASABLE INITIALIZATION REQUIRED
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:82
//#   TEPHEM - TIME FROM MIGNIGHT 1 JULY PRECEDING THE LAUNCH TO THE TIME OF THE LAUNCH (WHEN THE AGC CLOCK WENT
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:83
//# TO ZERO). TEPHEM IS TP WITH UNITS OF CENTI-SECONDS.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:84
//#   TIME2 AND TIME1 ARE IN MPAC AND MPAC +1 WHEN PROGRAM IS CALLED.
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:85
//# OUTPUT
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:86
//#   UNIT POSITIONAL VECTOR OF SUN IN VSUN.   (SCALED B-1)
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:87
//#   UNIT POSITIONAL VECTOR OF MOON IN VMOON. (SCALED B-1)
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:88
//# SUBROUTINES USED
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:89
//#   NONE
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:90
//# DEBRIS
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:91
//#   CURRENT CORE SET,WORK AREA AND FREEFLAG
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:92
//		BANK	04
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:93
//		SETLOC	EPHEM
// LUNAR_AND_SOLAR_EPHEMERIDES_SUBROUTINES.agc:94
