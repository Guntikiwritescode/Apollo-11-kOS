//# INPUT - ERASABLE INITIALIZATION REQUIRED
// PORT: SOURCE CONIC_SUBROUTINES.agc:191
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:192
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:193
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:194
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:195
//#	R1VEC		* +29 FOR EARTH	*	DP INITIAL POSITION VECTOR IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:196
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:197
//#	R2VEC		* +29 FOR EARTH	*	DP TARGET OR TERMINAL POSITION VECTOR IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:198
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:199
//#	TDESIRED	* +28		*	DP DESIRED TRANSFER TIME IN CENTISECONDS
// PORT: SOURCE CONIC_SUBROUTINES.agc:200
//#	X1 (38D)	* NONE		*	INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
// PORT: SOURCE CONIC_SUBROUTINES.agc:201
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY
// PORT: SOURCE CONIC_SUBROUTINES.agc:202
//#	GEOMSGN		* NONE		*	SP +.5 IF DESIRED TRANSFER ANGLE IS LESS THAN 180 DEGREES, -.5 IF GREATER THAN 180 DEG.
// PORT: SOURCE CONIC_SUBROUTINES.agc:203
//#	GUESSW		* NONE		*	AN INTERPRETER SWITCH TO BE SET IF NO GUESS OF COGA IS AVAILABLE, CLEAR IF A GUESS OF
// PORT: SOURCE CONIC_SUBROUTINES.agc:204
//# Page 1164
// PORT: SOURCE CONIC_SUBROUTINES.agc:205
//#			*		*		COGA IS TO BE USED BY LAMBERT
// PORT: SOURCE CONIC_SUBROUTINES.agc:206
//#	COGA		* +5		*	DP GUESS OF COTANGENT OF FLIGHT PATH ANGLE (MEASURED FROM VERTICAL).  THIS WILL BE
// PORT: SOURCE CONIC_SUBROUTINES.agc:207
//#			*		*	IGNORED IF GUESSW IS SET.
// PORT: SOURCE CONIC_SUBROUTINES.agc:208
//#	NORMSW		* NONE		*	AN INTERPRETER SWITCH TO BE SET IF UN IS TO BE AN INPUT TO THE SUBROUTINE, CLEAR IF
// PORT: SOURCE CONIC_SUBROUTINES.agc:209
//#			*		*		LAMBERT IS TO COMPUTE ITS OWN NORMAL (UN).
// PORT: SOURCE CONIC_SUBROUTINES.agc:210
//#	UN		* +1		*	DP UNIT NORMAL TO THE DESIRED ORBIT PLANE IN THE DIRECTION OF THE RESULTING ANGULAR
// PORT: SOURCE CONIC_SUBROUTINES.agc:211
//#			*		*		MOMENTUM VECTOR.  THIS WILL BE IGNORED IF NORMSW IS CLEAR.
// PORT: SOURCE CONIC_SUBROUTINES.agc:212
//#	VTARGTAG	* NONE		*	A S.P. TAG TO BE SET TO ZERO IF LAMBERT IS TO COMPUTE THE VELOCITY AT R2VEC AS WELL AS
// PORT: SOURCE CONIC_SUBROUTINES.agc:213
//#			*		*		AT R1VEC.
// PORT: SOURCE CONIC_SUBROUTINES.agc:214
//#	ITERCTR		* NONE		*	A S.P. COUNTER WHICH SPECIFIES THE MAXIMUM NUMBER OF ITERATIONS ALLOWABLE.
// PORT: SOURCE CONIC_SUBROUTINES.agc:215
//#			*		*		(AN ITERATION MEANS A PASS THRU KEPLER EQN (DELTIME). AT LEAST ONE OF THESE MUST
// PORT: SOURCE CONIC_SUBROUTINES.agc:216
//#			*		*		ALWAYS OCCUR, EVEN IF COGA CORRESPONDING TO SOLUTION WERE INPUT AS A GUESS.)
// PORT: SOURCE CONIC_SUBROUTINES.agc:217
//#			*		*		TWENTY ITERATIONS ARE SUFFICIENT TO SOLVE ALL PROBLEMS INCLUDING THOSE WITHOUT GUESS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:218
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:219
//# SUBROUTINES CALLED -
// PORT: SOURCE CONIC_SUBROUTINES.agc:220
//#	GEOM, GETX, DELTIME, ITERATOR, LAMENTER (PART OF NEWSTATE)
// PORT: SOURCE CONIC_SUBROUTINES.agc:221
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:222
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:223
//#	L 	CALL			# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:224
//#	L+1		LAMBERT		# RETURNS WITH PL AT 0 AND WITH VVEC IN MPAC IF VTARGTAG WAS WAS NON-ZERO OR VTARGET
// PORT: SOURCE CONIC_SUBROUTINES.agc:225
//#					# IN MPAC IF VTARGTAG WAS ZERO
// PORT: SOURCE CONIC_SUBROUTINES.agc:226
//#	L+2	BON			# CONTINUE IF SOLNSW CLEAR SINCE SOLUTION IS ACCEPTABLE
// PORT: SOURCE CONIC_SUBROUTINES.agc:227
//#	L+3		SOLNSW
// PORT: SOURCE CONIC_SUBROUTINES.agc:228
//#	L+4		LAMABORT
// PORT: SOURCE CONIC_SUBROUTINES.agc:229
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:230
//#	IF A LAMBERT RESULT IS TO BE A FIRST GUESS FOR THE NEXT LAMBERT CALCULATION, COGA MUST BE PRESERVED AND
// PORT: SOURCE CONIC_SUBROUTINES.agc:231
//# GUESSW MUST BE CLEAR FOR EACH SUCCEEDING LAMBERT CALL.
// PORT: SOURCE CONIC_SUBROUTINES.agc:232
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:233
//# ABORT EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:234
//#	IF SOLNSW WAS SET UPON EXITING, EITHER LAMBERT WAS ASKED TO COMPUTE A TRANSFER TOO NEAR 0 OR 360 DEG, OR T
// PORT: SOURCE CONIC_SUBROUTINES.agc:235
//# WAS TOO SMALL TO PRODUCE A REALISTIC TRANSFER BETWEEN R1VEC AND R2VEC.  IN EITHER CASE THE FIX MUST BE MADE
// PORT: SOURCE CONIC_SUBROUTINES.agc:236
//# ACCORDING TO THE NEEDS OF THE PARTICULAR USER.  THE ABORT EXIT MODE MAY BE CODED AS ...
// PORT: SOURCE CONIC_SUBROUTINES.agc:237
//# LAMBABORT	DLOAD	ABS		# A MEASURE OF THE PROXIMITY TO 0 OR
// PORT: SOURCE CONIC_SUBROUTINES.agc:238
//#			1-CSTH		# 360 DEGREES.
// PORT: SOURCE CONIC_SUBROUTINES.agc:239
//#		DSU	BMN
// PORT: SOURCE CONIC_SUBROUTINES.agc:240
//#			ONEBIT
// PORT: SOURCE CONIC_SUBROUTINES.agc:241
//#			CHANGER2	# CHANGE R2VEC DIRECTION SLIGHTLY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:242
//#		DLOAD	DAD
// PORT: SOURCE CONIC_SUBROUTINES.agc:243
//#			TDESIRED
// PORT: SOURCE CONIC_SUBROUTINES.agc:244
//#			SOMETIME
// PORT: SOURCE CONIC_SUBROUTINES.agc:245
//#		STCALL	TDESIRED	# INCRESE TDESIRED
// PORT: SOURCE CONIC_SUBROUTINES.agc:246
//#			LAMBERT
// PORT: SOURCE CONIC_SUBROUTINES.agc:247
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:248
//# Page 1165
// PORT: SOURCE CONIC_SUBROUTINES.agc:249
//# OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:250
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:251
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:252
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:253
//#	VVEC		* +7 FOR EARTH	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND REQUIRED TO SATISFY THE BOUNDARY VALUE
// PORT: SOURCE CONIC_SUBROUTINES.agc:254
//#			* +5 FOR MOON	*		PROBLEM.
// PORT: SOURCE CONIC_SUBROUTINES.agc:255
//#	VTARGET		* +7 FOR EARTH	*	DP RESULTANT VELOCITY VECTOR AT R2VEC IN METERS/CENTISECOND.
// PORT: SOURCE CONIC_SUBROUTINES.agc:256
//#			* +5 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:257
//#	SOLNSW		* NONE		*	INTERPRETER SWITCH WHICH IS SET IF THE SUBROUTINE CANNOT SOLVE THE PROBLEM, CLEAR IF THE
// PORT: SOURCE CONIC_SUBROUTINES.agc:258
//#			* 		*		SOLUTION EXISTS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:259
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:260
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:261
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:262
//# DEBRIS -
// PORT: SOURCE CONIC_SUBROUTINES.agc:263
//#	PARAMETERS WHICH MAY BE OF USE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:264
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:265
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:266
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:267
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:268
//#	SNTH		* +1		*	DP SIN OF ANGLE BETWEEN R1VEC AND R2VEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:269
//#	CSTH		* +1		*	DP COSINE OF ANGLE
// PORT: SOURCE CONIC_SUBROUTINES.agc:270
//#	1-CSTH		* +2		*	DP 1-CSTH
// PORT: SOURCE CONIC_SUBROUTINES.agc:271
//#	COGA		* +5		*	DP COTAN OF INITIAL REQUIRED FLIGHT PATH ANGLE MEASURED FROM VERTICAL
// PORT: SOURCE CONIC_SUBROUTINES.agc:272
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO INITIAL RADIUS
// PORT: SOURCE CONIC_SUBROUTINES.agc:273
//#	R1A		* +6		*	DP RATIO OF INITIAL RADIUS TO SEMI-MAJOR AXIS
// PORT: SOURCE CONIC_SUBROUTINES.agc:274
//#	R1 (32D)	* +29 FOR EARTH	*	DP INITIAL RADIUS IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:275
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:276
//#	UR1		* +1		*	DP UNIT VECTOR OF R1VEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:277
//#	U2		* +1		*	DP UNIT VECTOR OF R2VEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:278
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:279
//#	PARAMETERS OF NO USE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:280
//#		DP PARAMETERS - EPSILONL, CSTH-RHO, TPREV, TERRLAMB, R2, RTNLAMB (SP), PLUS PUSHLIST REGISTER 0 THROUGH 41D
// PORT: SOURCE CONIC_SUBROUTINES.agc:281
//#		ADDITIONAL INTERPRETIVE SWITCHES USED - INFINFLG, 360SW, SLOPESW, ORDERSW
// PORT: SOURCE CONIC_SUBROUTINES.agc:282
//
// PORT: SOURCE CONIC_SUBROUTINES.agc:283
//# Page 1166
// PORT: SOURCE CONIC_SUBROUTINES.agc:284
//# PROGRAM DESCRIPTION - TIME-THETA SUBROUTINE			DATE - 1 SEPTEMBER 1967
// PORT: SOURCE CONIC_SUBROUTINES.agc:285
//# MOD NO. - 0							LOG SECTION - CONIC SUBROUTINES
// PORT: SOURCE CONIC_SUBROUTINES.agc:286
//# MOD BY KRAUSE							ASSEMBLY - COLOSSUS REVISION 88
// PORT: SOURCE CONIC_SUBROUTINES.agc:287
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:288
//# FUNCTIONAL DESCRIPTION -
// PORT: SOURCE CONIC_SUBROUTINES.agc:289
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE
// PORT: SOURCE CONIC_SUBROUTINES.agc:290
//# STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
// PORT: SOURCE CONIC_SUBROUTINES.agc:291
//# PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
// PORT: SOURCE CONIC_SUBROUTINES.agc:292
//# CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF TEH SUBROUTINE CAN BE
// PORT: SOURCE CONIC_SUBROUTINES.agc:293
//# EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WTIHOUT INTRODUCING ANY CODING CHANGES,
// PORT: SOURCE CONIC_SUBROUTINES.agc:294
//# ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:295
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:296
//# THE RESTRICTIONS ARE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:297
//#	1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
// PORT: SOURCE CONIC_SUBROUTINES.agc:298
//#	   AND LESS THAN 178 DEGREES 12.5 MINUTES.
// PORT: SOURCE CONIC_SUBROUTINES.agc:299
//#	2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
// PORT: SOURCE CONIC_SUBROUTINES.agc:300
//#	   ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:301
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:302
//#	THE AGC COMPUTATION TIME IS APPROXIMATELY .292 SECONDS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:303
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:304
//# REFERENCES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:305
//#	R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
// PORT: SOURCE CONIC_SUBROUTINES.agc:306
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:307
//# INPUT - ERASABLE INITIALIZATION REQUIRED
// PORT: SOURCE CONIC_SUBROUTINES.agc:308
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:309
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:310
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:311
//#	RVEC		* +29 FOR EARTH	*	DP INITIAL POSITION VECTOR IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:312
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:313
//#	VVEC		* +7 FOR EARTH	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// PORT: SOURCE CONIC_SUBROUTINES.agc:314
//#			* +5 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:315
//#	SNTH		* +1		*	DP SINE OF TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE STATE IS TO BE UPDATED
// PORT: SOURCE CONIC_SUBROUTINES.agc:316
//#	CSTH		* +1		*	DP COSINE OF THE ANGLE
// PORT: SOURCE CONIC_SUBROUTINES.agc:317
//#	RVSW		* NONE		*	AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
// PORT: SOURCE CONIC_SUBROUTINES.agc:318
//#			*		*		IS TO BE COMPUTED ALSO.
// PORT: SOURCE CONIC_SUBROUTINES.agc:319
//#	X1 (38D)	* NONE		*	INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
// PORT: SOURCE CONIC_SUBROUTINES.agc:320
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:321
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:322
//# SUBROUTINES CALLED -
// PORT: SOURCE CONIC_SUBROUTINES.agc:323
//# Page 1167
// PORT: SOURCE CONIC_SUBROUTINES.agc:324
//#	PARAM, GEOM, GETX, DELTIME, NEWSTATE
// PORT: SOURCE CONIC_SUBROUTINES.agc:325
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:326
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:327
//#	IF ONLY TIME IS DESIRED AS OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:328
//#	L	SET	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:329
//#	L+1		RVSW
// PORT: SOURCE CONIC_SUBROUTINES.agc:330
//#	L+2		TIMETHET	# RETURN WITH PL AT 0 AND T IN MPAC
// PORT: SOURCE CONIC_SUBROUTINES.agc:331
//#	L+3	...			# CONTINUE
// PORT: SOURCE CONIC_SUBROUTINES.agc:332
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:333
//#	IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
// PORT: SOURCE CONIC_SUBROUTINES.agc:334
//#	L	CLEAR	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:335
//#	L+1		RVSW
// PORT: SOURCE CONIC_SUBROUTINES.agc:336
//#	L+2		TIMETHET	# RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
// PORT: SOURCE CONIC_SUBROUTINES.agc:337
//#					# THE INITIAL VELOCITY VECTOR IN MPAC.
// PORT: SOURCE CONIC_SUBROUTINES.agc:338
//#	L+3	STOVL	NEWVVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:339
//#	L+4	STADR
// PORT: SOURCE CONIC_SUBROUTINES.agc:340
//#	L+5	STORE	NEWRVEC		# NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:341
//#	L+6	...			# CONTINUE.
// PORT: SOURCE CONIC_SUBROUTINES.agc:342
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:343
//# ABORT EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:344
//#	IF COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-THETA, TIME-THETA WILL TRANSFER TO POODOO WITH
// PORT: SOURCE CONIC_SUBROUTINES.agc:345
//#	AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM.  (PCR 692 AND 721).
// PORT: SOURCE CONIC_SUBROUTINES.agc:346
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:347
//# OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:348
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:349
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:350
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:351
//#	T (30D)		* +28		*	DP TRANSFER TIME IN CENTISECONDS
// PORT: SOURCE CONIC_SUBROUTINES.agc:352
//#	INFINFLG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF THE TRANSFER ANGLE REQUIRES CLOSURE THROUGH
// PORT: SOURCE CONIC_SUBROUTINES.agc:353
//#			*		*		INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
// PORT: SOURCE CONIC_SUBROUTINES.agc:354
//#	COGAFLAG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
// PORT: SOURCE CONIC_SUBROUTINES.agc:355
//#			* 		*		CLEAR IF NOT.
// PORT: SOURCE CONIC_SUBROUTINES.agc:356
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:357
//#	IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:358
//#	MPAC - 		* +7 FOR EARTH	*	DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
// PORT: SOURCE CONIC_SUBROUTINES.agc:359
//#	 MPAC +5	* +5 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:360
//#	0D - 5D		* +29 FOR EARTH	*	DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
// PORT: SOURCE CONIC_SUBROUTINES.agc:361
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:362
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:363
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:364
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:365
//# Page 1168
// PORT: SOURCE CONIC_SUBROUTINES.agc:366
//# DEBRIS -
// PORT: SOURCE CONIC_SUBROUTINES.agc:367
//#	PARAMETERS WHICH MAY BE OF USE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:368
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:369
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:370
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:371
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:372
//#	R1 (32D)	* +29 FOR EARTH	*	DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:373
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:374
//#	R1A		* +6		*	DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
// PORT: SOURCE CONIC_SUBROUTINES.agc:375
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO R1
// PORT: SOURCE CONIC_SUBROUTINES.agc:376
//#	COGA		* +5		*	DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:377
//#	UR1		* +1		*	DP UNIT VECTOR OF RVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:378
//#	U2		* +1		*	DP UNIT VECTOR OF VVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:379
//#	UN		* +1		*	DP UNIT VECTOR OF UR1*U2
// PORT: SOURCE CONIC_SUBROUTINES.agc:380
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:381
//#	PARAMETERS OF NO USE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:382
//#	SP PARAMETERS -- RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
// PORT: SOURCE CONIC_SUBROUTINES.agc:383
//#	ADDITIONAL INTERPRETIVE SWITCHES USED -- NORMSW, 360SW
// PORT: SOURCE CONIC_SUBROUTINES.agc:384
//
// PORT: SOURCE CONIC_SUBROUTINES.agc:385
//# Page 1169
// PORT: SOURCE CONIC_SUBROUTINES.agc:386
//# PROGRAM DESCRIPTION - TIME-RADIUS SUBROUTINE		DATE - 11 OCTOBER 1967
// PORT: SOURCE CONIC_SUBROUTINES.agc:387
//# MOD NO. -1						LOG SECTION - CONIC SUBROUTINES
// PORT: SOURCE CONIC_SUBROUTINES.agc:388
//# MOD BY KRAUSE						ASSEMBLY - COLOSSUS REVISION 88
// PORT: SOURCE CONIC_SUBROUTINES.agc:389
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:390
//# FUNCTIONAL DESCRIPTION -
// PORT: SOURCE CONIC_SUBROUTINES.agc:391
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:392
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED RADIUS TO WHICH THE
// PORT: SOURCE CONIC_SUBROUTINES.agc:393
//#	STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
// PORT: SOURCE CONIC_SUBROUTINES.agc:394
//#	PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
// PORT: SOURCE CONIC_SUBROUTINES.agc:395
//#	CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN BE
// PORT: SOURCE CONIC_SUBROUTINES.agc:396
//#	EXTENDED USING OTHER PRIMARY BODIES BY SIMMPE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
// PORT: SOURCE CONIC_SUBROUTINES.agc:397
//#	ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:398
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:399
//#	IF THE DESIRED RADIUS IS BEYOND THE RADIUS OF APOCENTER OF THE CONIC OR BELOW THE RADIUS OF PERICENTER,
// PORT: SOURCE CONIC_SUBROUTINES.agc:400
//#	APSESW WILL BE SET AND THE SUBROUTINE WILL RETURN THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:401
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:402
//# THE RESTRICTIONS ARE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:403
//#	1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
// PORT: SOURCE CONIC_SUBROUTINES.agc:404
//#	   AND LESS THAN 178 DEGREES 12.5 MINUTES.
// PORT: SOURCE CONIC_SUBROUTINES.agc:405
//#	2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
// PORT: SOURCE CONIC_SUBROUTINES.agc:406
//#	   ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:407
//#	3. AN ACCURACY DEGRADATION OCCURS AS THE SENSITIVITIES OF TIME AND UPDATED STATE VECTOR TO CHANGES IN
// PORT: SOURCE CONIC_SUBROUTINES.agc:408
//#	   RDESIRED INCREASE.  THIS WILL OCCUR NEAR EITHER APSIS OF THE CONIC AND WHEN THE CONIC IS NEARLY CIRCULAR.  IN
// PORT: SOURCE CONIC_SUBROUTINES.agc:409
//#	   PARTICULAR, IF THE CONIC IS AN EXACT CIRCLE, THE PROBLEM IS UNDEFINED AND THE SUBROUTINE WILL ABORT.
// PORT: SOURCE CONIC_SUBROUTINES.agc:410
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:411
//#	THE AGC COMPUTATION TIME IS APPROXIMATELY .363 SECONDS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:412
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:413
//# REFERENCES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:414
//#	R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
// PORT: SOURCE CONIC_SUBROUTINES.agc:415
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:416
//# INPUT - ERASABLE INITIALIZATION REQUIRED.
// PORT: SOURCE CONIC_SUBROUTINES.agc:417
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:418
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:419
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:420
//#	RVEC		* +29 FOR EARTH	*	DP INITIAL POSITION VECTOR IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:421
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:422
//#	VVEC		* +7 FOR EARTH	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// PORT: SOURCE CONIC_SUBROUTINES.agc:423
//#			* +5 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:424
//#	RDESIRED	* +29 FOR EARTH	*	DP TERMINAL RADIAL DISTANCE ON CONIC TRAJECTORY FOR WHICH TRANSFER TIME IS TO BE
// PORT: SOURCE CONIC_SUBROUTINES.agc:425
//#			* +27 FOR MOON	*		COMPUTED
// PORT: SOURCE CONIC_SUBROUTINES.agc:426
//#	SGNRDOT		* NONE		*	SP TAG SET TO +.5 OR -.5 ACCORDING TO WHETHER THE RADIAL VELOCITY AT RDESIRED IS TO BE
// PORT: SOURCE CONIC_SUBROUTINES.agc:427
//#			*		*		POSITIVE OR NEGATIVE, RESPECTIVELY.   THIS TAG REDUCES THE DOUBLE-VALUED PROBLEM TO A
// PORT: SOURCE CONIC_SUBROUTINES.agc:428
//# Page 1170
// PORT: SOURCE CONIC_SUBROUTINES.agc:429
//#			*		*		SINGLE-VALUED PROBLEM.
// PORT: SOURCE CONIC_SUBROUTINES.agc:430
//#	X1 (38D)	* NONE		*	INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
// PORT: SOURCE CONIC_SUBROUTINES.agc:431
//#			* 		*		RESPECTIVELY, IS THE CENTRAL BODY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:432
//#	RVSW		* NONE		*	AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
// PORT: SOURCE CONIC_SUBROUTINES.agc:433
//#			*		*		IS TO BE COMPUTED ALSO.
// PORT: SOURCE CONIC_SUBROUTINES.agc:434
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:435
//# SUBROUTINES CALLED -
// PORT: SOURCE CONIC_SUBROUTINES.agc:436
//#	PARAM, GEOM, GETX, DELTIME, NEWSTATE
// PORT: SOURCE CONIC_SUBROUTINES.agc:437
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:438
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:439
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:440
//#	IF ONLY TIME IS DESIRED AS OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:441
//#	L	SET	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:442
//#	L+1		RVSW
// PORT: SOURCE CONIC_SUBROUTINES.agc:443
//#	L+2		TIMERAD		# RETURN WITH PL AT 0 AND T IN MPAC
// PORT: SOURCE CONIC_SUBROUTINES.agc:444
//#	L+3	...			# CONTINUE
// PORT: SOURCE CONIC_SUBROUTINES.agc:445
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:446
//#	IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
// PORT: SOURCE CONIC_SUBROUTINES.agc:447
//#	L	CLEAR	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:448
//#	L+1		RVSW
// PORT: SOURCE CONIC_SUBROUTINES.agc:449
//#	L+2		TIMERAD		# RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
// PORT: SOURCE CONIC_SUBROUTINES.agc:450
//#					# THE INITIAL VELOCITY VECTOR IN MPAC.
// PORT: SOURCE CONIC_SUBROUTINES.agc:451
//#	L+3	STOVL	NEWVVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:452
//#	L+4	STADR
// PORT: SOURCE CONIC_SUBROUTINES.agc:453
//#	L+5	STORE	NEWRVEC		# NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:454
//#	...				# CONTINUE
// PORT: SOURCE CONIC_SUBROUTINES.agc:455
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:456
//# ABORT EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:457
//#	IF SOLNSW AND/OR COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-RADIUS, TIME-RADIUS WILL TRANSFER
// PORT: SOURCE CONIC_SUBROUTINES.agc:458
//#	TO POODOO WITH AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM. (PCR 692 & 721)
// PORT: SOURCE CONIC_SUBROUTINES.agc:459
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:460
//# OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:461
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:462
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:463
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:464
//#	T (30D)		* +28		*	DP TRANSFER TIME IN CENTISECONDS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:465
//#	INFINFLG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED AND SGNRDOT REQUIRE CLOSURE THROUGH
// PORT: SOURCE CONIC_SUBROUTINES.agc:466
//#			*		*		INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
// PORT: SOURCE CONIC_SUBROUTINES.agc:467
//#	COGAFLAG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
// PORT: SOURCE CONIC_SUBROUTINES.agc:468
//#			*		*		CLEAR IF NOT.
// PORT: SOURCE CONIC_SUBROUTINES.agc:469
//#	APSESW		* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED WAS GREATER THAN RADIUS OF APOCENTER OR
// PORT: SOURCE CONIC_SUBROUTINES.agc:470
//# Page 1171
// PORT: SOURCE CONIC_SUBROUTINES.agc:471
//#			*		*		LESS THAN RADIUS OF PERICENTER.  THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY,
// PORT: SOURCE CONIC_SUBROUTINES.agc:472
//#			*		*		WILL THEN BE RETURNED.  THE SWITCH IS CLEAR IF RDESIRED WAS BETWEEN PERICENTER AND
// PORT: SOURCE CONIC_SUBROUTINES.agc:473
//#			*		*		APOCENTER.
// PORT: SOURCE CONIC_SUBROUTINES.agc:474
//#	SOLNSW		* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF THE CONIC IS SO CLOSE TO A CIRCLE THAT THE TERMIN
// PORT: SOURCE CONIC_SUBROUTINES.agc:475
//#			*		*		POINT IS AMBIGUOUS, VIOLATING RESTRICTION 3.  IF ECCENTRICITY IS GREATER THAN 2-TO-THE-
// PORT: SOURCE CONIC_SUBROUTINES.agc:476
//#			*		*		MINUS-18, THE SWITCH IS CLEAR.
// PORT: SOURCE CONIC_SUBROUTINES.agc:477
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:478
//#	IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:479
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:480
//#	MPAC - 		* +7 FOR EARTH	*	DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
// PORT: SOURCE CONIC_SUBROUTINES.agc:481
//#	 MPAC +5	* +5 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:482
//#	0D - 5D		* +29 FOR EARTH	*	DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
// PORT: SOURCE CONIC_SUBROUTINES.agc:483
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:484
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:485
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:486
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:487
//# DEBRIS -
// PORT: SOURCE CONIC_SUBROUTINES.agc:488
//#	PARAMETERS WHICH MAY BE OF USE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:489
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:490
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:491
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:492
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:493
//#	R1 (32D)	* +29 FOR EARTH	*	DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:494
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:495
//#	R1A		* +6		*	DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
// PORT: SOURCE CONIC_SUBROUTINES.agc:496
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO R1
// PORT: SOURCE CONIC_SUBROUTINES.agc:497
//#	COGA		* +5		*	DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:498
//#	UR1		* +1		*	DP UNIT VECTOR OF RVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:499
//#	U2		* +1		*	DP UNIT VECTOR OF VVEC
// PORT: SOURCE CONIC_SUBROUTINES.agc:500
//#	UN		* +1		*	DP UNIT VECTOR OF UR1*U2
// PORT: SOURCE CONIC_SUBROUTINES.agc:501
//#	CSTH		* +1		*	DP COSINE OF TRUE ANOMALY DIFFERENCE BETWEEN RVEC AND RDESIRED.
// PORT: SOURCE CONIC_SUBROUTINES.agc:502
//#	SNTH		* +1		*	DP SINE OF TRUE ANOMALY DIFFERENCE.
// PORT: SOURCE CONIC_SUBROUTINES.agc:503
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:504
//# 	PARAMETERS OF NO USE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:505
//#		SP PARAMETERS -- RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
// PORT: SOURCE CONIC_SUBROUTINES.agc:506
//#		ADDITIONAL INTERPRETIVE SWITCHES USED -- NORMSW, 360SW
// PORT: SOURCE CONIC_SUBROUTINES.agc:507
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:508
//
// PORT: SOURCE CONIC_SUBROUTINES.agc:509
//# Page 1172
// PORT: SOURCE CONIC_SUBROUTINES.agc:510
//# PROGRAM DESCRIPTION - APSIDES SUBROUTINE		DATE - 1 SEPTEMBER 1967
// PORT: SOURCE CONIC_SUBROUTINES.agc:511
//# MOD NO. - 0						LOG SECTION - CONIC SUBROUTINES
// PORT: SOURCE CONIC_SUBROUTINES.agc:512
//# MOD BY KRAUSE						ASSEMBLY - COLOSSUS REVISION 88
// PORT: SOURCE CONIC_SUBROUTINES.agc:513
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:514
//# FUNCTIONAL DESCRIPTION -
// PORT: SOURCE CONIC_SUBROUTINES.agc:515
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:516
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR CALCULATES THE RADIUS OF PERICENTER AND OF APOCENTER AND THE
// PORT: SOURCE CONIC_SUBROUTINES.agc:517
//#	ECCENTRICITY OF THE RESULTING CONIC TRAJECTORY, WHICH MAY BE A STRAIGHT LINE,
// PORT: SOURCE CONIC_SUBROUTINES.agc:518
//#	CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO THE EARTH OR THE MOON.  THE USE OF THE SUBROUTINE CAN
// PORT: SOURCE CONIC_SUBROUTINES.agc:519
//#	BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
// PORT: SOURCE CONIC_SUBROUTINES.agc:520
//#	ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:521
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:522
//# THE RESTRICTIONS ARE -
// PORT: SOURCE CONIC_SUBROUTINES.agc:523
//#	1. IF APOCENTER IS BEYOND THE SCALING OF POSITION, THE SCALE FACTOR LIMIT (536,870,910 METERS WITH RESPECT
// PORT: SOURCE CONIC_SUBROUTINES.agc:524
//#	   TO THE EARTH OR 134,217,727.5 METERS WITH RESPECT TO THE MOON) WILL BE RETURNED.
// PORT: SOURCE CONIC_SUBROUTINES.agc:525
//#	2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
// PORT: SOURCE CONIC_SUBROUTINES.agc:526
//#	   ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:527
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:528
//#	THE AGC COMPUTATION TIME IS APPROXIMATELY .103 SECONDS.
// PORT: SOURCE CONIC_SUBROUTINES.agc:529
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:530
//# REFERENCES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:531
//#	MISSION PROGRAMMING DEFINITION MEMO NO. 10, LUNAR LANDING MISSION GSOP-SECTION 5.5
// PORT: SOURCE CONIC_SUBROUTINES.agc:532
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:533
//# INPUT - ERASABLE INITIALIZATION REQUIRED
// PORT: SOURCE CONIC_SUBROUTINES.agc:534
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:535
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:536
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:537
//#	RVEC		* +29 FOR EARTH	*	DP INITIAL POSITION VECTOR IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:538
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:539
//#	VVEC		* +7 FOR EARTH	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// PORT: SOURCE CONIC_SUBROUTINES.agc:540
//#			* +5 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:541
//#	X1 (38D)	* NONE		*	INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER THE EARTH OR MOON,
// PORT: SOURCE CONIC_SUBROUTINES.agc:542
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:543
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:544
//# SUBROUTINES CALLED -
// PORT: SOURCE CONIC_SUBROUTINES.agc:545
//#	PARAM, GEOM
// PORT: SOURCE CONIC_SUBROUTINES.agc:546
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:547
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// PORT: SOURCE CONIC_SUBROUTINES.agc:548
//# Page 1173
// PORT: SOURCE CONIC_SUBROUTINES.agc:549
//#	IF ONLY TIME IS DESIRED AS OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:550
//#	L	CALL			# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:551
//#	L+1		APSIDES		# RETURNS WITH PL AT 0, RADIUS OF APOCENTER IN MPAC AND RADIUS OF PERICENTER IN 0D
// PORT: SOURCE CONIC_SUBROUTINES.agc:552
//#	L+2	STODL	APOAPSE
// PORT: SOURCE CONIC_SUBROUTINES.agc:553
//#	L+3		0D
// PORT: SOURCE CONIC_SUBROUTINES.agc:554
//#	L+4	STORE	PERIAPSE	# APOAPSE AND PERIAPSE ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS
// PORT: SOURCE CONIC_SUBROUTINES.agc:555
//#	L+5	...			# CONTINUE
// PORT: SOURCE CONIC_SUBROUTINES.agc:556
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:557
//# OUTPUT -
// PORT: SOURCE CONIC_SUBROUTINES.agc:558
//#			* SCALE FACTOR	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:559
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// PORT: SOURCE CONIC_SUBROUTINES.agc:560
//#	--------	*--------------	*	-----------------------
// PORT: SOURCE CONIC_SUBROUTINES.agc:561
//#	MPAC		* +29 FOR EARTH	*	DP RADIUS OF APOCENTER IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:562
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:563
//#	0D-1D		* +29 FOR EARTH	*	DP RADIUS OF PERICENTER IN METERS
// PORT: SOURCE CONIC_SUBROUTINES.agc:564
//#			* +27 FOR MOON	*
// PORT: SOURCE CONIC_SUBROUTINES.agc:565
//#	ECC		* +3		*	DP ECCENTRICITY OF CONIC TRAJECTORY.
// PORT: SOURCE CONIC_SUBROUTINES.agc:566
//#
// PORT: SOURCE CONIC_SUBROUTINES.agc:567
