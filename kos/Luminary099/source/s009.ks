//# www.ibiblio.org/apollo.  If for some reason you find that the images are
// CONIC_SUBROUTINES.agc:21
//# illegible, contact me at info@sandroid.org about getting access to the
// CONIC_SUBROUTINES.agc:22
//# (much) higher-quality images which Fjeld Kerman actually created.
// CONIC_SUBROUTINES.agc:23
//#
// CONIC_SUBROUTINES.agc:24
//# Notations on the hardcopy document read, in part:
// CONIC_SUBROUTINES.agc:25
//#
// CONIC_SUBROUTINES.agc:26
//#    Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// CONIC_SUBROUTINES.agc:27
//#    16:27 JULY 14, 1969
// CONIC_SUBROUTINES.agc:28
//
// CONIC_SUBROUTINES.agc:29
//# Page 1159
// CONIC_SUBROUTINES.agc:30
//# PROGRAM DESCRIPTION -- ENTIRE CONIC SUBROUTINE LOG SECTION	DATE - 1 SEPTEMBER 1967
// CONIC_SUBROUTINES.agc:31
//# MOD NO. - 0							LOG SECTION - CONIC SUBROUTINES
// CONIC_SUBROUTINES.agc:32
//# MOD BY KRAUSE KERMAN							ASSEMBLY - COLOSSUS REVISION 88
// CONIC_SUBROUTINES.agc:33
//#
// CONIC_SUBROUTINES.agc:34
//# FUNCTIONAL DESCRIPTION -
// CONIC_SUBROUTINES.agc:35
//#	THE FOLLOWING SET OF SUBROUTINES SOLVE VARIOUS PROBLEMS INVOLVING THE TRAJECTORY PRODUCED BY A CENTRAL
// CONIC_SUBROUTINES.agc:36
//# INVERSE-SQUARE FORCE ACTING ON A POINT MASS, AS OUTLINED IN THE CMC AND LGC MUN LANDING MISSION GSOP, SECTION
// CONIC_SUBROUTINES.agc:37
//# 5.5.1.2.  A GENERAL USAGE POINT-OF-VIEW WAS TAKEN IN FORMULATING, MECHANIZING, AND SCALING THE SUBROUTINES,
// CONIC_SUBROUTINES.agc:38
//# RATHER THAN OPTIMIZING EACH FOR A PARTICULAR USE.  THEREFORE, MULTIPLE USAGE CAN BE MADE OF THE SUBROUTINES
// CONIC_SUBROUTINES.agc:39
//# INVOLVING ANY REALISTIC SET OF CONSTRAINTS.  IT SHOULD BE NOTED THAT ONLY ONE SET OF CODING IS USED, WHETHER THE
// CONIC_SUBROUTINES.agc:40
//# KERBIN, MUN, OR ANY OTHER CELESTIAL BODY IS SPECIFIED AS THE CENTRAL BODY OF THE PROBLEM, PROVIDED ONE OBSERVES
// CONIC_SUBROUTINES.agc:41
//# THE INHERENT SCALE CHANGE REQUIRED IN POSITION, VELOCITY, MU, AND TIME, AS OUTLINES IN MISSION PROGRAMMING
// CONIC_SUBROUTINES.agc:42
//# DEFINITION MEMO NO. 10.  THIS CAN BE ACCOMPLISHED BY SIMPLY ADDING TO THE MUTABLE AND INITIALIZING THE SUBROUTINES
// CONIC_SUBROUTINES.agc:43
//# APPROPRIATELY.
// CONIC_SUBROUTINES.agc:44
//#
// CONIC_SUBROUTINES.agc:45
//#	DUE TO THE UNIFORMITY OF THE EQUATIONS INVOLVED, CODING WAS MINIMIZED BY TREATING INDIVIDUAL EQUATIONS AND
// CONIC_SUBROUTINES.agc:46
//# BLOCKS OF EQUATIONS AS SUBROUTINES OF LOWER RANK WHENEVER POSSIBLE.  AS A RESULT, THREE BY-PRODUCTS SUBROUTINES,
// CONIC_SUBROUTINES.agc:47
//# DIRECTLY USABLE AS INDEPENDENT SUBROUTINES, WERE GENERATED.
// CONIC_SUBROUTINES.agc:48
//#
// CONIC_SUBROUTINES.agc:49
//# RESTRICTIONS -
// CONIC_SUBROUTINES.agc:50
//#	THE ONLY LIMITATION IN THE SCOPE OF THE PROBLEM WHICH CAN BE SOLVED BY A PARTICULAR SUBROUTINE IS THE SCALING
// CONIC_SUBROUTINES.agc:51
//# LIMIT OF EACH PARAMETER AS SPECIFIED IN THE GSOP.  THESE SCALING LIMITS WERE CHOSEN SO THAT ALL FEASIBLE TRAJECTORIES
// CONIC_SUBROUTINES.agc:52
//# COULD BE HANDLED.
// CONIC_SUBROUTINES.agc:53
//#
// CONIC_SUBROUTINES.agc:54
//#	SINCE THE SUBROUTINES (EXCEPT KEPLER) USE COMMON SUBROUTINES OF LOWER RANK WHICH USE ERASABLE OTHER THAN
// CONIC_SUBROUTINES.agc:55
//# THE PUSHLIST (DUE TO ITS LIMITED SIZE) AND COMMON INTERPRETIVE SWITCHES, THE CONIC SUBROUTINES CANNOT BE ALLOWED
// CONIC_SUBROUTINES.agc:56
//# TO INTERRUPT EACH OTHER.  IT IS UP TO THE USER TO GUARANTEE THIS CONDITION.
// CONIC_SUBROUTINES.agc:57
//
// CONIC_SUBROUTINES.agc:58
//# Page 1160
// CONIC_SUBROUTINES.agc:59
//# PROGRAM DESCRIPTION - KEPLER SUBROUTINE			DATE - 11 OCTOBER 1967
// CONIC_SUBROUTINES.agc:60
//# MOD NO. -1							LOG SECTION - CONIC SUBROUTINES
// CONIC_SUBROUTINES.agc:61
//# MOD BY KRAUSE KERMAN							ASSEMBLY - COLOSSUS 103 AND SUNDANCE 222
// CONIC_SUBROUTINES.agc:62
//# MOD NO. - 2 (AUGUST 1968) BY ROBERTSON KERMAN: TO PERMIT BACKDATING BY MORE THAN ONE ORBITAL PERIOD.
// CONIC_SUBROUTINES.agc:63
//# MOD NO. - 3 (DEC 1968) BY ROBERTSON KERMAN:  SUPPRESSION OF X-MODULO-ING
// CONIC_SUBROUTINES.agc:64
//# MOD NO. - 4 (JAN 1969) BY ROBERTSON KERMAN:  CLEAR OVFIND AT KEPLER ENTRY
// CONIC_SUBROUTINES.agc:65
//#
// CONIC_SUBROUTINES.agc:66
//# FUNCTIONAL DESCRIPTION -
// CONIC_SUBROUTINES.agc:67
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND THE DESIRED TRANSFER TIME THROUGH WHICH THE STATE IS TO
// CONIC_SUBROUTINES.agc:68
//# BE UPDATED ALONG A CONIC TRAJECTORY, COMPUTES THE NEW, UPDATED STATE VECTOR.  THE TRAJECTORY MAY BE ANY CONIC
// CONIC_SUBROUTINES.agc:69
//# SECTION - CIRCULAR, ELLIPTIC, PARABOLIC, HYPERPOLIC, OR RECTILINEAR WITH RESPECT TO KERBIN OR THE MUN.  THE
// CONIC_SUBROUTINES.agc:70
//# USE OF THE SUBROUTINE CAN BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT
// CONIC_SUBROUTINES.agc:71
//# INTRODUCING ANY CODING CHANGES, ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.  AN ITERATION
// CONIC_SUBROUTINES.agc:72
//# TECHNIQUE IS UTILIZED IN THE COMPUTATION.
// CONIC_SUBROUTINES.agc:73
//#
// CONIC_SUBROUTINES.agc:74
//#	IF A NEGATIVE TIME-OF-FLIGHT IS INPUT, THE PROGRAM WILL SOLVE FOR THE STATE WHICH WOULD BE PRODUCED BY
// CONIC_SUBROUTINES.agc:75
//# EXTRAPOLATING THE POSITION BACKWARD IN TIME.
// CONIC_SUBROUTINES.agc:76
//#
// CONIC_SUBROUTINES.agc:77
//#	IF THE ABSOLUTE VALUE OF THE DESIRED TRANSFER TIME EXCEEDS THE ORBITAL PERIOD, THE SUBROUTINE, THROUGH A
// CONIC_SUBROUTINES.agc:78
//#  MODULAR TECHNIQUE, WILL COMPUTE THE STATE CORRESPONDING TO THE DESIRED TIME (WHETHER POSITIVE OR NEGATIVE).
// CONIC_SUBROUTINES.agc:79
//#
// CONIC_SUBROUTINES.agc:80
//# THE RESTRICTIONS ARE -
// CONIC_SUBROUTINES.agc:81
//#	1. (PREVIOUS RESTRICTION ON THE NEGATIVE DESIRED TRANSFER TIME IS NOW DELETED.)
// CONIC_SUBROUTINES.agc:82
//#	2. THE PARAMETERS IN THE PROBLEM CANNOT EXCEED THEIR SCALING LIMITS AS SPECIFIED IN THE GSOP.  IF
// CONIC_SUBROUTINES.agc:83
//#	   ANY OF THESE LIMITS ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
// CONIC_SUBROUTINES.agc:84
//#
// CONIC_SUBROUTINES.agc:85
//# 	THE NUMBER OF ITERATIONS AND, THEREFORE, THE COMPUTATION SPEED IS DEPENDENT ON THE ACCURACY OF THE
// CONIC_SUBROUTINES.agc:86
//# GUESS, XKFPNEW.  THE AGC COMPUTATION TIME IS APPROXIMATELY .061 SECONDS FOR INITIALIZATION, .065 SECONDS FOR THE
// CONIC_SUBROUTINES.agc:87
//# FINAL COMPUTATIONS, PLUS .083 SECONDS FOR EACH ITERATION.
// CONIC_SUBROUTINES.agc:88
//#
// CONIC_SUBROUTINES.agc:89
//# REFERENCES -
// CONIC_SUBROUTINES.agc:90
//#	R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, MUN LANDING MISSION GSOP, SECTION 5.5, SGA
// CONIC_SUBROUTINES.agc:91
//#	MEMO 67-4.
// CONIC_SUBROUTINES.agc:92
//#
// CONIC_SUBROUTINES.agc:93
//# INPUT - ERASABLE INITIALIZATION REQUIRED
// CONIC_SUBROUTINES.agc:94
//#			* SCALE FACTOR 	*
// CONIC_SUBROUTINES.agc:95
//#	VARIABLE	*IN POWERS OF 2	* 		DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:96
//#	--------	*--------------	*		-----------------------
// CONIC_SUBROUTINES.agc:97
//#	RRECT		* +29 FOR KERBIN	*	DP INITIAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:98
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:99
//# Page 1161
// CONIC_SUBROUTINES.agc:100
//#	VRECT		* +7 FOR KERBIN	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// CONIC_SUBROUTINES.agc:101
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:102
//#	X1 (38D)	* NONE		*	INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER KERBIN OR MUN,
// CONIC_SUBROUTINES.agc:103
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY
// CONIC_SUBROUTINES.agc:104
//#	TAU		* +28		*	DESIRED TRANSFER TIME IN CENTISECONDS (DP)
// CONIC_SUBROUTINES.agc:105
//#			*		*		MAY BE POS OR NEG AND ABSOLUTE VALUE MAY BE GREATER OR LESS THAN ONE ORBITAL PERIOD.
// CONIC_SUBROUTINES.agc:106
//#	XKEPNEW		* +17 FOR KERBIN	*	DP GUESS OF ROOT X OF KEPLERS EQN IN SQRT(METERS). SIGN SHOULD AGREE WITH THAT OF TAU.
// CONIC_SUBROUTINES.agc:107
//#			* +16 FOR MUN	*		AND ABS VALUE SHOULD BE LESS THAN THAT CORRESPONDING TO A PERIOD, VIZ, 2PI SQRT(SEMI-
// CONIC_SUBROUTINES.agc:108
//#			*		*		MAJOR AXIS), FOR SPEED OF CONVERGENCE, BUT IF EITHER CONDITION FAILS, XKEPNEW IS RESET
// CONIC_SUBROUTINES.agc:109
//#			*		*		BY KEPLER TO A POOR BUT VALID GUESS.
// CONIC_SUBROUTINES.agc:110
//#	TC		* +28		*	DP PREV. VALUE OF TIME IN CENTISECS.  MUST BE LESS THAN ONE ORBITAL PERIOD.
// CONIC_SUBROUTINES.agc:111
//#	XPREV		* +17 FOR KERBIN	*	DP PREV. VALUE OF X IN SQRT(METERS).  MUST BE LESS THAN AN X CORRESPONDING TO ONE
// CONIC_SUBROUTINES.agc:112
//#			* +16 FOR MUN	*		ORBITAL PERIOD, VIZ, 2PI SQRT(SEMI-MAJOR AXIS)
// CONIC_SUBROUTINES.agc:113
//#
// CONIC_SUBROUTINES.agc:114
//# SUBROUTINES CALLED -
// CONIC_SUBROUTINES.agc:115
//#	DELTIME
// CONIC_SUBROUTINES.agc:116
//#
// CONIC_SUBROUTINES.agc:117
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// CONIC_SUBROUTINES.agc:118
//#	KEPRTN-2	GOTO			# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// CONIC_SUBROUTINES.agc:119
//#	KEPRTN-1		KEPLER		# RETURNS WITH XPREV IN MPAC. PL IS AT 0.
// CONIC_SUBROUTINES.agc:120
//#	KEPRTN		...			# CONTINUE
// CONIC_SUBROUTINES.agc:121
//#
// CONIC_SUBROUTINES.agc:122
//# KEPLER MUST NOT BE CALLED DIRECTLY SINCE AN INTERRUPTION OF IT WOULD DESTROY THE ERASABLES IT NEEDS TO COMPLETE
// CONIC_SUBROUTINES.agc:123
//# THE INTERRUPTED JOB.  THEREFORE THE USER MUST CALL CSMCONIC OR LEMCONIC WHICH GUARANTEES NO INTERRUPTS AND WHICH
// CONIC_SUBROUTINES.agc:124
//# ALSO CALLS KEPPREP TO COMPUTE A GUESS OF XKEPNEW.
// CONIC_SUBROUTINES.agc:125
//#
// CONIC_SUBROUTINES.agc:126
//# ABORT EXIT MODES -
// CONIC_SUBROUTINES.agc:127
//#	NONE
// CONIC_SUBROUTINES.agc:128
//#
// CONIC_SUBROUTINES.agc:129
//# OUTPUT -
// CONIC_SUBROUTINES.agc:130
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:131
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:132
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:133
//#	RCV		* +29 FOR KERBIN	*	DP TERMINAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:134
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:135
//#	VCV		* +7 FOR KERBIN	*	DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC
// CONIC_SUBROUTINES.agc:136
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:137
//#	TC		* +28		*	DP TRANSFER TIME IN CENTISECS TO WHICH KEPLER CONVERGED. ALWAYS LESS THAN ONE PERIOD.
// CONIC_SUBROUTINES.agc:138
//#	XPREV		* +17 FOR KERBIN	*	DP VALUE OF X IN SQRT(METERS) TO WHICH KEPLER CONVERGED. ALWAYS LESS THAN THE X
// CONIC_SUBROUTINES.agc:139
//#			* +16 FOR MUN	*		CORRESPONDING TO ONE PERIOD.
// CONIC_SUBROUTINES.agc:140
//# Page 1162
// CONIC_SUBROUTINES.agc:141
//# FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// CONIC_SUBROUTINES.agc:142
//#
// CONIC_SUBROUTINES.agc:143
//# DEBRIS -
// CONIC_SUBROUTINES.agc:144
//#	PARAMETERS WHICH MAY BE OF USE -
// CONIC_SUBROUTINES.agc:145
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:146
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:147
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:148
//#	URRECT		* +1		*	DP UNIT VECTOR OF INITIAL POSITION
// CONIC_SUBROUTINES.agc:149
//#	R1		* +29 FOR KERBIN	*	DP MAGNITUDE OF INITIAL POSITION IN METERS
// CONIC_SUBROUTINES.agc:150
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:151
//# 	ALPHA		* -22 FOR KERBIN	*	DP INVERSE OF SEMI-MAJOR AXIS IN 1/METERS
// CONIC_SUBROUTINES.agc:152
//#			* -20 FOR MUN	*
// CONIC_SUBROUTINES.agc:153
//#	TMODULO		* +28		*	DP INTEGRAL NUMBER OF PERIODS IN CENTISECS, WHICH WAS SUBTRACTED FROM TAU, TO PRODUCE A
// CONIC_SUBROUTINES.agc:154
//#			*		*	TAU. OF LESS THAN ONE PERIOD.
// CONIC_SUBROUTINES.agc:155
//#
// CONIC_SUBROUTINES.agc:156
//# PARAMETERS OF NO USE -
// CONIC_SUBROUTINES.agc:157
//#	DP PARAMETERS - EPSILONT, DELX, DELT, RCNORM, XMODULO, PLUS PUSHLIST REGISTERS 0 THROUGH 39D.
// CONIC_SUBROUTINES.agc:158
//
// CONIC_SUBROUTINES.agc:159
//# Page 1163
// CONIC_SUBROUTINES.agc:160
//
// CONIC_SUBROUTINES.agc:161
//# PROGRAM DESCRIPTION - LAMBERT SUBROUTINE			DATE - 1 SEPTEMBER 1967
// CONIC_SUBROUTINES.agc:162
//# MOD NO. - 0							LOG SECTION - CONIC SUBROUTINES
// CONIC_SUBROUTINES.agc:163
//# MOD BY KRAUSE KERMAN							ASSEMBLY - COLOSSUS REVISION 88
// CONIC_SUBROUTINES.agc:164
//#
// CONIC_SUBROUTINES.agc:165
//# FUNCTIONAL DESCRIPTION -
// CONIC_SUBROUTINES.agc:166
//#	THIS SUBROUTINE CALCULATES THE INITIAL VELOCITY REQUIRED TO TRANSFER A POINT-MASS ALONG A CONIC TRAJECTORY
// CONIC_SUBROUTINES.agc:167
//# FROM AN INITIAL POSITION TO A TERMINAL POSITION IN A PRESCRIBED TIME INTERVAL.  THE RESULTING TRAJECTORY MAY BE
// CONIC_SUBROUTINES.agc:168
//# A SECTION OF A CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO TEH KERBIN OR THE MUN.  THE USE OF THE
// CONIC_SUBROUTINES.agc:169
//# SUBROUTINE CAN BE EXTEDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY
// CONIC_SUBROUTINES.agc:170
//# CODING CHANGES, ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.  AN ITERATION TECHNIQUE IS
// CONIC_SUBROUTINES.agc:171
//# UTILIZED IN THE COMPUTATION.
// CONIC_SUBROUTINES.agc:172
//#
// CONIC_SUBROUTINES.agc:173
//# THE RESTRICTIONS ARE: -
// CONIC_SUBROUTINES.agc:174
//#	1. RECTILINEAR TRAJECTORIES CANNOT BE COMPUTED.
// CONIC_SUBROUTINES.agc:175
//#	2. AN ACCURACY DEGRADATION OCCURS AS THE COSINE OF THE TRUE ANOMALY DIFFERENCE APPROACHES +1.0.
// CONIC_SUBROUTINES.agc:176
//#	3. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
// CONIC_SUBROUTINES.agc:177
//#	   AND LESS THAN 178 DEGREES 12.5 MINUTES.
// CONIC_SUBROUTINES.agc:178
//#	4. NEGATIVE TRANSFER TIME IS AMBIGUOUS AND WILL RESULT IN NO SOLUTION.
// CONIC_SUBROUTINES.agc:179
//#	5. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE
// CONIC_SUBROUTINES.agc:180
//#	   LIMITS ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
// CONIC_SUBROUTINES.agc:181
//#
// CONIC_SUBROUTINES.agc:182
//#	THE NUMBER OF ITERATIONS AND, THEREFORE, THE COMPUTATIONS SPEED IS DEPENDENT ON THE ACCURACY OF THE FIRST
// CONIC_SUBROUTINES.agc:183
//# GUESS OF THE INDEPENDENT VARIABLE, COGA.  THE AGC COMPUTATION TIME IS APPROXIMATELY
// CONIC_SUBROUTINES.agc:184
//# .105 SECONDS FOR INITIALIZATION, .069 SECONDS FOR FINAL COMPUTATIONS, PLUS .205 SECONDS FOR EACH ITERATION.
// CONIC_SUBROUTINES.agc:185
//#
// CONIC_SUBROUTINES.agc:186
//# REFERENCES -
// CONIC_SUBROUTINES.agc:187
//#	R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, MUN LANDING MISSION GSOP - SECTION 5.5, SGA MEMO 67-8,
// CONIC_SUBROUTINES.agc:188
//#	SGA MEMO 67-4.
// CONIC_SUBROUTINES.agc:189
//#
// CONIC_SUBROUTINES.agc:190
//# INPUT - ERASABLE INITIALIZATION REQUIRED
// CONIC_SUBROUTINES.agc:191
//#
// CONIC_SUBROUTINES.agc:192
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:193
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:194
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:195
//#	R1VEC		* +29 FOR KERBIN	*	DP INITIAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:196
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:197
//#	R2VEC		* +29 FOR KERBIN	*	DP TARGET OR TERMINAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:198
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:199
//#	TDESIRED	* +28		*	DP DESIRED TRANSFER TIME IN CENTISECONDS
// CONIC_SUBROUTINES.agc:200
//#	X1 (38D)	* NONE		*	INDEX REGISTER SET TO -2D OR -10D ACCORDING TO WHETHER KERBIN OR MUN,
// CONIC_SUBROUTINES.agc:201
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY
// CONIC_SUBROUTINES.agc:202
//#	GEOMSGN		* NONE		*	SP +.5 IF DESIRED TRANSFER ANGLE IS LESS THAN 180 DEGREES, -.5 IF GREATER THAN 180 DEG.
// CONIC_SUBROUTINES.agc:203
//#	GUESSW		* NONE		*	AN INTERPRETER SWITCH TO BE SET IF NO GUESS OF COGA IS AVAILABLE, CLEAR IF A GUESS OF
// CONIC_SUBROUTINES.agc:204
//# Page 1164
// CONIC_SUBROUTINES.agc:205
//#			*		*		COGA IS TO BE USED BY LAMBERT
// CONIC_SUBROUTINES.agc:206
//#	COGA		* +5		*	DP GUESS OF COTANGENT OF FLIGHT PATH ANGLE (MEASURED FROM VERTICAL).  THIS WILL BE
// CONIC_SUBROUTINES.agc:207
//#			*		*	IGNORED IF GUESSW IS SET.
// CONIC_SUBROUTINES.agc:208
//#	NORMSW		* NONE		*	AN INTERPRETER SWITCH TO BE SET IF UN IS TO BE AN INPUT TO THE SUBROUTINE, CLEAR IF
// CONIC_SUBROUTINES.agc:209
//#			*		*		LAMBERT IS TO COMPUTE ITS OWN NORMAL (UN).
// CONIC_SUBROUTINES.agc:210
//#	UN		* +1		*	DP UNIT NORMAL TO THE DESIRED ORBIT PLANE IN THE DIRECTION OF THE RESULTING ANGULAR
// CONIC_SUBROUTINES.agc:211
//#			*		*		MOMENTUM VECTOR.  THIS WILL BE IGNORED IF NORMSW IS CLEAR.
// CONIC_SUBROUTINES.agc:212
//#	VTARGTAG	* NONE		*	A S.P. TAG TO BE SET TO ZERO IF LAMBERT IS TO COMPUTE THE VELOCITY AT R2VEC AS WELL AS
// CONIC_SUBROUTINES.agc:213
//#			*		*		AT R1VEC.
// CONIC_SUBROUTINES.agc:214
//#	ITERCTR		* NONE		*	A S.P. COUNTER WHICH SPECIFIES THE MAXIMUM NUMBER OF ITERATIONS ALLOWABLE.
// CONIC_SUBROUTINES.agc:215
//#			*		*		(AN ITERATION MEANS A PASS THRU KEPLER EQN (DELTIME). AT LEAST ONE OF THESE MUST
// CONIC_SUBROUTINES.agc:216
//#			*		*		ALWAYS OCCUR, EVEN IF COGA CORRESPONDING TO SOLUTION WERE INPUT AS A GUESS.)
// CONIC_SUBROUTINES.agc:217
//#			*		*		TWENTY ITERATIONS ARE SUFFICIENT TO SOLVE ALL PROBLEMS INCLUDING THOSE WITHOUT GUESS.
// CONIC_SUBROUTINES.agc:218
//#
// CONIC_SUBROUTINES.agc:219
//# SUBROUTINES CALLED -
// CONIC_SUBROUTINES.agc:220
//#	GEOM, GETX, DELTIME, ITERATOR, LAMENTER (PART OF NEWSTATE)
// CONIC_SUBROUTINES.agc:221
//#
// CONIC_SUBROUTINES.agc:222
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// CONIC_SUBROUTINES.agc:223
//#	L 	CALL			# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// CONIC_SUBROUTINES.agc:224
//#	L+1		LAMBERT		# RETURNS WITH PL AT 0 AND WITH VVEC IN MPAC IF VTARGTAG WAS WAS NON-ZERO OR VTARGET
// CONIC_SUBROUTINES.agc:225
//#					# IN MPAC IF VTARGTAG WAS ZERO
// CONIC_SUBROUTINES.agc:226
//#	L+2	BON			# CONTINUE IF SOLNSW CLEAR SINCE SOLUTION IS ACCEPTABLE
// CONIC_SUBROUTINES.agc:227
//#	L+3		SOLNSW
// CONIC_SUBROUTINES.agc:228
//#	L+4		LAMABORT
// CONIC_SUBROUTINES.agc:229
//#
// CONIC_SUBROUTINES.agc:230
//#	IF A LAMBERT RESULT IS TO BE A FIRST GUESS FOR THE NEXT LAMBERT CALCULATION, COGA MUST BE PRESERVED AND
// CONIC_SUBROUTINES.agc:231
//# GUESSW MUST BE CLEAR FOR EACH SUCCEEDING LAMBERT CALL.
// CONIC_SUBROUTINES.agc:232
//#
// CONIC_SUBROUTINES.agc:233
//# ABORT EXIT MODES -
// CONIC_SUBROUTINES.agc:234
//#	IF SOLNSW WAS SET UPON EXITING, EITHER LAMBERT WAS ASKED TO COMPUTE A TRANSFER TOO NEAR 0 OR 360 DEG, OR T
// CONIC_SUBROUTINES.agc:235
//# WAS TOO SMALL TO PRODUCE A REALISTIC TRANSFER BETWEEN R1VEC AND R2VEC.  IN EITHER CASE THE FIX MUST BE MADE
// CONIC_SUBROUTINES.agc:236
//# ACCORDING TO THE NEEDS OF THE PARTICULAR USER.  THE ABORT EXIT MODE MAY BE CODED AS ...
// CONIC_SUBROUTINES.agc:237
//# LAMBABORT	DLOAD	ABS		# A MEASURE OF THE PROXIMITY TO 0 OR
// CONIC_SUBROUTINES.agc:238
//#			1-CSTH		# 360 DEGREES.
// CONIC_SUBROUTINES.agc:239
//#		DSU	BMN
// CONIC_SUBROUTINES.agc:240
//#			ONEBIT
// CONIC_SUBROUTINES.agc:241
//#			CHANGER2	# CHANGE R2VEC DIRECTION SLIGHTLY.
// CONIC_SUBROUTINES.agc:242
//#		DLOAD	DAD
// CONIC_SUBROUTINES.agc:243
//#			TDESIRED
// CONIC_SUBROUTINES.agc:244
//#			SOMETIME
// CONIC_SUBROUTINES.agc:245
//#		STCALL	TDESIRED	# INCRESE TDESIRED
// CONIC_SUBROUTINES.agc:246
//#			LAMBERT
// CONIC_SUBROUTINES.agc:247
//#
// CONIC_SUBROUTINES.agc:248
//# Page 1165
// CONIC_SUBROUTINES.agc:249
//# OUTPUT -
// CONIC_SUBROUTINES.agc:250
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:251
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:252
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:253
//#	VVEC		* +7 FOR KERBIN	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND REQUIRED TO SATISFY THE BOUNDARY VALUE
// CONIC_SUBROUTINES.agc:254
//#			* +5 FOR MUN	*		PROBLEM.
// CONIC_SUBROUTINES.agc:255
//#	VTARGET		* +7 FOR KERBIN	*	DP RESULTANT VELOCITY VECTOR AT R2VEC IN METERS/CENTISECOND.
// CONIC_SUBROUTINES.agc:256
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:257
//#	SOLNSW		* NONE		*	INTERPRETER SWITCH WHICH IS SET IF THE SUBROUTINE CANNOT SOLVE THE PROBLEM, CLEAR IF THE
// CONIC_SUBROUTINES.agc:258
//#			* 		*		SOLUTION EXISTS.
// CONIC_SUBROUTINES.agc:259
//#
// CONIC_SUBROUTINES.agc:260
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// CONIC_SUBROUTINES.agc:261
//#
// CONIC_SUBROUTINES.agc:262
//# DEBRIS -
// CONIC_SUBROUTINES.agc:263
//#	PARAMETERS WHICH MAY BE OF USE -
// CONIC_SUBROUTINES.agc:264
//#
// CONIC_SUBROUTINES.agc:265
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:266
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:267
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:268
//#	SNTH		* +1		*	DP SIN OF ANGLE BETWEEN R1VEC AND R2VEC
// CONIC_SUBROUTINES.agc:269
//#	CSTH		* +1		*	DP COSINE OF ANGLE
// CONIC_SUBROUTINES.agc:270
//#	1-CSTH		* +2		*	DP 1-CSTH
// CONIC_SUBROUTINES.agc:271
//#	COGA		* +5		*	DP COTAN OF INITIAL REQUIRED FLIGHT PATH ANGLE MEASURED FROM VERTICAL
// CONIC_SUBROUTINES.agc:272
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO INITIAL RADIUS
// CONIC_SUBROUTINES.agc:273
//#	R1A		* +6		*	DP RATIO OF INITIAL RADIUS TO SEMI-MAJOR AXIS
// CONIC_SUBROUTINES.agc:274
//#	R1 (32D)	* +29 FOR KERBIN	*	DP INITIAL RADIUS IN METERS
// CONIC_SUBROUTINES.agc:275
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:276
//#	UR1		* +1		*	DP UNIT VECTOR OF R1VEC
// CONIC_SUBROUTINES.agc:277
//#	U2		* +1		*	DP UNIT VECTOR OF R2VEC
// CONIC_SUBROUTINES.agc:278
//#
// CONIC_SUBROUTINES.agc:279
//#	PARAMETERS OF NO USE -
// CONIC_SUBROUTINES.agc:280
//#		DP PARAMETERS - EPSILONL, CSTH-RHO, TPREV, TERRLAMB, R2, RTNLAMB (SP), PLUS PUSHLIST REGISTER 0 THROUGH 41D
// CONIC_SUBROUTINES.agc:281
//#		ADDITIONAL INTERPRETIVE SWITCHES USED - INFINFLG, 360SW, SLOPESW, ORDERSW
// CONIC_SUBROUTINES.agc:282
//
// CONIC_SUBROUTINES.agc:283
//# Page 1166
// CONIC_SUBROUTINES.agc:284
//# PROGRAM DESCRIPTION - TIME-THETA SUBROUTINE			DATE - 1 SEPTEMBER 1967
// CONIC_SUBROUTINES.agc:285
//# MOD NO. - 0							LOG SECTION - CONIC SUBROUTINES
// CONIC_SUBROUTINES.agc:286
//# MOD BY KRAUSE KERMAN							ASSEMBLY - COLOSSUS REVISION 88
// CONIC_SUBROUTINES.agc:287
//#
// CONIC_SUBROUTINES.agc:288
//# FUNCTIONAL DESCRIPTION -
// CONIC_SUBROUTINES.agc:289
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE
// CONIC_SUBROUTINES.agc:290
//# STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
// CONIC_SUBROUTINES.agc:291
//# PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
// CONIC_SUBROUTINES.agc:292
//# CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO KERBIN OR THE MUN.  THE USE OF TEH SUBROUTINE CAN BE
// CONIC_SUBROUTINES.agc:293
//# EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WTIHOUT INTRODUCING ANY CODING CHANGES,
// CONIC_SUBROUTINES.agc:294
//# ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
// CONIC_SUBROUTINES.agc:295
//#
// CONIC_SUBROUTINES.agc:296
//# THE RESTRICTIONS ARE -
// CONIC_SUBROUTINES.agc:297
//#	1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
// CONIC_SUBROUTINES.agc:298
//#	   AND LESS THAN 178 DEGREES 12.5 MINUTES.
// CONIC_SUBROUTINES.agc:299
//#	2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
// CONIC_SUBROUTINES.agc:300
//#	   ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLY.
// CONIC_SUBROUTINES.agc:301
//#
// CONIC_SUBROUTINES.agc:302
//#	THE AGC COMPUTATION TIME IS APPROXIMATELY .292 SECONDS.
// CONIC_SUBROUTINES.agc:303
//#
// CONIC_SUBROUTINES.agc:304
//# REFERENCES -
// CONIC_SUBROUTINES.agc:305
//#	R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, MUN LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
// CONIC_SUBROUTINES.agc:306
//#
// CONIC_SUBROUTINES.agc:307
//# INPUT - ERASABLE INITIALIZATION REQUIRED
// CONIC_SUBROUTINES.agc:308
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:309
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:310
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:311
//#	RVEC		* +29 FOR KERBIN	*	DP INITIAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:312
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:313
//#	VVEC		* +7 FOR KERBIN	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// CONIC_SUBROUTINES.agc:314
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:315
//#	SNTH		* +1		*	DP SINE OF TRUE-ANOMALY-DIFFERENCE THROUGH WHICH THE STATE IS TO BE UPDATED
// CONIC_SUBROUTINES.agc:316
//#	CSTH		* +1		*	DP COSINE OF THE ANGLE
// CONIC_SUBROUTINES.agc:317
//#	RVSW		* NONE		*	AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
// CONIC_SUBROUTINES.agc:318
//#			*		*		IS TO BE COMPUTED ALSO.
// CONIC_SUBROUTINES.agc:319
//#	X1 (38D)	* NONE		*	INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER KERBIN OR MUN,
// CONIC_SUBROUTINES.agc:320
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY.
// CONIC_SUBROUTINES.agc:321
//#
// CONIC_SUBROUTINES.agc:322
//# SUBROUTINES CALLED -
// CONIC_SUBROUTINES.agc:323
//# Page 1167
// CONIC_SUBROUTINES.agc:324
//#	PARAM, GEOM, GETX, DELTIME, NEWSTATE
// CONIC_SUBROUTINES.agc:325
//#
// CONIC_SUBROUTINES.agc:326
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// CONIC_SUBROUTINES.agc:327
//#	IF ONLY TIME IS DESIRED AS OUTPUT -
// CONIC_SUBROUTINES.agc:328
//#	L	SET	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// CONIC_SUBROUTINES.agc:329
//#	L+1		RVSW
// CONIC_SUBROUTINES.agc:330
//#	L+2		TIMETHET	# RETURN WITH PL AT 0 AND T IN MPAC
// CONIC_SUBROUTINES.agc:331
//#	L+3	...			# CONTINUE
// CONIC_SUBROUTINES.agc:332
//#
// CONIC_SUBROUTINES.agc:333
//#	IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
// CONIC_SUBROUTINES.agc:334
//#	L	CLEAR	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// CONIC_SUBROUTINES.agc:335
//#	L+1		RVSW
// CONIC_SUBROUTINES.agc:336
//#	L+2		TIMETHET	# RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
// CONIC_SUBROUTINES.agc:337
//#					# THE INITIAL VELOCITY VECTOR IN MPAC.
// CONIC_SUBROUTINES.agc:338
//#	L+3	STOVL	NEWVVEC
// CONIC_SUBROUTINES.agc:339
//#	L+4	STADR
// CONIC_SUBROUTINES.agc:340
//#	L+5	STORE	NEWRVEC		# NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
// CONIC_SUBROUTINES.agc:341
//#	L+6	...			# CONTINUE.
// CONIC_SUBROUTINES.agc:342
//#
// CONIC_SUBROUTINES.agc:343
//# ABORT EXIT MODES -
// CONIC_SUBROUTINES.agc:344
//#	IF COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-THETA, TIME-THETA WILL TRANSFER TO POODOO WITH
// CONIC_SUBROUTINES.agc:345
//#	AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM.  (PCR 692 AND 721).
// CONIC_SUBROUTINES.agc:346
//#
// CONIC_SUBROUTINES.agc:347
//# OUTPUT -
// CONIC_SUBROUTINES.agc:348
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:349
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:350
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:351
//#	T (30D)		* +28		*	DP TRANSFER TIME IN CENTISECONDS
// CONIC_SUBROUTINES.agc:352
//#	INFINFLG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF THE TRANSFER ANGLE REQUIRES CLOSURE THROUGH
// CONIC_SUBROUTINES.agc:353
//#			*		*		INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
// CONIC_SUBROUTINES.agc:354
//#	COGAFLAG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
// CONIC_SUBROUTINES.agc:355
//#			* 		*		CLEAR IF NOT.
// CONIC_SUBROUTINES.agc:356
//#
// CONIC_SUBROUTINES.agc:357
//#	IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
// CONIC_SUBROUTINES.agc:358
//#	MPAC - 		* +7 FOR KERBIN	*	DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
// CONIC_SUBROUTINES.agc:359
//#	 MPAC +5	* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:360
//#	0D - 5D		* +29 FOR KERBIN	*	DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
// CONIC_SUBROUTINES.agc:361
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:362
//#
// CONIC_SUBROUTINES.agc:363
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// CONIC_SUBROUTINES.agc:364
//#
// CONIC_SUBROUTINES.agc:365
//# Page 1168
// CONIC_SUBROUTINES.agc:366
//# DEBRIS -
// CONIC_SUBROUTINES.agc:367
//#	PARAMETERS WHICH MAY BE OF USE -
// CONIC_SUBROUTINES.agc:368
//#
// CONIC_SUBROUTINES.agc:369
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:370
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:371
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:372
//#	R1 (32D)	* +29 FOR KERBIN	*	DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
// CONIC_SUBROUTINES.agc:373
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:374
//#	R1A		* +6		*	DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
// CONIC_SUBROUTINES.agc:375
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO R1
// CONIC_SUBROUTINES.agc:376
//#	COGA		* +5		*	DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
// CONIC_SUBROUTINES.agc:377
//#	UR1		* +1		*	DP UNIT VECTOR OF RVEC
// CONIC_SUBROUTINES.agc:378
//#	U2		* +1		*	DP UNIT VECTOR OF VVEC
// CONIC_SUBROUTINES.agc:379
//#	UN		* +1		*	DP UNIT VECTOR OF UR1*U2
// CONIC_SUBROUTINES.agc:380
//#
// CONIC_SUBROUTINES.agc:381
//#	PARAMETERS OF NO USE -
// CONIC_SUBROUTINES.agc:382
//#	SP PARAMETERS -- RTNTT, GEOMSGN, RTNPRM, MAGVEC2=R2 (DP), PLUS PUSHLIST LOCATIONS 0-11D, 14D-21D, 24D-39D, 41D
// CONIC_SUBROUTINES.agc:383
//#	ADDITIONAL INTERPRETIVE SWITCHES USED -- NORMSW, 360SW
// CONIC_SUBROUTINES.agc:384
//
// CONIC_SUBROUTINES.agc:385
//# Page 1169
// CONIC_SUBROUTINES.agc:386
//# PROGRAM DESCRIPTION - TIME-RADIUS SUBROUTINE		DATE - 11 OCTOBER 1967
// CONIC_SUBROUTINES.agc:387
//# MOD NO. -1						LOG SECTION - CONIC SUBROUTINES
// CONIC_SUBROUTINES.agc:388
//# MOD BY KRAUSE KERMAN						ASSEMBLY - COLOSSUS REVISION 88
// CONIC_SUBROUTINES.agc:389
//#
// CONIC_SUBROUTINES.agc:390
//# FUNCTIONAL DESCRIPTION -
// CONIC_SUBROUTINES.agc:391
//#
// CONIC_SUBROUTINES.agc:392
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR AND A DESIRED RADIUS TO WHICH THE
// CONIC_SUBROUTINES.agc:393
//#	STATE IS TO BE UPDATED ALONG A CONIC TRAJECTORY, CALCULATES THE CORRESPONDING TIME-OF-FLIGHT AND, IN ADDITION,
// CONIC_SUBROUTINES.agc:394
//#	PROVIDES THE OPTION OF COMPUTING THE NEW UPDATED STATE VECTOR.  THE RESULTING TRAJECTORY MAY BE A SECTION OF A
// CONIC_SUBROUTINES.agc:395
//#	CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO KERBIN OR THE MUN.  THE USE OF THE SUBROUTINE CAN BE
// CONIC_SUBROUTINES.agc:396
//#	EXTENDED USING OTHER PRIMARY BODIES BY SIMMPE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
// CONIC_SUBROUTINES.agc:397
//#	ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
// CONIC_SUBROUTINES.agc:398
//#
// CONIC_SUBROUTINES.agc:399
//#	IF THE DESIRED RADIUS IS BEYOND THE RADIUS OF APOCENTER OF THE CONIC OR BELOW THE RADIUS OF PERICENTER,
// CONIC_SUBROUTINES.agc:400
//#	APSESW WILL BE SET AND THE SUBROUTINE WILL RETURN THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY.
// CONIC_SUBROUTINES.agc:401
//#
// CONIC_SUBROUTINES.agc:402
//# THE RESTRICTIONS ARE -
// CONIC_SUBROUTINES.agc:403
//#	1. THE ANGLE BETWEEN ANY POSITION VECTOR AND ITS VELOCITY VECTOR MUST BE GREATER THAN 1 DEGREE 47.5 MINUTES
// CONIC_SUBROUTINES.agc:404
//#	   AND LESS THAN 178 DEGREES 12.5 MINUTES.
// CONIC_SUBROUTINES.agc:405
//#	2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
// CONIC_SUBROUTINES.agc:406
//#	   ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
// CONIC_SUBROUTINES.agc:407
//#	3. AN ACCURACY DEGRADATION OCCURS AS THE SENSITIVITIES OF TIME AND UPDATED STATE VECTOR TO CHANGES IN
// CONIC_SUBROUTINES.agc:408
//#	   RDESIRED INCREASE.  THIS WILL OCCUR NEAR EITHER APSIS OF THE CONIC AND WHEN THE CONIC IS NEARLY CIRCULAR.  IN
// CONIC_SUBROUTINES.agc:409
//#	   PARTICULAR, IF THE CONIC IS AN EXACT CIRCLE, THE PROBLEM IS UNDEFINED AND THE SUBROUTINE WILL ABORT.
// CONIC_SUBROUTINES.agc:410
//#
// CONIC_SUBROUTINES.agc:411
//#	THE AGC COMPUTATION TIME IS APPROXIMATELY .363 SECONDS.
// CONIC_SUBROUTINES.agc:412
//#
// CONIC_SUBROUTINES.agc:413
//# REFERENCES -
// CONIC_SUBROUTINES.agc:414
//#	R-479, MISSION PROGRAMMING DEFINITION MEMO NO. 10, MUN LANDING MISSION GSOP-SECTION 5.5, SGA MEMO 67-8.
