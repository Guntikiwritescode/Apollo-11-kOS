// CONIC_SUBROUTINES.agc:555
//#	L+5	...			# CONTINUE
// CONIC_SUBROUTINES.agc:556
//#
// CONIC_SUBROUTINES.agc:557
//# OUTPUT -
// CONIC_SUBROUTINES.agc:558
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:559
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:560
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:561
//#	MPAC		* +29 FOR KERBIN	*	DP RADIUS OF APOCENTER IN METERS
// CONIC_SUBROUTINES.agc:562
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:563
//#	0D-1D		* +29 FOR KERBIN	*	DP RADIUS OF PERICENTER IN METERS
// CONIC_SUBROUTINES.agc:564
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:565
//#	ECC		* +3		*	DP ECCENTRICITY OF CONIC TRAJECTORY.
// CONIC_SUBROUTINES.agc:566
//#
// CONIC_SUBROUTINES.agc:567
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
