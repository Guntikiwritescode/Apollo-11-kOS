// PORT: Physical bank 12. Shared continuation entries, slots 13283–13283.
function agcAotUnit750 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE CONIC_SUBROUTINES.agc:1729
//		TC	POODOO
// PORT: Fixed ROM slots 13283.
    if slot <> 13283 or instruction <> 2986 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2986, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[750] to agcAotUnit750@.

agcAotInstallSourceRope(list(
// PORT: SOURCE CONIC_SUBROUTINES.agc:1730
//		OCT	00607
// PORT: Fixed ROM slots 13284.
    13284, 782
)).

