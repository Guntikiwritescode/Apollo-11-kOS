//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:576
//#	R1 (32D)	* +29 FOR KERBIN	*	DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
// CONIC_SUBROUTINES.agc:577
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:578
//#	R1A		* +6		*	DP RATIO OF R1 TO SEMI-MAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
// CONIC_SUBROUTINES.agc:579
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO R1
// CONIC_SUBROUTINES.agc:580
//#	COGA		* +5		*	DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
// CONIC_SUBROUTINES.agc:581
//#	UR1		* +1		*	DP UNIT VECTOR OF RVEC
// CONIC_SUBROUTINES.agc:582
//#	U2		* +1		*	DP UNIT VECTOR OF VVEC
