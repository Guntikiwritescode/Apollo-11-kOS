// PORT: Physical bank 12. Shared continuation entries, slots 12833–12833.
function agcAotUnit748 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE CONIC_SUBROUTINES.agc:1250
//		TC	POLY
// PORT: Fixed ROM slots 12833.
    if slot <> 12833 or instruction <> 3730 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3730, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[748] to agcAotUnit748@.

