// CONIC_SUBROUTINES.agc:584
//#	MAGVEC2		* +7 FOR KERBIN	*	DP MAGNITUDE OF VVEC
// CONIC_SUBROUTINES.agc:585
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:586
