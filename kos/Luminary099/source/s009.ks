//#
// CONIC_SUBROUTINES.agc:508
//
// CONIC_SUBROUTINES.agc:509
//# Page 1172
// CONIC_SUBROUTINES.agc:510
//# PROGRAM DESCRIPTION - APSIDES SUBROUTINE		DATE - 1 SEPTEMBER 1967
// CONIC_SUBROUTINES.agc:511
//# MOD NO. - 0						LOG SECTION - CONIC SUBROUTINES
// CONIC_SUBROUTINES.agc:512
//# MOD BY KRAUSE KERMAN						ASSEMBLY - COLOSSUS REVISION 88
// CONIC_SUBROUTINES.agc:513
//#
// CONIC_SUBROUTINES.agc:514
//# FUNCTIONAL DESCRIPTION -
// CONIC_SUBROUTINES.agc:515
//#
// CONIC_SUBROUTINES.agc:516
//#	THIS SUBROUTINE, GIVEN AN INITIAL STATE VECTOR CALCULATES THE RADIUS OF PERICENTER AND OF APOCENTER AND THE
// CONIC_SUBROUTINES.agc:517
//#	ECCENTRICITY OF THE RESULTING CONIC TRAJECTORY, WHICH MAY BE A STRAIGHT LINE,
// CONIC_SUBROUTINES.agc:518
//#	CIRCLE, ELLIPSE, PARABOLA, OR HYPERBOLA WITH RESPECT TO KERBIN OR THE MUN.  THE USE OF THE SUBROUTINE CAN
// CONIC_SUBROUTINES.agc:519
//#	BE EXTENDED USING OTHER PRIMARY BODIES BY SIMPLE ADDITIONS TO THE MUTABLE WITHOUT INTRODUCING ANY CODING CHANGES,
// CONIC_SUBROUTINES.agc:520
//#	ACCEPTING THE INHERENT SCALE FACTOR CHANGES IN POSITION AND VELOCITY.
// CONIC_SUBROUTINES.agc:521
//#
// CONIC_SUBROUTINES.agc:522
//# THE RESTRICTIONS ARE -
// CONIC_SUBROUTINES.agc:523
//#	1. IF APOCENTER IS BEYOND THE SCALING OF POSITION, THE SCALE FACTOR LIMIT (536,870,910 METERS WITH RESPECT
// CONIC_SUBROUTINES.agc:524
//#	   TO KERBIN OR 134,217,727.5 METERS WITH RESPECT TO THE MUN) WILL BE RETURNED.
// CONIC_SUBROUTINES.agc:525
//#	2. THE PARAMETERS IN THE PROBLEM MUST NOT EXCEED THEIR SCALING LIMITS SPECIFIED IN THE GSOP.  IF THE LIMITS
// CONIC_SUBROUTINES.agc:526
//#	   ARE EXCEEDED, THE RESULTING SOLUTION WILL BE MEANINGLESS.
// CONIC_SUBROUTINES.agc:527
//#
// CONIC_SUBROUTINES.agc:528
//#	THE AGC COMPUTATION TIME IS APPROXIMATELY .103 SECONDS.
// CONIC_SUBROUTINES.agc:529
//#
// CONIC_SUBROUTINES.agc:530
//# REFERENCES -
// CONIC_SUBROUTINES.agc:531
//#	MISSION PROGRAMMING DEFINITION MEMO NO. 10, MUN LANDING MISSION GSOP-SECTION 5.5
// CONIC_SUBROUTINES.agc:532
//#
// CONIC_SUBROUTINES.agc:533
//# INPUT - ERASABLE INITIALIZATION REQUIRED
// CONIC_SUBROUTINES.agc:534
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:535
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:536
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:537
//#	RVEC		* +29 FOR KERBIN	*	DP INITIAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:538
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:539
//#	VVEC		* +7 FOR KERBIN	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// CONIC_SUBROUTINES.agc:540
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:541
//#	X1 (38D)	* NONE		*	INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER KERBIN OR MUN,
// CONIC_SUBROUTINES.agc:542
//#			*		*		RESPECTIVELY, IS THE CENTRAL BODY.
// CONIC_SUBROUTINES.agc:543
//#
// CONIC_SUBROUTINES.agc:544
