// PORT: Physical bank 12. Shared continuation entries, slots 12708–12709.
function agcAotUnit745 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 12708 {
// PORT: SOURCE CONIC_SUBROUTINES.agc:1006
//
// PORT: SOURCE CONIC_SUBROUTINES.agc:1007
//CHECKCTR	CS	ONE
// PORT: Fixed ROM slots 12708.
        if slot <> 12708 or instruction <> 18923 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local fixedOperand is mod(readEffective:call(words, 2539), 32768).
            set words[0] to agcSignExtend(32767 - fixedOperand).
            return list(false, false, true, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// PORT: SOURCE CONIC_SUBROUTINES.agc:1008
//		INDEX	FIXLOC
// PORT: Fixed ROM slots 12709.
        if slot <> 12709 or instruction <> 20560 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        if extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
set agcAotRoutes[745] to agcAotUnit745@.

