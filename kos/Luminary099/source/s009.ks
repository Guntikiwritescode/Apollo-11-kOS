//#
// CONIC_SUBROUTINES.agc:416
//# INPUT - ERASABLE INITIALIZATION REQUIRED.
// CONIC_SUBROUTINES.agc:417
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:418
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:419
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:420
//#	RVEC		* +29 FOR KERBIN	*	DP INITIAL POSITION VECTOR IN METERS
// CONIC_SUBROUTINES.agc:421
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:422
//#	VVEC		* +7 FOR KERBIN	*	DP INITIAL VELOCITY VECTOR IN METERS/CENTISECOND
// CONIC_SUBROUTINES.agc:423
//#			* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:424
//#	RDESIRED	* +29 FOR KERBIN	*	DP TERMINAL RADIAL DISTANCE ON CONIC TRAJECTORY FOR WHICH TRANSFER TIME IS TO BE
// CONIC_SUBROUTINES.agc:425
//#			* +27 FOR MUN	*		COMPUTED
// CONIC_SUBROUTINES.agc:426
//#	SGNRDOT		* NONE		*	SP TAG SET TO +.5 OR -.5 ACCORDING TO WHETHER THE RADIAL VELOCITY AT RDESIRED IS TO BE
// CONIC_SUBROUTINES.agc:427
//#			*		*		POSITIVE OR NEGATIVE, RESPECTIVELY.   THIS TAG REDUCES THE DOUBLE-VALUED PROBLEM TO A
// CONIC_SUBROUTINES.agc:428
//# Page 1170
// CONIC_SUBROUTINES.agc:429
//#			*		*		SINGLE-VALUED PROBLEM.
// CONIC_SUBROUTINES.agc:430
//#	X1 (38D)	* NONE		*	INDEX REGISTER TO BE SET TO -2D OR -10D ACCORDING TO WHETHER KERBIN OR MUN,
// CONIC_SUBROUTINES.agc:431
//#			* 		*		RESPECTIVELY, IS THE CENTRAL BODY.
// CONIC_SUBROUTINES.agc:432
//#	RVSW		* NONE		*	AN INTERPRETIVE SWITCH TO BE SET IF ONLY TIME IS TO BE AN OUTPUT, CLEAR IF THE NEW STATE
// CONIC_SUBROUTINES.agc:433
//#			*		*		IS TO BE COMPUTED ALSO.
// CONIC_SUBROUTINES.agc:434
//#
// CONIC_SUBROUTINES.agc:435
//# SUBROUTINES CALLED -
// CONIC_SUBROUTINES.agc:436
//#	PARAM, GEOM, GETX, DELTIME, NEWSTATE
// CONIC_SUBROUTINES.agc:437
//#
// CONIC_SUBROUTINES.agc:438
//# CALLING SEQUENCE AND NORMAL EXIT MODES -
// CONIC_SUBROUTINES.agc:439
//#
// CONIC_SUBROUTINES.agc:440
//#	IF ONLY TIME IS DESIRED AS OUTPUT -
// CONIC_SUBROUTINES.agc:441
//#	L	SET	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// CONIC_SUBROUTINES.agc:442
//#	L+1		RVSW
// CONIC_SUBROUTINES.agc:443
//#	L+2		TIMERAD		# RETURN WITH PL AT 0 AND T IN MPAC
// CONIC_SUBROUTINES.agc:444
//#	L+3	...			# CONTINUE
// CONIC_SUBROUTINES.agc:445
//#
// CONIC_SUBROUTINES.agc:446
//#	IF THE UPDATE STATE VECTOR IS DESIRED AS WELL -
// CONIC_SUBROUTINES.agc:447
//#	L	CLEAR	CALL		# MUST BE IN INTERPRETIVE MODE BUT OVFIND ARBITRARY.
// CONIC_SUBROUTINES.agc:448
//#	L+1		RVSW
// CONIC_SUBROUTINES.agc:449
//#	L+2		TIMERAD		# RETURNS WITH PL AT 6.  THE INITIAL POSITION VECTOR IS IN 0D OF THE PUSHLIST AND
// CONIC_SUBROUTINES.agc:450
//#					# THE INITIAL VELOCITY VECTOR IN MPAC.
// CONIC_SUBROUTINES.agc:451
//#	L+3	STOVL	NEWVVEC
// CONIC_SUBROUTINES.agc:452
//#	L+4	STADR
// CONIC_SUBROUTINES.agc:453
//#	L+5	STORE	NEWRVEC		# NEWVVEC AND NEWRVEC ARE SYMBOLIC REPRESENTATIONS OF THE USERS LOCATIONS.
// CONIC_SUBROUTINES.agc:454
//#	...				# CONTINUE
// CONIC_SUBROUTINES.agc:455
//#
// CONIC_SUBROUTINES.agc:456
//# ABORT EXIT MODES -
// CONIC_SUBROUTINES.agc:457
//#	IF SOLNSW AND/OR COGAFLAG AND/OR INFINFLG IS SET AT THE EXIT TO TIME-RADIUS, TIME-RADIUS WILL TRANSFER
// CONIC_SUBROUTINES.agc:458
//#	TO POODOO WITH AN ALARM CODE (ORIGINALLY 00607), AND NOT RETURN TO THE CALLING PROGRAM. (PCR 692 & 721)
// CONIC_SUBROUTINES.agc:459
//#
// CONIC_SUBROUTINES.agc:460
//# OUTPUT -
// CONIC_SUBROUTINES.agc:461
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:462
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:463
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:464
//#	T (30D)		* +28		*	DP TRANSFER TIME IN CENTISECONDS.
// CONIC_SUBROUTINES.agc:465
//#	INFINFLG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED AND SGNRDOT REQUIRE CLOSURE THROUGH
// CONIC_SUBROUTINES.agc:466
//#			*		*		INFINITY (NO SOLUTION), CLEAR IF A PHYSICAL SOLUTION IS POSSIBLE.
// CONIC_SUBROUTINES.agc:467
//#	COGAFLAG	* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RESTRICTION 1 HAS BEEN VIOLATED (NO SOLUTION),
// CONIC_SUBROUTINES.agc:468
//#			*		*		CLEAR IF NOT.
// CONIC_SUBROUTINES.agc:469
//#	APSESW		* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF RDESIRED WAS GREATER THAN RADIUS OF APOCENTER OR
// CONIC_SUBROUTINES.agc:470
//# Page 1171
// CONIC_SUBROUTINES.agc:471
//#			*		*		LESS THAN RADIUS OF PERICENTER.  THE APOCENTER OR PERICENTER SOLUTION, RESPECTIVELY,
// CONIC_SUBROUTINES.agc:472
//#			*		*		WILL THEN BE RETURNED.  THE SWITCH IS CLEAR IF RDESIRED WAS BETWEEN PERICENTER AND
// CONIC_SUBROUTINES.agc:473
//#			*		*		APOCENTER.
// CONIC_SUBROUTINES.agc:474
//#	SOLNSW		* NONE		*	AN INTERPRETIVE SWITCH WHICH IS SET IF THE CONIC IS SO CLOSE TO A CIRCLE THAT THE TERMIN
// CONIC_SUBROUTINES.agc:475
//#			*		*		POINT IS AMBIGUOUS, VIOLATING RESTRICTION 3.  IF ECCENTRICITY IS GREATER THAN 2-TO-THE-
// CONIC_SUBROUTINES.agc:476
//#			*		*		MINUS-18, THE SWITCH IS CLEAR.
// CONIC_SUBROUTINES.agc:477
//#
// CONIC_SUBROUTINES.agc:478
//#	IN ADDITION, IF RVSW IS CLEAR, THE FOLLOWING ARE OUTPUT -
// CONIC_SUBROUTINES.agc:479
//#
// CONIC_SUBROUTINES.agc:480
//#	MPAC - 		* +7 FOR KERBIN	*	DP TERMINAL VELOCITY VECTOR IN METERS/CENTISEC.
// CONIC_SUBROUTINES.agc:481
//#	 MPAC +5	* +5 FOR MUN	*
// CONIC_SUBROUTINES.agc:482
//#	0D - 5D		* +29 FOR KERBIN	*	DP TERMINAL POSITION VECTOR IN METERS (PL AT 6D)
// CONIC_SUBROUTINES.agc:483
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:484
//#
// CONIC_SUBROUTINES.agc:485
//#	FOR OTHER OUTPUT WHICH MAY BE OF USE, SEE DEBRIS.
// CONIC_SUBROUTINES.agc:486
//#
// CONIC_SUBROUTINES.agc:487
//# DEBRIS -
// CONIC_SUBROUTINES.agc:488
//#	PARAMETERS WHICH MAY BE OF USE -
// CONIC_SUBROUTINES.agc:489
//#
// CONIC_SUBROUTINES.agc:490
//#			* SCALE FACTOR	*
// CONIC_SUBROUTINES.agc:491
//#	VARIABLE	*IN POWERS OF 2	*	DESCRIPTION AND REMARKS
// CONIC_SUBROUTINES.agc:492
//#	--------	*--------------	*	-----------------------
// CONIC_SUBROUTINES.agc:493
//#	R1 (32D)	* +29 FOR KERBIN	*	DP MAGNITUDE OF INITIAL POSITION VECTOR, RVEC, IN METERS
// CONIC_SUBROUTINES.agc:494
//#			* +27 FOR MUN	*
// CONIC_SUBROUTINES.agc:495
//#	R1A		* +6		*	DP RATIO OF R1 TO SEMIMAJOR AXIS (NEG. FOR HYPERBOLIC TRAJECTORIES)
// CONIC_SUBROUTINES.agc:496
//#	P		* +4		*	DP RATIO OF SEMILATUS RECTUM TO R1
// CONIC_SUBROUTINES.agc:497
//#	COGA		* +5		*	DP COTAN OF ANGLE BETWEEN RVEC AND VVEC
// CONIC_SUBROUTINES.agc:498
//#	UR1		* +1		*	DP UNIT VECTOR OF RVEC
// CONIC_SUBROUTINES.agc:499
//#	U2		* +1		*	DP UNIT VECTOR OF VVEC
// CONIC_SUBROUTINES.agc:500
//#	UN		* +1		*	DP UNIT VECTOR OF UR1*U2
// CONIC_SUBROUTINES.agc:501
//#	CSTH		* +1		*	DP COSINE OF TRUE ANOMALY DIFFERENCE BETWEEN RVEC AND RDESIRED.
// CONIC_SUBROUTINES.agc:502
//#	SNTH		* +1		*	DP SINE OF TRUE ANOMALY DIFFERENCE.
// CONIC_SUBROUTINES.agc:503
//#
// CONIC_SUBROUTINES.agc:504
//# 	PARAMETERS OF NO USE -
// CONIC_SUBROUTINES.agc:505
