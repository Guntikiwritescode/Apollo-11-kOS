// PORT: Physical bank 12. Shared continuation entries, slots 12562–12562.
function agcAotUnit741 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE CONIC_SUBROUTINES.agc:868
//		TC	POLY
// PORT: Fixed ROM slots 12562.
    if slot <> 12562 or instruction <> 3730 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3730, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[741] to agcAotUnit741@.

