//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:423
//		EBANK=	BCDU
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:424
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:425
//# THE THREE DESIRED CDU ANGLES MUST BE STORED AS SINGLE PRECISION TWO'S COMPLEMENT ANGLES IN THE THREE SUCCESSIVE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:426
//# LOCATIONS, CPHI, CTHETA, CPSI.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:427
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:428
//		COUNT*	$$/KALC
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:429
//KALCMAN3	TC	INTPRET		# PICK UP THE CURRENT CDU ANGLES AND
// PORT: Fixed ROM slots 20484.
    if slot <> 20484 or instruction <> 3103 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3103, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
