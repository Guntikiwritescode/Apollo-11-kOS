// PORT: Physical bank 22. Shared continuation entries, slots 20739–20743.
function agcAotUnit1278 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 20740 {
        if slot <= 20739 {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:727
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:728
//# INTERPRETIVE SUBROUTINE TO READ THE CDU ANGLES
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:729
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:730
//READCDUK	CA	CDUZ		# LOAD T(MPAC) WITH CDU ANGLES
// PORT: Fixed ROM slots 20739.
            if slot <> 20739 or instruction <> 12316 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                agcCoreCA(words, 28).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:731
//		TS	MPAC 	+2
// PORT: Fixed ROM slots 20740.
            if slot <> 20740 or instruction <> 22638 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 22638, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 20741 {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:732
//		EXTEND
// PORT: Fixed ROM slots 20741.
            if slot <> 20741 or instruction <> 6 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 6, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
            if slot <= 20742 {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:733
//		DCA	CDUX		# AND CHANGE MODE TO TRIPLE PRECISION
// PORT: Fixed ROM slots 20742.
                if slot <> 20742 or instruction <> 12315 { return choose false if checkOnly else -1. }
                if extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    if not agcCoreDoubleExchange(words, "DCA", 27, readPhysical, readAdjacent) { return -1. }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:734
//		TCF	TLOAD 	+6
// PORT: Fixed ROM slots 20743.
                if slot <> 20743 or instruction <> 7486 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 7486, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        }
    }
}
set agcAotRoutes[1278] to agcAotUnit1278@.

