// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:15
//# digitized images of a hardcopy from the MIT Museum.  The digitization
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:16
//# was performed by Paul Fjeld, and arranged for by Deborah Douglas of
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:17
//# the Museum.  Many thanks to both.  The images (with suitable reduction
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:18
//# in storage size and consequent reduction in image quality as well) are
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:19
//# available online at www.ibiblio.org/apollo.  If for some reason you
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:20
//# find that the images are illegible, contact me at info@sandroid.org
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:21
//# about getting access to the (much) higher-quality images which Paul
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:22
//# actually created.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:23
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:24
//# Notations on the hardcopy document read, in part:
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:25
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:26
//#	Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:27
//#	16:27 JULY 14, 1969
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:28
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:29
//# Page 342
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:30
//# BLOCK 2 LGC ATTITUDE MANEUVER ROUTINE -- KALCMANU
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:31
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:32
//# MOD 2		DATE 5/1/67	BY DON KEENE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:33
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:34
//# PROGRAM DESCRIPTION
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:35
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:36
//# KALCMANU IS A ROUTINE WHICH GENERATES COMMANDS FOR THE LM DAP TO CHANGE THE ATTITUDE OF THE SPACECRAFT
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:37
//# DURING FREE FALL.  IT IS DESIGNED TO MANEUVER THE SPACECRAFT FROM ITS INITIAL ORIENTATION TO SOME DESIRED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:38
//# ORIENTATION SPECIFIED BY THE PROGRAM WHICH CALLS KALCMANU, AVOIDING GIMBAL LOCK IN THE PROCESS.  IN THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:39
//# MOD 2 VERSION, THIS DESIRED ATTITUDE IS SPECIFIED BY A SET OF OF THREE COMMANDED CDU ANGLES STORES AS 2'S COMPLEMENT
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:40
//# SINGLE PRECISION ANGLES IN THE THREE CONSECUTIVE LOCATIONS, CPHI, CTHETA, CPSI, WHERE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:41
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:42
//#	CPHI = COMMANDED OUTER GIMBAL ANGLE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:43
//# 	CTHETA = COMMANDED INNER GIMBAL ANGLE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:44
//#	CPSI = COMMANDED MIDDLE GIMBAL ANGLE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:45
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:46
//# WHEN POINTING A SPACECRAFT AXIS (I.E., X, Y, Z, THE AOT, THRUST AXIS, ETC.) THE SUBROUTINE VECPOINT MAY BE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:47
//# USED TO GENERATE THIS SET OF DESIRED CDU ANGLES (SEE DESCRIPTION IN R60).
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:48
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:49
//# WITH THIS INFORMATION KALCMANU DETERMINES THE DIRECTION OF THE SINGLE EQUIVALENT ROTATION (COF ALSO U) AND THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:50
//# MAGNITUDE OF THE ROTATION (AM) TO BRING THE S/C FROM ITS INITIAL ORIENTATION TO ITS FINAL ORIENTATION.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:51
//# THIS DIRECTION REMAINS FIXED BOTH IN INERTIAL COORDINATES AND IN COMMANDED S/C AXES THROUGHOUT THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:52
//#                  _
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:53
//# MANEUVER.  ONCE COF AND AM HAVE BEEN DETERMINED, KALCMANU THEN EXAMINES THE MANEUVER TO SEE IF IT WILL BRING
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:54
//#				       _
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:55
//# THE S/C THROUGH GIMBAL LOCK.  IF SO, COF AND AM ARE READJUSTED SO THAT THE S/C WILL JUST SKIM THE GIMBAL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:56
//# LOCK ZONE AND ALIGN THE X-AXIS.  IN GENERAL A FINAL YAW ABOUT X WILL BE NECESSARY TO COMPLETE THE MANEUVER.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:57
//# NEEDLESS TO SAY, NEITHER THE INITIAL NOR THE FINAL ORIENTATION CAN BE IN GIMBAL LOCK.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:58
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:59
//# FOR PROPER ATTITUDE CONTROL THE DIGITAL AUTOPILOT MUST BE GIVEN AN ATTITUDE REFERENCE WHICH IT CAN TRACK.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:60
//# KALCMANU DOES THIS BY GENERATING A REFERENCE OF DESIRED GIMBAL ANGLES (CDUXD, CDUYD, CDUZD) WHICH ARE UPDATED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:61
//# EVERY ONE SECOND DURING THE MANEUVER.  TO ACHIEVE A SMOOTHER SEQUENCE OF COMMANDS BETWEEN SUCCESSIVE UPDATES,
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:62
//# THE PROGRAM ALSO GENERATES A SET OF INCREMENTAL CDU ANGLES (DELDCDU) TO BE ADDED TO CDU DESIRED BY THE DIGITAL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:63
//# AUTOPILOT.  KALCMANU ALSO CALCULATES THE COMPONENT MANEUVER RATES (OMEGAPD, OMEGAQD, OMEGARD), WHICH CAN
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:64
//#				      _
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:65
//# BE DETERMINED SIMPLY BY MULTIPLYING COF BY SOME SCALAR (ARATE) CORRESPONDING TO THE DESIRED ROTATIONAL RATE.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:66
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:67
//# AUTOMATIC MANEUVERS ARE TIMED WTH THE HELP OF WAITLIST SO THAT AFTER A SPECIFIED INTERVAL THE Y AND Z
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:68
//# DESIRED RATES ARE SET TO ZERO AND THE DESIRED CDU ANGLES (CDUYD, CDUZD) ARE SET EQUAL TO THE FINAL DESIRED CDU
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:69
//# ANGLES (CTHETA, CPSI).  IF ANY YAW REMAINS DUE TO GIMBAL LOCK AVOIDANCE, THE FINAL YAW MANEUVER IS
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:70
//# CALCULATED AND THE DESIRED YAW RATE SET TO SOME FIXED VALUE (ROLLRATE = + OR - 2 DEGREES PER SEC).
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:71
//# IN THIS CASE ONLY AN INCREMENTAL CDUX ANGLE (DELFROLL) IS SUPPLIED TO THE DAP.  AT THE END OF THE YAW
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:72
//# MANEUVER OR IN THE EVENT THAT THERE WAS NO FINAL YAW, CDUXD IS SET EQUAL TO CPHI AND THE X-AXIS DESIRED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:73
//# RATE SET TO ZERO.  THUS, UPON COMPLETION OF THE MANEUVER THE S/C WILL FINISH UP IN A LIMIT CYCLE ABOUT THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:74
//# DESIRED GIMBAL ANGLES.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:75
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:76
//# PROGRAM LOGIC FLOW
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:77
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:78
//# KALCMANU IS CALLED AS A HIGH PRIORITY JOB WITH ENTRY POINTS AT KALCMAN3 AND VECPOINT.  IT FIRST PICKS
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:79
//# UP THE CURRENT CDU ANGLES TO BE USED AS THE BASIS FOR ALL COMPUTATIONS INVOLVING THE INITIAL S/C ORIENTATION.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:80
//# Page 343
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:81
//# IT THEN DETERMINES THE DIRECTION COSINE MATRICES RELATING BOTH THE INITIAL AND FINAL S/C ORIENTATION TO STABLE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:82
//#               *   *                                                                               *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:83
//# MEMBER AXES (MIS,MFS).  IT ALSO COMPUTES THE MATRIX RELATING FINAL S/C AXES TO INITIAL S/C AXES (MFI).  THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:84
//# ANGLE OF ROTATION (AM) IS THEN EXTRACTED FROM THIS MATRIX, AND TEST ARE MADE TO DETERMINE IF
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:85
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:86
//#	A)	AM LESS THAN .25 DEGREES (MINANG)
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:87
//#	B)	AM GREATER THAN 170 DEGREES (MAXANG)
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:88
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:89
//# IF AM IS LESS THAN .25 DEGREES, NO COMPLICATED AUTOMATIC MANEUVERING IS NECESSARY.  THEREFORE, WE CAN SIMPLY
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:90
//# SET CDU DESIRED EQUAL TO THE FINAL CDU DESIRED ANGLES AND TERMINATE THE JOB.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:91
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:92
//# IF AM IS GREATER THAN .25 DEGREES BUT LESS THAN 170 DEGREES THE AXES OF THE SINGLE EQUIVALENT ROTATION
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:93
//#   _                                                       *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:94
//# (COF) IS EXTRACTED FROM THE SKEW SYMMETRIC COMPONENTS OF MFI.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:95
//#                                                                                     *     *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:96
//# IF AM GREATER THAN 170 DEGREES AN ALTERNATE METHOD EMPLOYING THE SYMMETRIC PART OF MFI (MFISYM) IS USED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:97
//#               _
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:98
//# TO DETERMINE COF.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:99
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:100
//# THE PROGRAM THEN CHECKS TO SEE IF THE MANEUVER AS COMPUTED WILL BRING THE S/C THROUGH GIMBAL LOCK.  IF
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:101
//# SO, A NEW MANEUVER IS CALCULATED WHICH WILL JUST SKIM THE GIMBAL LOCK ZONE AND ALIGN THE S/C X-AXIS.  THIS
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:102
//# METHOD ASSURES THAT THE ADDITIONAL MANEUVERING TO AVOID GIMBAL LOCK WILL BE KEPT TO A MINIMUM.  SINCE A FINAL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:103
//# P AXIS YAW WILL BE NECESSARY, A SWITCH IS RESET (STATE SWITCH 31) TO ALLOW FOR THE COMPUTATION OF THIS FINAL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:104
//# YAW.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:105
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:106
//# AS STATED PREVIOUSLY, KALCMANU GENERATES A SEQUENCE OF DESIRED GIMBAL ANGLES WHICH ARE UPDATED EVERY
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:107
//#                                                                                              _
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:108
//# SECOND.  THIS IS ACCOMPLISHED BY A SMALL ROTATION OF THE DESIRED S/C FRAME ABOUT THE VECTOR COF.  THE NEW
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:109
//# DESIRED REFERENCE MATRIX IS THEN,
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:110
//#	 *		 *	 *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:111
//#	MIS	=	MIS	DEL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:112
//#	   N+1		   N
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:113
//#        *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:114
//# WHERE DEL IS THE MATRIX CORRESPONDING TO THIS SMALL ROTATION.  THE NEW CDU ANGLES CAN THEN BE EXTRACTED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:115
//#       *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:116
//# FROM MIS.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:117
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:118
//# AT THE BEGINNING OF THE MANEUVER THE AUTOPILOT DESIRED RATES (OMEGAPD, OMEGAQD, OMEGARD) AND THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:119
//# MANEUVER TIMINGS ARE ESTABLISHED.  ON THE FIRST PASS AND ON ALL SUBSEQUENT UPDATES THE CDU DESIRED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:120
//# ANGLES ARE LOADED WITH THE APPROPRIATE VALUES AND THE INCREMENTAL CDU ANGLES ARE COMPUTED.  THE AGC CLOCKS
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:121
//# (TIME1 AND TIME2) ARE THEN CHECKED TO SEE IF THE MANEUVER WILL TERMINATE BEFORE THE NEXT UPDATE.  IF
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:122
//# NOT, KALCMANU CALLS FOR ANOTHER UPDATE (RUN AS A JOB WITH PRIORITY TBD) IN ONE SECOND.  ANY DELAYS IN THIS
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:123
//# CALLING SEQUENCE ARE AUTOMATICALLY COMPENSATED IN CALLING FOR THE NEXT UPDATE.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:124
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:125
//# IF IT IS FOUND THAT THE MANEUVER IS TO TERMINATE BEFORE THE NEXT UPDATE A ROUTINE IS CALLED (AS A WAIT-
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:126
//# LIST TASK) TO STOP THE MANEUVER AT THE APPROPRIATE TIME AS EXPLAINED ABOVE.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:127
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:128
//# Page 344
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:129
//# CALLING SEQUENCE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:130
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:131
//# IN ORDER TO PERFORM A KALCMANU SUPERVISED MANEUVER, THE COMMANDED GIMBAL ANGLES MUST BE PRECOMPUTED AND
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:132
//# STORED IN LOCATIONS CPHI, CTHETA, CPSI.  THE USER'S PROGRAM MUST THEN CLEAR STATE SWITCH NO 33 TO ALLOW THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:133
//# ATTITUDE MANEUVER ROUTINE TO PERFORM ANY FINAL P-AXIS YAW INCURRED BY AVOIDING GIMBAL LOCK.  THE MANEUVER IS
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:134
//# THEN INITIATED BY ESTABLISHING THE FOLLOWING EXECUTIVE JOB
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:135
//#		       *
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:136
//#	CAF	PRIO XX
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:137
//#		     --
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:138
//#	INHINT
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:139
//#	TC	FINDVAC
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:140
//#	2CADR	KALCMAN3
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:141
//#	RELINT
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:142
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:143
//# THE USER'S PROGRAM MAY EITHER CONTINUE OR WAIT FOR THE TERMINATION OF THE MANEUVER.  IF THE USER WISHES TO
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:144
//# WAIT, HE MAY PUT HIS JOB TO SLEEP WITH THE FOLLOWING INSTRUCTIONS:
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:145
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:146
//#	L	TC	BANKCALL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:147
//#	L+1	CADR	ATTSTALL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:148
//#	L+2	(BAD RETURN)
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:149
//#	L+3	(GOOD RETURN)
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:150
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:151
//# UPON COMPLETION OF THE MANEUVER, THE PROGRAM WILL BE AWAKENED AT L+3 IF THE MANEUVER WAS COMPLETED
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:152
//# SUCCESSFULLY, OR AT L+2 IF THE MANEUVER WAS ABORTED.  THIS ABORT WOULD OCCUR IF THE INITIAL OR FINAL ATTITUDE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:153
//# WAS IN GIMBAL LOCK.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:154
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:155
//# *** NOTA BENE ***  IF IT IS ASSUMED THAT THE DESIRED MANEUVERING RATE (0.5, 2, 5, 10 DEG/SEC) HAS BEEN SELECTED BY
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:156
//# KEYBOARD ENTRY PRIOR TO THE EXECUTION OF KALCMANU.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:157
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:158
//# IT IS ALSO ASSUMED THAT THE AUTOPILOT IS IN THE AUTO MODE.  IF THE MODE SWITCH IS CHANGED DURING THE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:159
//# MANEUVER, KALCMANU WILL TERMINATE VIA GOODEND WITHIN 1 SECOND SO THAT R60 MAY REQUEST A TRIM OF THE S/C ATTITUDE
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:160
//# SUBROUTINES.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:161
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:162
//# KALCMANU USES A NUMBER OF INTERPRETIVE SUBROUTINES WHICH MAY BE OF GENERAL INTEREST.  SINCE THESE ROUTINES
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:163
//# WERE PROGRAMMED EXCLUSIVELY FOR KALCMANU, THEY ARE NOT, AS YET, GENERALLY AVAILABLE FOR USE BY OTHER PROGRAMS.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:164
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:165
//# MXM3
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:166
//# ----
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:167
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:168
//# THIS SUBROUTINE MULTIPLIES TWO 3X3 MATRICES AND LEAVES THE RESULT IN THE FIRST 18 LOCATIONS OF THE PUSH
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:169
//# DOWN LIST, I.E.,
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:170
//#			[ M     M     M  ]
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:171
