//# Purpose: 	Part of the source code for Luminary 1A build 099.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:4
//#		It is part of the source code for the Lunar Module's (LM)
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:5
//#		Apollo Guidance Computer (AGC), for Apollo 11.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:6
//# Assembler:	yaYUL
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:7
//# Contact:	Ron Burkey <info@sandroid.org>.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:8
//# Website:	www.ibiblio.org/apollo.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:9
//# Pages:	342-363
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:10
//# Mod history:	2009-05-16 RSB	Adapted from the corresponding
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:11
//#				Luminary131 file, using page
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:12
//#				images from Luminary 1A.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:13
//#
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:14
