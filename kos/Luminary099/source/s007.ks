// PORT: Physical bank 22. Shared continuation entries, slots 20702–20702.
function agcAotUnit1268 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:677
//		INDEX	FIXLOC
// PORT: Fixed ROM slots 20702.
    if slot <> 20702 or instruction <> 20560 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 20560, words[0], readEffective).
    }
    if extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 20560, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
