// PORT: Physical bank 22. Shared continuation entries, slots 20956–20958.
function agcAotUnit1282 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 20956 {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:1015
//
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:1016
//		CAF	TWO
// PORT: Fixed ROM slots 20956.
        if slot <> 20956 or instruction <> 14826 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            local fixedOperand is mod(readEffective:call(words, 2538), 32768).
            set words[0] to agcSignExtend(fixedOperand).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
        if slot <= 20957 {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:1017
//		INHINT			# ALL RETURNS ARE NOW MADE VIA GOODEND
// PORT: Fixed ROM slots 20957.
            if slot <> 20957 or instruction <> 4 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 4, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:1018
//		TC	WAITLIST
// PORT: Fixed ROM slots 20958.
            if slot <> 20958 or instruction <> 2691 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 2691, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
set agcAotRoutes[1282] to agcAotUnit1282@.

