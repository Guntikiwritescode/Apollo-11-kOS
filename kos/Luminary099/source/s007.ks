// PORT: Physical bank 22. Shared continuation entries, slots 20949–20949.
function agcAotUnit1279 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE ATTITUDE_MANEUVER_ROUTINE.agc:1005
//		TC	ALARM
// PORT: Fixed ROM slots 20949.
    if slot <> 20949 or instruction <> 2935 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2935, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[1279] to agcAotUnit1279@.

