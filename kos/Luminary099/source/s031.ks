//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:29
//# ***	CHANNEL DESCRIPTIONSF WORDS ARE ALLOCATED IN ERASABLE ASSIGNMENTS ***
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:30
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:31
//#	CHANNEL 1	IDENTICAL TO COMPUTER REGISTER L (0001)
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:32
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:33
//#	CHANNEL 2	IDENTICAL TO COMPUTER REGISTER Q (0002)
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:34
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:35
//#	CHANNEL 3	HISCALAR; INPUT CHANNEL; MOST SIGNIFICANT 14 BITS FROM 33 STAGE BINARY COUNTER. SCALE
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:36
//#			FACTOR IS B23 IN CSEC, SO MAX VALUE ABOUT 23.3 HOURS AND LEAST SIGNIFICANT BIT 5.12 SECS.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:37
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:38
//#	CHANNEL 4	LOSCALAR; INPUT CHANNEL; NEXT MOST SIGNIFICANT 14 BITS FROM THE 33 STAGE BINARY COUNTER
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:39
//#			ASSOCIATED WITH CHANNEL 3. SCALE FACTOR IS B9 IN  CSEC. SO MAX VAL IS 5.12 SEC AND LEAST
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:40
//#			SIGNIFICANT BIT IS 1/3200 SEC. SCALE FACTOR OF D.P. WORD WITH CHANNEL 3 IS B23 CSEC.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:41
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:42
//#	CHANNEL 5	PYJETS; OUTPUT CHANNEL; PITCH RCS JET CONTROL.   (REACTION CONTROL SYSTEM) USES BITS 1-8.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:43
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:44
//#	CHANNEL 6	ROLLJETS; OUTPUT CHANNEL; ROLL RCS JET CONTROL.   (REACTION CONTROL SYSTEM) USES BIT 1-8.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:45
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:46
//#	CHANNEL 7	SUPERBNK; OUTPUT CHANNEL; NOT RESET BY RESTART;   FIXED EXTENSION BITS USED TO SELECT THE
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:47
//#			APPROPRIATE FIXED MEMORY BANK IF FBANK IS 30 OCTAL OR MORE. USES BITS 5-7.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:48
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:49
//#	CHANNEL 10	OUT0; OUTPUT CHANNEL; REGISTER USED TO TRANSMIT    LATCHING-RELAY DRIVING INFORMATION FOR
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:50
//#			THE DISPLAY SYSTEM.  BITS 15-12 ARE SET TO THE ROW NUMBER (1-14 OCTAL) OF THE RELAY TO BE
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:51
//#			CHANGED AND BITS 11-1 CONTAIN THE REQUIRED SETTINGS FOR THE RELAYS IN THE ROW.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:52
//
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:53
//#	CHANNEL 11	DSALMOUT; OUTPUT CHANNEL; REGISTER WHOSE BITS ARE USED FOR ENGINE ON-OFF CONTROL AND TO
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:54
//#			DRIVE INDIVIDUAL INDICATORS OF THE DISPLAY SYSTEM. BITS 1-7 ARE A RELAYS.
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:55
//#
// PORT: SOURCE INPUT_OUTPUT_CHANNEL_BIT_DESCRIPTIONS.agc:56
