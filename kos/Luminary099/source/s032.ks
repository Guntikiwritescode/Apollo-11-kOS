// PORT: Physical bank 13. Shared continuation entries, slots 14228–14234.
function agcAotUnit795 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 14230 {
        if slot <= 14228 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:978
//
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:979
//		INHINT
// PORT: Fixed ROM slots 14228.
            if slot <> 14228 or instruction <> 4 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 4, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
            if slot <= 14229 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:980
//		EXTEND
// PORT: Fixed ROM slots 14229.
                if slot <> 14229 or instruction <> 6 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 6, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:981
//		DCS	TIME2
// PORT: Fixed ROM slots 14230.
                if slot <> 14230 or instruction <> 16405 { return choose false if checkOnly else -1. }
                if extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    if not agcCoreDoubleExchange(words, "DCS", 21, readPhysical, readAdjacent) { return -1. }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        }
    } else {
        if slot <= 14232 {
            if slot <= 14231 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:982
//		DAS	MPAC
// PORT: Fixed ROM slots 14231.
                if slot <> 14231 or instruction <> 8301 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    if not agcCoreDas(words, 109) { return -1. }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:983
//		TC	TPAGREE
// PORT: Fixed ROM slots 14232.
                if slot <> 14232 or instruction <> 3759 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 3759, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 14233 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:984
//
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:985
//		CA	IRETURN1
// PORT: Fixed ROM slots 14233.
                if slot <> 14233 or instruction <> 13284 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCA(words, 996).
                    return list(false, false, inheritedTransient, false, false).
                }
