// PORT: Physical bank 13. Shared continuation entries, slots 13854–13857.
function agcAotUnit783 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 13855 {
        if slot <= 13854 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:460
//SETBANK		CAF	INTBANK
// PORT: Fixed ROM slots 13854.
            if slot <> 13854 or instruction <> 13858 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                local fixedOperand is mod(readEffective:call(words, 1570), 32768).
                set words[0] to agcSignExtend(fixedOperand).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:461
//		TS	BBANK
// PORT: Fixed ROM slots 13855.
            if slot <> 13855 or instruction <> 22534 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 22534, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 13856 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:462
//		CAF	FORTYONE
// PORT: Fixed ROM slots 13856.
            if slot <> 13856 or instruction <> 14122 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                local fixedOperand is mod(readEffective:call(words, 1834), 32768).
                set words[0] to agcSignExtend(fixedOperand).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:463
//		TC	Q
// PORT: Fixed ROM slots 13857.
            if slot <> 13857 or instruction <> 2 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 2, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    }
}
set agcAotRoutes[783] to agcAotUnit783@.

