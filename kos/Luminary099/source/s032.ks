// PORT: Physical bank 13. Shared continuation entries, slots 13983–13984.
function agcAotUnit787 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 13983 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:666
//		CA	MPAC
// PORT: Fixed ROM slots 13983.
        if slot <> 13983 or instruction <> 12396 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreCA(words, 108).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:667
//		INDEX	FIXLOC
// PORT: Fixed ROM slots 13984.
        if slot <> 13984 or instruction <> 20560 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        if extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 20560, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
