//# about getting access to the (much) higher-quality images which Paul
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:23
//# actually created.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:24
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:25
//# Notations on the hardcopy document read, in part:
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:26
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:27
//#	Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:28
//#	16:27 JULY 14, 1969
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:29
//
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:30
//# Page 1205
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:31
//# 1.0 INTRODUCTION
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:32
//# ----------------
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:33
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:34
//# FROM A USER'S POINT OF VIEW, ORBITAL INTEGRATION IS ESSENTIALLY THE SAME AS THE 278 INTEGRATION
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:35
//# PROGRAM.  THE SAME ENTRANCES TO THE PROGRAM WILL BE MAINTAINED, THE SAME STALLING ROUTINE WILL BE USED AND
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:36
//# OUTPUT WILL STILL BE VIA THE PUSHLIST.  THE PRIMARY DIFFERENCES TO A USER INVOLVE THE ADDED CAPABILITY OF
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:37
//# TERMINATING INTEGRATION AT A SPECIFIC FINAL RADIUS AND THE DIFFERENCE IN STATE VECTOR SCALING INSIDE AND OUTSIDE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:38
//# THE LUNAR SPHERE OF INFLUENCE.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:39
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:40
//# IN ORDER TO MAKE THE CSM(LEM)PREC AND CSM(LEM)CONIC ENTRANCES SIMILAR TO FLIGHT 278, THE INTEGRATION PROGRAM
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:41
//# WILL ITSELF SET THE FINAL RADIUS (RFINAL) TO 0 SO THAT REACHING THE DESIRED TIME ONLY WILL TERMINATE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:42
//# INTEGRATION.  THE DP REGISTER RFINAL MUST BE SET BY USERS OF INTEGRVS AND INTEGRV, AND MUST BE DONE AFTER THE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:43
//# CALL TC INTSTALL.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:44
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:45
//# WHEN THE LM IS ON THE LUNAR SURFACE (INDICATED BY LUNAR SURFACE FLAG SET) CALLS TO LEMCONIC, LEMPREC, AND
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:46
//# INTEGRV WITH VINFLAG = 0 WILL RESULT IN THE USE OF THE PLANETARY INERTIAL ORIENTATION SUBROUTINES TO PROVIDE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:47
//# BOTH THE LM'S POSITION AND VELOCITY IN THE REFERENCE COORDINATE SYSTEM.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:48
//# THE PROGRAM WILL PROVIDE OUTPUT AS IF INTEGRATION WAS USED.  THAT IS, THE PUSHLIST WILL BE SET AS NOTED BELOW AND
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:49
//# THE PERMANENT STATE VECTOR UPDATED WHEN SPECIFIED BY AN INTEGRV CALL.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:50
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:51
//# USERS OF INTEGRVS DESIRING INTEGRATION (INTYPFLG = 0) SHOULD NOTE THAT THE OBLATENESS PERTURBATION COMPUTATION
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:52
//# IN LUNAR ORBIT IS TIME DEPENDENT.  THEREFORE, THE USER SHOULD SUPPLY AN INITIAL STATE VECTOR VALID AT SOME REAL
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:53
//# TIME AND THE DESIRED TIME (TDEC1) ALSO AT SOME REAL TIME.  FOR CONIC "INTEGRATION" THE USER MAY STILL USE ZERO
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:54
//# AS THE INITIAL TIME AND DELTA TIME AS THE DESIRED TIME.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:55
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:56
//# 2.0 GENERAL DESCRIPTION
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:57
//# -----------------------
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:58
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:59
//# THE INTEGRATION PROGRAM OPERATES AS A CLOSED INTERPRETIVE SUBROUTINE AND PERFORMS THESE FUNCTIONS --
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:60
//#	1) INTEGRATES (PRECISION OR CONIC) EITHER CSM OR LM STATE VECTOR
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:61
//#	2) INTEGRATES THE W-MATRIX
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:62
//#	3) PERMANENT OR TEMPORARY UPDATE OF THE STATE VECTOR
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:63
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:64
//# THERE ARE SIX ENTRANCES TO THE INTEGRATION PROGRAM.  FOUR OF THESE (CSMPREC, LEMPREC, CSMCONIC, LEMCONIC) SET
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:65
//# ALL THE FLAGS REQUIRED IN THE INTEGRATION PROGRAM ITSELF TO CAUSE THE PRECISION OR CONIC INTEGRATION (KEPLER) OF
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:66
//# THE LM OR CSM STATE VECTOR, AS THE NAMES SUGGEST.  ONE ENTRANCE (INTEGRVS) PERMITS THE CALLING PROGRAM TO
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:67
//# PROVIDE A STATE VECTOR TO BE INTEGRATED.  THE CALLING PROGRAM MUST SET THE FLAGS INDICATING (1) PRECISION OR
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:68
//# CONIC INTEGRATION, (2) IN OR OUT OF LUNAR SPHERE, (3) MIDCOURSE OR NOT, AND THE INTEGRATION PROGRAM COMPLETES
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:69
//# THE FLAG SETTING TO BYPASS W-MATRIX INTEGRATION.  THE LAST ENTRANCE (INTEGRV, USED IN GENERAL BY THE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:70
//# NAVIGATION PROGRAMS) PERMITS THE CALLER TO SET FIVE FLAGS (NOT MOONFLAG OR MIDFLAG) BUT NOT TO INPUT A STATE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:71
//# VECTOR.  ANY PROGRAM WHICH CALLS INTEGRVS OR INTEGRV MUST CALL INTSTALL BEFORE IT SETS THE INTEGRATION FLAGS
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:72
//# AND/OR STATE VECTOR.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:73
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:74
//# THREE SETS OF 42 REGISTERS AND 2 FLAGS ARE USED FOR THE STATE VECTORS.  TWO SETS, WHICH MAY NOT BE OVERLAYED, ARE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:75
//# USED FOR THE PERMANENT STATE VECTORS FOR THE CSM AND LM.  THE THIRD SET, WHICH MAY BE OVERLAYED WHEN INTEGRATION
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:76
//# IS NOT BEING DONE, IS USED IN THE COMPUTATIONS.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:77
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:78
//# THE PERMANENT STATE VECTORS WILL BE PERIODICALLY UPDATED SO THAT THE VECTORS WILL NOT BE OLDER THAN 4 TIMESTEPS.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:79
//# THE PERMANENT STATE VECTORS WILL ALSO BE UPDATED WHENEVER THE W-MATRIX IS INTEGRATED OR WHEN A CALLER OF INTEGRV
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:80
//# SETS STATEFLG (THE NAVIGATION PROGRAMS P20, P22.)
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:81
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:82
//# Page 1206
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:83
//# APPENDIX B OF THE USERS' GUIDE LISTS THE STATE VECTOR QUANTITIES.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:84
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:85
//# 2.1 RESTARTS
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:86
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:87
//# PHASE CHANGES WILL BE MADE IN THE INTEGRATION PROGRAM ONLY FOR THE INTEGRV ENTRANCE (I.E., WHEN THE W-MATRIX IS
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:88
//# INTEGRATED OR PERMANENT STATE VECTOR IS UPDATED.)  THE GROUP NUMBER USED WILL BE THAT FOR THE P20-25 PROGRAMS
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:89
//# (I.E., GROUP2) WINCE THE INTEGRV ENTRANCE WILL ONLY BE USED BY THESE PROGRAMS.  IF A RESTART OCCURS DURING AN
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:90
//# INTEGRATION OF THE STATE VECTOR ONLY, THE RECOVERY WILL BE TO THE LAST PHASE IN THE CALLING PROGRAM.  CALLING
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:91
//# PROGRAMS WHICH USE THE INTEGRV OR INTEGRVS ENTRANCE OF INTEGRATION WHOULD ENSURE THAT IF PHASE CHANGING IS DONE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:92
//# THAT IT IS PRIOR TO SETTING THE INTEGRATION INPUTS IN THE PUSHLIST.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:93
//# THIS IS BECAUSE THE PUSHLIST IS LOST DURING A RESTART.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:94
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:95
//# 2.2 SCALING
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:96
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:97
//# THE INTEGRATION ROUTINE WILL MAINTAIN THE PERMANENT MEMORY STATE VECTORS IN THE SCALING AND UNITS DEFINED IN
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:98
//# APPENDIX B OF THE USERS GUIDE.  THE SCALING OF THE OUTPUT POSITION VECTOR DEPENDS ON THE ORIGIN OF THE COORDINATE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:99
//# SYSTEM AT THE DESIRED INTEGRATION TIME.  THE COORDINATE SYSTEM TRANSFORMATION WILL BE DONE AUTOMATICALLY ON
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:100
//# MULTIPLE TIMESTEP ENCKE INTEGRATION ONLY.  THUS IT IS POSSIBLE TO HAVE OUTPUT FROM SUCCESSIVE INTEGRATIONS IN
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:101
//# DIFFERENT SCALING.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:102
//# HOWEVER, RATT, VATT WILL ALWAYS BE SCALED THE SAME.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:103
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:104
//# 3.0 INPUT/OUTPUT
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:105
//# ----------------
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:106
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:107
//# PROGRAM INPUTS ARE THE FLAGS DESCRIBED IN APPENDIX A AND THE PERMANENT STATE VECTOR QUANTITIES DESCRIBED IN
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:108
//# APPENDIX B OF THE USERS GUIDE, PLUS THE DESIRED TIME TO INTEGRATE TO IN TDEC1 (A PUSH LIST LOCATION).
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:109
//# FOR INTEGRVS, THE RCV,VCV,TET OR THE TEMPORARY STATE VECTOR MUST BE SET, PLUS MOONFLAG AND MIDFLAG
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:110
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:111
//# FOR SIMULATION THE FOLLOWING QUANTITIES MUST BE PRESET ---
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:112
//#										EARTH	MOON
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:113
//#										 29	 27
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:114
//#	RRECTCSM(LEM) 		RECTIFIED POSITION VECTOR	METERS		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:115
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:116
//#										 7	 5
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:117
//#	VRECTCSM(LEM)		RECTIFIED VELOCITY VECTOR	M/CSEC		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:118
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:119
//#										 28	 28
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:120
//#	TETCSM(LEM)		TIME STATE VECTOR IS VALID	CSEC		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:121
//#				CUSTOMARILY 0, BUT NOTE LUNAR
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:122
//#				ORBIT DEPENDENCE ON REAL TIME.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:123
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:124
//#										 22	 18
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:125
//#	DELTAVCSM(LEM)		POSITION DEVIATION		METERS		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:126
//#				0 IF TCCSM(LEM) = 0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:127
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:128
//#										 3	 -1
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:129
//#	NUVCSM(LEM)		VELOCITY DEVIATION		M/CSEC		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:130
//#				0 IF TCCSM(LEM) = 0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:131
//# Page 1207
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:132
//#										 29	 27
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:133
//#	RCVSM(LEM)		CONIC POSITION			METERS		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:134
//#				EQUALS RRECTCSM(LEM) IF
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:135
//#				TCCSM(LEM) = 0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:136
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:137
//#										 7	 5
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:138
//#	VCVCSM(LEM)		CONIC VELOCITY			M/CSEC		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:139
//#				EQUALS VRECTCSM(LEM) IF
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:140
//#				TCCSM(LEM) = 0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:141
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:142
//#										 28	 28
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:143
//#	TCCSM(LEM)		TIME SINCE RECTIFICATION	CSECS		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:144
//#				CUSTOMARILY 0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:145
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:146
//#								 1/2		 17	 16
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:147
//#	XKEPCSM(LEM)		ROOT OF KEPLER'S EQUATION	M		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:148
//#				0 IF TCCSM(LEM) = 0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:149
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:150
//#	CMOONFLG		PERMANENT FLAGS CORRESPONDING			0	0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:151
//#	CMIDFLAG		TO MOONFLAG AND MIDFLAG				0,1	0,1
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:152
//#	LMOONFLG		C = CSM, L = LM					0	0
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:153
//#	LMIDFLG									0,1	0,1
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:154
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:155
//#	SURFFLAG		LUNAR SURFACE FLAG				0,1	0,1
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:156
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:157
//# IN ADDITION, IF (L)CMIDFLAG IS SET, THE INITIAL INPUT VALUES FOR LUNAR
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:158
//# SOLAR EPHEMERIDES SUBROUTINE AND PLANETARY INERTIAL ORIENTATION SUB-
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:159
//# ROUTINE MUST BE PRESET.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:160
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:161
//# OUTPUT
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:162
//#	AFTER EVERY CALL TO INTEGRATION
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:163
//#									EARTH	MOON
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:164
//#									 29	 29
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:165
//#	0D	RATT	POSITION			METERS		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:166
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:167
//#									 7	 7
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:168
