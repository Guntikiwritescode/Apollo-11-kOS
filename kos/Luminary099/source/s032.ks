//# actually created.
// INTEGRATION_INITIALIZATION.agc:24
//#
// INTEGRATION_INITIALIZATION.agc:25
//# Notations on the hardcopy document read, in part:
// INTEGRATION_INITIALIZATION.agc:26
//#
// INTEGRATION_INITIALIZATION.agc:27
//#	Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// INTEGRATION_INITIALIZATION.agc:28
//#	16:27 JULY 14, 1969
// INTEGRATION_INITIALIZATION.agc:29
//
// INTEGRATION_INITIALIZATION.agc:30
//# Page 1205
// INTEGRATION_INITIALIZATION.agc:31
//# 1.0 INTRODUCTION
// INTEGRATION_INITIALIZATION.agc:32
//# ----------------
// INTEGRATION_INITIALIZATION.agc:33
//#
// INTEGRATION_INITIALIZATION.agc:34
//# FROM A USER'S POINT OF VIEW, ORBITAL INTEGRATION IS ESSENTIALLY THE SAME AS THE 278 INTEGRATION
// INTEGRATION_INITIALIZATION.agc:35
//# PROGRAM.  THE SAME ENTRANCES TO THE PROGRAM WILL BE MAINTAINED, THE SAME STALLING ROUTINE WILL BE USED AND
// INTEGRATION_INITIALIZATION.agc:36
//# OUTPUT WILL STILL BE VIA THE PUSHLIST.  THE PRIMARY DIFFERENCES TO A USER INVOLVE THE ADDED CAPABILITY OF
// INTEGRATION_INITIALIZATION.agc:37
//# TERMINATING INTEGRATION AT A SPECIFIC FINAL RADIUS AND THE DIFFERENCE IN STATE VECTOR SCALING INSIDE AND OUTSIDE
// INTEGRATION_INITIALIZATION.agc:38
//# THE MUN SPHERE OF INFLUENCE.
// INTEGRATION_INITIALIZATION.agc:39
//#
// INTEGRATION_INITIALIZATION.agc:40
//# IN ORDER TO MAKE THE CSM(LEM)PREC AND CSM(LEM)CONIC ENTRANCES SIMILAR TO FLIGHT 278, THE INTEGRATION PROGRAM
// INTEGRATION_INITIALIZATION.agc:41
//# WILL ITSELF SET THE FINAL RADIUS (RFINAL) TO 0 SO THAT REACHING THE DESIRED TIME ONLY WILL TERMINATE
// INTEGRATION_INITIALIZATION.agc:42
//# INTEGRATION.  THE DP REGISTER RFINAL MUST BE SET BY USERS OF INTEGRVS AND INTEGRV, AND MUST BE DONE AFTER THE
// INTEGRATION_INITIALIZATION.agc:43
//# CALL TC INTSTALL.
// INTEGRATION_INITIALIZATION.agc:44
//#
// INTEGRATION_INITIALIZATION.agc:45
//# WHEN THE LM IS ON THE MUN SURFACE (INDICATED BY MUN SURFACE FLAG SET) CALLS TO LEMCONIC, LEMPREC, AND
// INTEGRATION_INITIALIZATION.agc:46
//# INTEGRV WITH VINFLAG = 0 WILL RESULT IN THE USE OF THE PLANETARY INERTIAL ORIENTATION SUBROUTINES TO PROVIDE
// INTEGRATION_INITIALIZATION.agc:47
//# BOTH THE LM'S POSITION AND VELOCITY IN THE REFERENCE COORDINATE SYSTEM.
// INTEGRATION_INITIALIZATION.agc:48
//# THE PROGRAM WILL PROVIDE OUTPUT AS IF INTEGRATION WAS USED.  THAT IS, THE PUSHLIST WILL BE SET AS NOTED BELOW AND
// INTEGRATION_INITIALIZATION.agc:49
//# THE PERMANENT STATE VECTOR UPDATED WHEN SPECIFIED BY AN INTEGRV CALL.
// INTEGRATION_INITIALIZATION.agc:50
//#
// INTEGRATION_INITIALIZATION.agc:51
//# USERS OF INTEGRVS DESIRING INTEGRATION (INTYPFLG = 0) SHOULD NOTE THAT THE OBLATENESS PERTURBATION COMPUTATION
// INTEGRATION_INITIALIZATION.agc:52
//# IN MUN ORBIT IS TIME DEPENDENT.  THEREFORE, THE USER SHOULD SUPPLY AN INITIAL STATE VECTOR VALID AT SOME REAL
// INTEGRATION_INITIALIZATION.agc:53
//# TIME AND THE DESIRED TIME (TDEC1) ALSO AT SOME REAL TIME.  FOR CONIC "INTEGRATION" THE USER MAY STILL USE ZERO
// INTEGRATION_INITIALIZATION.agc:54
//# AS THE INITIAL TIME AND DELTA TIME AS THE DESIRED TIME.
// INTEGRATION_INITIALIZATION.agc:55
//#
// INTEGRATION_INITIALIZATION.agc:56
//# 2.0 GENERAL DESCRIPTION
// INTEGRATION_INITIALIZATION.agc:57
//# -----------------------
// INTEGRATION_INITIALIZATION.agc:58
//#
// INTEGRATION_INITIALIZATION.agc:59
//# THE INTEGRATION PROGRAM OPERATES AS A CLOSED INTERPRETIVE SUBROUTINE AND PERFORMS THESE FUNCTIONS --
// INTEGRATION_INITIALIZATION.agc:60
//#	1) INTEGRATES (PRECISION OR CONIC) EITHER CSM OR LM STATE VECTOR
// INTEGRATION_INITIALIZATION.agc:61
//#	2) INTEGRATES THE W-MATRIX
// INTEGRATION_INITIALIZATION.agc:62
//#	3) PERMANENT OR TEMPORARY UPDATE OF THE STATE VECTOR
// INTEGRATION_INITIALIZATION.agc:63
//#
// INTEGRATION_INITIALIZATION.agc:64
//# THERE ARE SIX ENTRANCES TO THE INTEGRATION PROGRAM.  FOUR OF THESE (CSMPREC, LEMPREC, CSMCONIC, LEMCONIC) SET
// INTEGRATION_INITIALIZATION.agc:65
//# ALL THE FLAGS REQUIRED IN THE INTEGRATION PROGRAM ITSELF TO CAUSE THE PRECISION OR CONIC INTEGRATION (KEPLER) OF
// INTEGRATION_INITIALIZATION.agc:66
//# THE LM OR CSM STATE VECTOR, AS THE NAMES SUGGEST.  ONE ENTRANCE (INTEGRVS) PERMITS THE CALLING PROGRAM TO
// INTEGRATION_INITIALIZATION.agc:67
//# PROVIDE A STATE VECTOR TO BE INTEGRATED.  THE CALLING PROGRAM MUST SET THE FLAGS INDICATING (1) PRECISION OR
// INTEGRATION_INITIALIZATION.agc:68
//# CONIC INTEGRATION, (2) IN OR OUT OF MUN SPHERE, (3) MIDCOURSE OR NOT, AND THE INTEGRATION PROGRAM COMPLETES
// INTEGRATION_INITIALIZATION.agc:69
//# THE FLAG SETTING TO BYPASS W-MATRIX INTEGRATION.  THE LAST ENTRANCE (INTEGRV, USED IN GENERAL BY THE
// INTEGRATION_INITIALIZATION.agc:70
//# NAVIGATION PROGRAMS) PERMITS THE CALLER TO SET FIVE FLAGS (NOT MOONFLAG OR MIDFLAG) BUT NOT TO INPUT A STATE
// INTEGRATION_INITIALIZATION.agc:71
//# VECTOR.  ANY PROGRAM WHICH CALLS INTEGRVS OR INTEGRV MUST CALL INTSTALL BEFORE IT SETS THE INTEGRATION FLAGS
// INTEGRATION_INITIALIZATION.agc:72
//# AND/OR STATE VECTOR.
// INTEGRATION_INITIALIZATION.agc:73
//#
// INTEGRATION_INITIALIZATION.agc:74
//# THREE SETS OF 42 REGISTERS AND 2 FLAGS ARE USED FOR THE STATE VECTORS.  TWO SETS, WHICH MAY NOT BE OVERLAYED, ARE
// INTEGRATION_INITIALIZATION.agc:75
//# USED FOR THE PERMANENT STATE VECTORS FOR THE CSM AND LM.  THE THIRD SET, WHICH MAY BE OVERLAYED WHEN INTEGRATION
// INTEGRATION_INITIALIZATION.agc:76
//# IS NOT BEING DONE, IS USED IN THE COMPUTATIONS.
// INTEGRATION_INITIALIZATION.agc:77
//#
// INTEGRATION_INITIALIZATION.agc:78
//# THE PERMANENT STATE VECTORS WILL BE PERIODICALLY UPDATED SO THAT THE VECTORS WILL NOT BE OLDER THAN 4 TIMESTEPS.
// INTEGRATION_INITIALIZATION.agc:79
//# THE PERMANENT STATE VECTORS WILL ALSO BE UPDATED WHENEVER THE W-MATRIX IS INTEGRATED OR WHEN A CALLER OF INTEGRV
// INTEGRATION_INITIALIZATION.agc:80
//# SETS STATEFLG (THE NAVIGATION PROGRAMS P20, P22.)
// INTEGRATION_INITIALIZATION.agc:81
//#
// INTEGRATION_INITIALIZATION.agc:82
//# Page 1206
// INTEGRATION_INITIALIZATION.agc:83
//# APPENDIX B OF THE USERS' GUIDE LISTS THE STATE VECTOR QUANTITIES.
// INTEGRATION_INITIALIZATION.agc:84
//#
// INTEGRATION_INITIALIZATION.agc:85
//# 2.1 RESTARTS
// INTEGRATION_INITIALIZATION.agc:86
//#
// INTEGRATION_INITIALIZATION.agc:87
//# PHASE CHANGES WILL BE MADE IN THE INTEGRATION PROGRAM ONLY FOR THE INTEGRV ENTRANCE (I.E., WHEN THE W-MATRIX IS
// INTEGRATION_INITIALIZATION.agc:88
//# INTEGRATED OR PERMANENT STATE VECTOR IS UPDATED.)  THE GROUP NUMBER USED WILL BE THAT FOR THE P20-25 PROGRAMS
// INTEGRATION_INITIALIZATION.agc:89
//# (I.E., GROUP2) WINCE THE INTEGRV ENTRANCE WILL ONLY BE USED BY THESE PROGRAMS.  IF A RESTART OCCURS DURING AN
// INTEGRATION_INITIALIZATION.agc:90
//# INTEGRATION OF THE STATE VECTOR ONLY, THE RECOVERY WILL BE TO THE LAST PHASE IN THE CALLING PROGRAM.  CALLING
// INTEGRATION_INITIALIZATION.agc:91
//# PROGRAMS WHICH USE THE INTEGRV OR INTEGRVS ENTRANCE OF INTEGRATION WHOULD ENSURE THAT IF PHASE CHANGING IS DONE
// INTEGRATION_INITIALIZATION.agc:92
//# THAT IT IS PRIOR TO SETTING THE INTEGRATION INPUTS IN THE PUSHLIST.
// INTEGRATION_INITIALIZATION.agc:93
//# THIS IS BECAUSE THE PUSHLIST IS LOST DURING A RESTART.
// INTEGRATION_INITIALIZATION.agc:94
//#
// INTEGRATION_INITIALIZATION.agc:95
//# 2.2 SCALING
// INTEGRATION_INITIALIZATION.agc:96
//#
// INTEGRATION_INITIALIZATION.agc:97
//# THE INTEGRATION ROUTINE WILL MAINTAIN THE PERMANENT MEMORY STATE VECTORS IN THE SCALING AND UNITS DEFINED IN
// INTEGRATION_INITIALIZATION.agc:98
//# APPENDIX B OF THE USERS GUIDE.  THE SCALING OF THE OUTPUT POSITION VECTOR DEPENDS ON THE ORIGIN OF THE COORDINATE
// INTEGRATION_INITIALIZATION.agc:99
//# SYSTEM AT THE DESIRED INTEGRATION TIME.  THE COORDINATE SYSTEM TRANSFORMATION WILL BE DONE AUTOMATICALLY ON
// INTEGRATION_INITIALIZATION.agc:100
//# MULTIPLE TIMESTEP ENCKE INTEGRATION ONLY.  THUS IT IS POSSIBLE TO HAVE OUTPUT FROM SUCCESSIVE INTEGRATIONS IN
// INTEGRATION_INITIALIZATION.agc:101
//# DIFFERENT SCALING.
// INTEGRATION_INITIALIZATION.agc:102
//# HOWEVER, RATT, VATT WILL ALWAYS BE SCALED THE SAME.
// INTEGRATION_INITIALIZATION.agc:103
//#
// INTEGRATION_INITIALIZATION.agc:104
//# 3.0 INPUT/OUTPUT
// INTEGRATION_INITIALIZATION.agc:105
//# ----------------
// INTEGRATION_INITIALIZATION.agc:106
//#
// INTEGRATION_INITIALIZATION.agc:107
//# PROGRAM INPUTS ARE THE FLAGS DESCRIBED IN APPENDIX A AND THE PERMANENT STATE VECTOR QUANTITIES DESCRIBED IN
// INTEGRATION_INITIALIZATION.agc:108
//# APPENDIX B OF THE USERS GUIDE, PLUS THE DESIRED TIME TO INTEGRATE TO IN TDEC1 (A PUSH LIST LOCATION).
// INTEGRATION_INITIALIZATION.agc:109
//# FOR INTEGRVS, THE RCV,VCV,TET OR THE TEMPORARY STATE VECTOR MUST BE SET, PLUS MOONFLAG AND MIDFLAG
// INTEGRATION_INITIALIZATION.agc:110
//#
// INTEGRATION_INITIALIZATION.agc:111
//# FOR SIMULATION THE FOLLOWING QUANTITIES MUST BE PRESET ---
// INTEGRATION_INITIALIZATION.agc:112
//#										KERBIN	MUN
// INTEGRATION_INITIALIZATION.agc:113
//#										 29	 27
// INTEGRATION_INITIALIZATION.agc:114
//#	RRECTCSM(LEM) 		RECTIFIED POSITION VECTOR	METERS		2	2
// INTEGRATION_INITIALIZATION.agc:115
//#
// INTEGRATION_INITIALIZATION.agc:116
//#										 7	 5
// INTEGRATION_INITIALIZATION.agc:117
//#	VRECTCSM(LEM)		RECTIFIED VELOCITY VECTOR	M/CSEC		2	2
// INTEGRATION_INITIALIZATION.agc:118
//#
// INTEGRATION_INITIALIZATION.agc:119
//#										 28	 28
// INTEGRATION_INITIALIZATION.agc:120
//#	TETCSM(LEM)		TIME STATE VECTOR IS VALID	CSEC		2	2
// INTEGRATION_INITIALIZATION.agc:121
//#				CUSTOMARILY 0, BUT NOTE MUN
// INTEGRATION_INITIALIZATION.agc:122
//#				ORBIT DEPENDENCE ON REAL TIME.
// INTEGRATION_INITIALIZATION.agc:123
//#
// INTEGRATION_INITIALIZATION.agc:124
//#										 22	 18
// INTEGRATION_INITIALIZATION.agc:125
//#	DELTAVCSM(LEM)		POSITION DEVIATION		METERS		2	2
// INTEGRATION_INITIALIZATION.agc:126
//#				0 IF TCCSM(LEM) = 0
// INTEGRATION_INITIALIZATION.agc:127
//#
// INTEGRATION_INITIALIZATION.agc:128
//#										 3	 -1
// INTEGRATION_INITIALIZATION.agc:129
//#	NUVCSM(LEM)		VELOCITY DEVIATION		M/CSEC		2	2
// INTEGRATION_INITIALIZATION.agc:130
//#				0 IF TCCSM(LEM) = 0
// INTEGRATION_INITIALIZATION.agc:131
//# Page 1207
// INTEGRATION_INITIALIZATION.agc:132
//#										 29	 27
// INTEGRATION_INITIALIZATION.agc:133
//#	RCVSM(LEM)		CONIC POSITION			METERS		2	2
// INTEGRATION_INITIALIZATION.agc:134
//#				EQUALS RRECTCSM(LEM) IF
// INTEGRATION_INITIALIZATION.agc:135
//#				TCCSM(LEM) = 0
// INTEGRATION_INITIALIZATION.agc:136
//#
// INTEGRATION_INITIALIZATION.agc:137
//#										 7	 5
// INTEGRATION_INITIALIZATION.agc:138
//#	VCVCSM(LEM)		CONIC VELOCITY			M/CSEC		2	2
// INTEGRATION_INITIALIZATION.agc:139
//#				EQUALS VRECTCSM(LEM) IF
// INTEGRATION_INITIALIZATION.agc:140
//#				TCCSM(LEM) = 0
// INTEGRATION_INITIALIZATION.agc:141
//#
// INTEGRATION_INITIALIZATION.agc:142
//#										 28	 28
// INTEGRATION_INITIALIZATION.agc:143
//#	TCCSM(LEM)		TIME SINCE RECTIFICATION	CSECS		2	2
// INTEGRATION_INITIALIZATION.agc:144
//#				CUSTOMARILY 0
// INTEGRATION_INITIALIZATION.agc:145
//#
// INTEGRATION_INITIALIZATION.agc:146
//#								 1/2		 17	 16
// INTEGRATION_INITIALIZATION.agc:147
//#	XKEPCSM(LEM)		ROOT OF KEPLER'S EQUATION	M		2	2
// INTEGRATION_INITIALIZATION.agc:148
//#				0 IF TCCSM(LEM) = 0
// INTEGRATION_INITIALIZATION.agc:149
//#
// INTEGRATION_INITIALIZATION.agc:150
//#	CMOONFLG		PERMANENT FLAGS CORRESPONDING			0	0
// INTEGRATION_INITIALIZATION.agc:151
//#	CMIDFLAG		TO MOONFLAG AND MIDFLAG				0,1	0,1
// INTEGRATION_INITIALIZATION.agc:152
//#	LMOONFLG		C = CSM, L = LM					0	0
// INTEGRATION_INITIALIZATION.agc:153
//#	LMIDFLG									0,1	0,1
// INTEGRATION_INITIALIZATION.agc:154
//#
// INTEGRATION_INITIALIZATION.agc:155
//#	SURFFLAG		MUN SURFACE FLAG				0,1	0,1
// INTEGRATION_INITIALIZATION.agc:156
//#
// INTEGRATION_INITIALIZATION.agc:157
//# IN ADDITION, IF (L)CMIDFLAG IS SET, THE INITIAL INPUT VALUES FOR MUN
// INTEGRATION_INITIALIZATION.agc:158
//# KERBOL EPHEMERIDES SUBROUTINE AND PLANETARY INERTIAL ORIENTATION SUB-
// INTEGRATION_INITIALIZATION.agc:159
//# ROUTINE MUST BE PRESET.
// INTEGRATION_INITIALIZATION.agc:160
//#
// INTEGRATION_INITIALIZATION.agc:161
//# OUTPUT
// INTEGRATION_INITIALIZATION.agc:162
//#	AFTER EVERY CALL TO INTEGRATION
// INTEGRATION_INITIALIZATION.agc:163
//#									KERBIN	MUN
// INTEGRATION_INITIALIZATION.agc:164
//#									 29	 29
// INTEGRATION_INITIALIZATION.agc:165
//#	0D	RATT	POSITION			METERS		2	2
// INTEGRATION_INITIALIZATION.agc:166
//#
// INTEGRATION_INITIALIZATION.agc:167
//#									 7	 7
// INTEGRATION_INITIALIZATION.agc:168
//#	6D	VATT	VELOCITY			M/CSEC		2	2
// INTEGRATION_INITIALIZATION.agc:169
//#
// INTEGRATION_INITIALIZATION.agc:170
//#									 28	 28
// INTEGRATION_INITIALIZATION.agc:171
//#	12D	TAT	TIME						2	2
// INTEGRATION_INITIALIZATION.agc:172
//#
// INTEGRATION_INITIALIZATION.agc:173
//#									 29	 27
// INTEGRATION_INITIALIZATION.agc:174
//#	14D	RATT1	POSITION			METERS		2	2
// INTEGRATION_INITIALIZATION.agc:175
//#
// INTEGRATION_INITIALIZATION.agc:176
//#									 7 	 5
// INTEGRATION_INITIALIZATION.agc:177
//#	20D	VATT1	VELOCITY			M/CSEC		2	2
// INTEGRATION_INITIALIZATION.agc:178
//#
// INTEGRATION_INITIALIZATION.agc:179
//#						 	 3   2		 36	 30
// INTEGRATION_INITIALIZATION.agc:180
//#	26D	MU(P)	MU				M /CS		2	2
// INTEGRATION_INITIALIZATION.agc:181
//#
// INTEGRATION_INITIALIZATION.agc:182
//#	X1		MUTABLE ENTRY					-2	-10D
// INTEGRATION_INITIALIZATION.agc:183
//#
// INTEGRATION_INITIALIZATION.agc:184
//#	X2		COORDINT
// INTEGRATION_INITIALIZATION.agc:185
//#	X2		COORDINATE SYSTEM ORIGIN			0	2
// INTEGRATION_INITIALIZATION.agc:186
//#			(THIS, NOT MOONFLAG, SHOULD BE
// INTEGRATION_INITIALIZATION.agc:187
//# Page 1208
// INTEGRATION_INITIALIZATION.agc:188
//#			USED TO DETERMINE ORIGIN.)
// INTEGRATION_INITIALIZATION.agc:189
//#
// INTEGRATION_INITIALIZATION.agc:190
//# IN ADDITION TO THE ABOVE, THE PERMANENT STATE VECTOR IS UPDATED WHENEVER
// INTEGRATION_INITIALIZATION.agc:191
//# STATEFLG WAS SET AND WHENEVER A W-MATRIX IS TO BE INTEGRATED.  THE PUSH
// INTEGRATION_INITIALIZATION.agc:192
//# COUNTER IS SET TO 0 AND OVERFLOW IS CLEARED BEFORE RETURNING TO THE
// INTEGRATION_INITIALIZATION.agc:193
//# CALLING PROGRAM.
// INTEGRATION_INITIALIZATION.agc:194
//#
// INTEGRATION_INITIALIZATION.agc:195
//# 4.0 CALLING SEQUENCES AND SAMPLE CODE
// INTEGRATION_INITIALIZATION.agc:196
//# -------------------------------------
// INTEGRATION_INITIALIZATION.agc:197
//#
// INTEGRATION_INITIALIZATION.agc:198
//#	A) PRECISION ORBITAL INTEGRATION.  CSMPREC, LEMPREC ENTRANCES
// INTEGRATION_INITIALIZATION.agc:199
//#		L-X	STORE TIME TO 96T5791T5 T 95 PUS L9ST (T4531)
// INTEGRATION_INITIALIZATION.agc:200
//#		L	CALL
// INTEGRATION_INITIALIZATION.agc:201
//#		L+1		CSMPREC (OR LEMPREC)
// INTEGRATION_INITIALIZATION.agc:202
//#		L+2	RETURN
// INTEGRATION_INITIALIZATION.agc:203
//#	   INPUT							   28
// INTEGRATION_INITIALIZATION.agc:204
//#		TDEC1 (PD 32D) TIME TO INTEGRATE TO...CENTISECONDS SCALED 2
// INTEGRATION_INITIALIZATION.agc:205
//#	   OUTPUT
// INTEGRATION_INITIALIZATION.agc:206
//#		THE DATA LISTED IN SECTION 3.0 PLUS
// INTEGRATION_INITIALIZATION.agc:207
//#		RQVV	POSITION VECTOR OF VEHICLE WITH RESPECT TO SECONDARY
// INTEGRATION_INITIALIZATION.agc:208
//#		BODY... METERS B-29 ONLY IF MIDFLAG = DIM0FLAG = 1
// INTEGRATION_INITIALIZATION.agc:209
//#	B) CONIC INTEGRATION.  CSMCONIC, LEMCONIC ENTRANCES
// INTEGRATION_INITIALIZATION.agc:210
//#		L-X	STORE TIME IN PUSH LIST (TDEC1)
// INTEGRATION_INITIALIZATION.agc:211
//#		L	CALL
// INTEGRATION_INITIALIZATION.agc:212
//#		L+1		CSMCONIC (OR LEMCONIC)
// INTEGRATION_INITIALIZATION.agc:213
//#	   INPUT/OUTPUT
// INTEGRATION_INITIALIZATION.agc:214
//#		SAME AS PRECISION INTEGRATION, EXCEPT RQVV NOT SET
// INTEGRATION_INITIALIZATION.agc:215
//#	C) INTEGRATE GIVEN STATE VECTOR.  INTEGRVS ENTRANCE
// INTEGRATION_INITIALIZATION.agc:216
//#		CALL
// INTEGRATION_INITIALIZATION.agc:217
//#				INTSTALL
// INTEGRATION_INITIALIZATION.agc:218
//#		VLOAD
// INTEGRATION_INITIALIZATION.agc:219
//#				POSITION VECTOR
// INTEGRATION_INITIALIZATION.agc:220
//#		STOVL		RCV
// INTEGRATION_INITIALIZATION.agc:221
//#				VELOCITY VECTOR
// INTEGRATION_INITIALIZATION.agc:222
//#		STODL		VCV
// INTEGRATION_INITIALIZATION.agc:223
//#				TIME STATE VECTOR VALID
// INTEGRATION_INITIALIZATION.agc:224
//#		STODL		TET
// INTEGRATION_INITIALIZATION.agc:225
//#				FINAL RADIUS
