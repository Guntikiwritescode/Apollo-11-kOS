// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:178
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:179
//#						 	 3   2		 36	 30
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:180
//#	26D	MU(P)	MU				M /CS		2	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:181
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:182
//#	X1		MUTABLE ENTRY					-2	-10D
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:183
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:184
//#	X2		COORDINT
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:185
//#	X2		COORDINATE SYSTEM ORIGIN			0	2
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:186
//#			(THIS, NOT MOONFLAG, SHOULD BE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:187
//# Page 1208
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:188
//#			USED TO DETERMINE ORIGIN.)
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:189
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:190
//# IN ADDITION TO THE ABOVE, THE PERMANENT STATE VECTOR IS UPDATED WHENEVER
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:191
//# STATEFLG WAS SET AND WHENEVER A W-MATRIX IS TO BE INTEGRATED.  THE PUSH
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:192
//# COUNTER IS SET TO 0 AND OVERFLOW IS CLEARED BEFORE RETURNING TO THE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:193
//# CALLING PROGRAM.
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:194
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:195
//# 4.0 CALLING SEQUENCES AND SAMPLE CODE
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:196
//# -------------------------------------
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:197
//#
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:198
//#	A) PRECISION ORBITAL INTEGRATION.  CSMPREC, LEMPREC ENTRANCES
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:199
//#		L-X	STORE TIME TO 96T5791T5 T 95 PUS L9ST (T4531)
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:200
//#		L	CALL
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:201
//#		L+1		CSMPREC (OR LEMPREC)
