// PORT: Physical bank 13. Shared continuation entries, slots 14260–14261.
function agcAotUnit796 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 14260 {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:1017
//		INCR	IRETURN1	# SET ERROR EXIT (CALLOC +2)
// PORT: Fixed ROM slots 14260.
        if slot <> 14260 or instruction <> 11236 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreINCR(words, 996).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// PORT: SOURCE INTEGRATION_INITIALIZATION.agc:1018
//		TC	ALARM		# INSUFFICIENT TIME FOR INTEGRATION --
// PORT: Fixed ROM slots 14261.
        if slot <> 14261 or instruction <> 2935 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 2935, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
