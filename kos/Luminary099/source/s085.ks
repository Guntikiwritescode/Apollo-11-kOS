// PORT: Physical bank 27. Shared continuation entries, slots 26589–26589.
function agcAotUnit1682 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE TIME_OF_FREE_FALL.agc:628
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:629
//# Page 1282
// PORT: SOURCE TIME_OF_FREE_FALL.agc:630
//# PROGRAM NAME:  T(X)				DATE:  01.17.67
// PORT: SOURCE TIME_OF_FREE_FALL.agc:631
//# MOD NO:  0					LOG SECTION:  TIME OF FREE FALL
// PORT: SOURCE TIME_OF_FREE_FALL.agc:632
//# MOD BY:  RR BAIRNSFATHER
// PORT: SOURCE TIME_OF_FREE_FALL.agc:633
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:634
//# FUNCTIONAL DESCRIPTION:  THE POLYNOMIAL T(X) IS USED BY TIME OF FLIGHT SUBROUTINES CALCTFF AND
// PORT: SOURCE TIME_OF_FREE_FALL.agc:635
//#	CALCTPER TO APPROXIMATE THE SERIES
// PORT: SOURCE TIME_OF_FREE_FALL.agc:636
//#		           2     3
// PORT: SOURCE TIME_OF_FREE_FALL.agc:637
//#		1/3 -X/5 +X /7 -X /9 ...
// PORT: SOURCE TIME_OF_FREE_FALL.agc:638
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:639
//#	WHERE	X = ALFA Z Z		IF ALFA Z Z LEQ 1
// PORT: SOURCE TIME_OF_FREE_FALL.agc:640
//#		X = 1/(ALFA Z Z)	IF ALFA Z Z G 1
// PORT: SOURCE TIME_OF_FREE_FALL.agc:641
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:642
//#	ALSO	X IS NEG FOR HYPERBOLIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:643
//#		X = 0 FOR PARABOLIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:644
//#		X IS POSITIVE FOR ELLIPTIC ORBITS
// PORT: SOURCE TIME_OF_FREE_FALL.agc:645
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:646
//#	FOR FLIGHT 278, THE POLYNOMIAL T(X) IS FITTED OVER THE RANGE (0,+1) AND HAS A MAXIMUM
// PORT: SOURCE TIME_OF_FREE_FALL.agc:647
//#	DEVIATION FROM THE SERIES OF 2 E-5.  (T(X) IS A CHEBYCHEV TYPE FIT AND WAS OBTAINED USING
// PORT: SOURCE TIME_OF_FREE_FALL.agc:648
//#	MAX PROGRAM AUTOCURFIT294RRB AND IS VALID TO THE SAME TOLERANCE OVER THE RANGE (-.08,+1).)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:649
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:650
//# CALLING SEQUENCE:	RTB
// PORT: SOURCE TIME_OF_FREE_FALL.agc:651
//#				T(X)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:652
//#	C(MPAC) = X
// PORT: SOURCE TIME_OF_FREE_FALL.agc:653
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:654
//# SUBROUTINE CALLED:  NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:655
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:656
//# NORMAL EXIT MODE:  TC TANZIG
// PORT: SOURCE TIME_OF_FREE_FALL.agc:657
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:658
//# ALARMS:  NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:659
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:660
//# OUTPUT:  C(MPAC) = T(X)
// PORT: SOURCE TIME_OF_FREE_FALL.agc:661
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:662
//# ERASABLE INITIALIZATION REQUIRED:
// PORT: SOURCE TIME_OF_FREE_FALL.agc:663
//#	C(MPAC) = X
// PORT: SOURCE TIME_OF_FREE_FALL.agc:664
//#
// PORT: SOURCE TIME_OF_FREE_FALL.agc:665
//# DEBRIS:  NONE
// PORT: SOURCE TIME_OF_FREE_FALL.agc:666
//
// PORT: SOURCE TIME_OF_FREE_FALL.agc:667
//T(X)		TC	POLY
// PORT: Fixed ROM slots 26589.
    if slot <> 26589 or instruction <> 3730 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 3730, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[1682] to agcAotUnit1682@.

