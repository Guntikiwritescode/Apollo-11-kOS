//#
// TIME_OF_FREE_FALL.agc:25
//# Notations on the hardcopy document read, in part:
// TIME_OF_FREE_FALL.agc:26
//#
// TIME_OF_FREE_FALL.agc:27
//#	Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// TIME_OF_FREE_FALL.agc:28
//#	16:27 JULY 14, 1969
// TIME_OF_FREE_FALL.agc:29
//
// TIME_OF_FREE_FALL.agc:30
//# Page 1268
// TIME_OF_FREE_FALL.agc:31
//# THE TFF SUBROUTINES MAY BE USED IN EITHER KERBIN OR MUN CENTERED COORDINATES.  THE TFF ROUTINES NEVER
// TIME_OF_FREE_FALL.agc:32
//# KNOW WHICH ORIGIN APPLIES.  IT IS THE USER WHO KNOWS, AND WHO SUPPLIES RONE, VONE, AND 1/SQRT(MU) AT THE
// TIME_OF_FREE_FALL.agc:33
//# APPROPRIATE SCALE LEVEL FOR THE PROPER PRIMARY BODY.
// TIME_OF_FREE_FALL.agc:34
//#
// TIME_OF_FREE_FALL.agc:35
//#	KERBIN ORIGIN	POSITION	-29	METERS
// TIME_OF_FREE_FALL.agc:36
//#			VELOCITY	-7	METERS/CENTISECOND
// TIME_OF_FREE_FALL.agc:37
//#			1/SQRT(MU)	+17	SQRT(CS SQ/METERS CUBED)
// TIME_OF_FREE_FALL.agc:38
//#
// TIME_OF_FREE_FALL.agc:39
//#	MUN ORIGIN	POSITION	-27	METERS
// TIME_OF_FREE_FALL.agc:40
//#			VELOCITY	-5	METERS/CENTISECONDS
// TIME_OF_FREE_FALL.agc:41
//#			1/SQRT(MU)	+14	SQRT(CS SQ/METERS CUBED)
// TIME_OF_FREE_FALL.agc:42
//#
// TIME_OF_FREE_FALL.agc:43
//# ALL DATA PROVIDED TO AND RECEIVED FROM ANY TFF SUBROUTINE WILL BE AT ONE OF THE LEVELS ABOVE.  IN ALL CASES,
// TIME_OF_FREE_FALL.agc:44
//# THE FREE FALL TIME IS RETURNED IN CENTISECONDS AT (-28).  PROGRAM TFF/CONIC WILL GENERATE VONE/RTMU AND
// TIME_OF_FREE_FALL.agc:45
//# LEAVE IT IN VONE' AT (+10) IF KERBIN ORIGIN AND (+9) IF MUN ORIGIN.
// TIME_OF_FREE_FALL.agc:46
//#
// TIME_OF_FREE_FALL.agc:47
//# THE USER MUST STORE THE STATE VECTOR IN RONE, VONE, AND MU IN THE FORM 1/SQRT(MU) IN TFF/RTMU
// TIME_OF_FREE_FALL.agc:48
//# AT THE PROPER SCALE BEFORE CALLING TFF/CONIC.  SINCE RONE, VONE ARE IN THE EXTENDED VERB STORAGE AREA,
// TIME_OF_FREE_FALL.agc:49
//# THE USER MUST ALSO LOCK OUT THE EXTENDED VERBS, AND RELEASE THEM WHEN FINISHED.
// TIME_OF_FREE_FALL.agc:50
//#
// TIME_OF_FREE_FALL.agc:51
//# PROGRAMS CALC/TFF AND CALC/TPER ASSUME THAT THE TERMINAL RADIUS IS LESS THAN THE PRESENT
// TIME_OF_FREE_FALL.agc:52
//# RADIUS.  THIS RESTRICTION CAN BE REMOVED BY A 15 W CODING CHANGE, BUT AT PRESENT IT IS NOT DEEMED NECESSARY.
// TIME_OF_FREE_FALL.agc:53
//#
// TIME_OF_FREE_FALL.agc:54
//# THE FOLLOWING ERASABLE QUANTITIES ARE USED BY THE TFF ROUTINES, AND ARE LOCATED IN THE PUSH LIST.
// TIME_OF_FREE_FALL.agc:55
//#
// TIME_OF_FREE_FALL.agc:56
//#					BELOW	E:  IS USED FOR KERBIN ORIGIN SCALE
// TIME_OF_FREE_FALL.agc:57
//#						M:  IS USED FOR MUN  ORIGIN SCALE
// TIME_OF_FREE_FALL.agc:58
//#
// TIME_OF_FREE_FALL.agc:59
//#TFFSW		=	119D	# BIT1	0 = CALCTFF		1 = CALCTPER
// TIME_OF_FREE_FALL.agc:60
//TFFDELQ		=	10D	#	Q2-Q1			E: (-16)  M: (-15)
// TIME_OF_FREE_FALL.agc:61
//RMAG1		=	12D	#	ABVAL(RN)  M		E: (-29)  M: (-27)
// TIME_OF_FREE_FALL.agc:62
//#RPER		=	14D	#	PERIGEE RADIUS  M	E: (-29)  M: (-27)
// TIME_OF_FREE_FALL.agc:63
//TFFQ1		=	14D	#	R.V / SQRT(MUE)		E: (-16)  M: (-15)
// TIME_OF_FREE_FALL.agc:64
//#SDELF/2			#	SIN(THETA) /2
// TIME_OF_FREE_FALL.agc:65
//CDELF/2		=	14D	#	COS(THETA) /2
// TIME_OF_FREE_FALL.agc:66
//#RAPO		=	16D	#	APOGEE RADIUS  M	E: (-29)  M: (-27)
// TIME_OF_FREE_FALL.agc:67
//NRTERM		=	16D	#	TERMINAL RADIUS  M	E: (-29+NR)
// TIME_OF_FREE_FALL.agc:68
//				#					  M: (-27+NR)
// TIME_OF_FREE_FALL.agc:69
//RTERM		=	18D	#	TERMINAL RADIUS  M	E: (-29)  M: (-27)
// TIME_OF_FREE_FALL.agc:70
//TFFVSQ		=	20D	#	-(V SQUARED/MU)  1/M	E: (20)   M: (18)
// TIME_OF_FREE_FALL.agc:71
//TFF1/ALF	=	22D	#	SEMI MAJ AXIS  M	E: (-22-2 NA)
// TIME_OF_FREE_FALL.agc:72
//				#					  M: (-20-2 NA)
// TIME_OF_FREE_FALL.agc:73
//TFFRTALF	=	24D	#	SQRT(ALFA)		E:(10+NA) M: (9+NA)
// TIME_OF_FREE_FALL.agc:74
//TFFALFA		=	26D	#	ALFA  1/M		E:(26-NR) M: (24-NR)
// TIME_OF_FREE_FALL.agc:75
//TFFNP		=	28D	#	SEMI LATUS RECTUM  M	E: (-38+2 NR)
// TIME_OF_FREE_FALL.agc:76
//				#					  M: (-36+2 NR)
// TIME_OF_FREE_FALL.agc:77
//TFF/RTMU	=	30D	#	1/SQRT(MU)		E: (17)   M: (14)
// TIME_OF_FREE_FALL.agc:78
//NRMAG		=	32D	#	PRESENT RADIUS  M	E: (-29+NR)
// TIME_OF_FREE_FALL.agc:79
//				#					  M: (-27+NR)
// TIME_OF_FREE_FALL.agc:80
//TFFX		=	34D     #
// TIME_OF_FREE_FALL.agc:81
//TFFTEM		=	36D	#	TEMPORARY
// TIME_OF_FREE_FALL.agc:82
//# Page 1269
// TIME_OF_FREE_FALL.agc:83
//#		REGISTERS S1, S2 ARE UNTOUCED BY ANY TFF SUBROUTINE
// TIME_OF_FREE_FALL.agc:84
//#		INDEX REGISTERS X1, X2 ARE USED BY ALL TFF SUBROUTINES.  THEY ARE ESTAB-
// TIME_OF_FREE_FALL.agc:85
//#		LISHED IN TFF/CONIC AND MUST BE PRESERVED BETWEEN CALLS TO SUBSEQUENT
// TIME_OF_FREE_FALL.agc:86
//#		SUBROUTINES.
// TIME_OF_FREE_FALL.agc:87
//#		-NR				C(X1) = NORM COUNT OF RMAG
// TIME_OF_FREE_FALL.agc:88
//#		-NA				C(X2) = NORM COUNT OF SQRT(ABS(ALFA))
// TIME_OF_FREE_FALL.agc:89
//
// TIME_OF_FREE_FALL.agc:90
//# Page 1270
// TIME_OF_FREE_FALL.agc:91
//# SUBROUTINE NAME:  TFFCONIC						DATE:  01.29.67
// TIME_OF_FREE_FALL.agc:92
//# MOD NO:  0								LOG SECTION:  TIME OF FREE FALL
// TIME_OF_FREE_FALL.agc:93
//# MOD BY:  BAIRNSFATHER KERMAN
// TIME_OF_FREE_FALL.agc:94
//# MOD NO:  1	MOD BY:  BAIRNSFATHER KERMAN	DATE: 11 APR 67
// TIME_OF_FREE_FALL.agc:95
//# MOD NO:  2	MOD BY:  BAIRNSFATHER KERMAN	DATE: 21 NOV 67		ADD MUN MU.
// TIME_OF_FREE_FALL.agc:96
//# MOD NO:  3	MOD BY:  BAIRNSFATHER KERMAN	DATE: 21 MAR 68		ACCEPT DIFFERENT KERBIN/MUN SCALES
// TIME_OF_FREE_FALL.agc:97
//#
// TIME_OF_FREE_FALL.agc:98
//# FUNCTIONAL DESCRIPTION:  THIS SUBROUTINE IS CALLED TO COMPUTE THOSE CONIC PARAMETERS REQUIRED BY THE TFF
// TIME_OF_FREE_FALL.agc:99
//#	SUBROUTINES AND TO ESTABLISH THEM IN THE PUSH LIST AREA.  THE PARAMETERS ARE LISTED UNDER OUTPUT.
// TIME_OF_FREE_FALL.agc:100
//#	THE EQUATIONS ARE:
// TIME_OF_FREE_FALL.agc:101
//#		_   __ __
// TIME_OF_FREE_FALL.agc:102
//#		H = RN*VN			ANGULAR MOMENTUM
// TIME_OF_FREE_FALL.agc:103
//#		      _ _
// TIME_OF_FREE_FALL.agc:104
//#		LCP = H.H / MU			SEMI LATUS RECTUM
// TIME_OF_FREE_FALL.agc:105
//#		              __ __
// TIME_OF_FREE_FALL.agc:106
//#		ALFA = 2/RN - VN.VN / MU	RECIPROCAL SEMI-MAJOR AXIS, SIGNED
// TIME_OF_FREE_FALL.agc:107
//#
// TIME_OF_FREE_FALL.agc:108
//# 	AND ALFA IS POS FOR ELLIPTIC ORBITS
// TIME_OF_FREE_FALL.agc:109
//#	              0 FOR PARABOLIC ORBITS
// TIME_OF_FREE_FALL.agc:110
//#	            NEG FOR HYPERBOLIC ORBITS
// TIME_OF_FREE_FALL.agc:111
//#	SUBROUTINE ALSO COMPUTES AND SAVES RMAG.
// TIME_OF_FREE_FALL.agc:112
//#
// TIME_OF_FREE_FALL.agc:113
//# CALLING SEQUENCE:
// TIME_OF_FREE_FALL.agc:114
//#	TFFCONIC EXPECTS CALLER TO ENTER WITH CORRECT GRAVITATIONAL CONSTANT IN MPAC, IN THE FORM
// TIME_OF_FREE_FALL.agc:115
//#	1/SQRT(MU).  THE PROGRAM WILL SAVE IN TFF/RTMU.  THE SCALE IS DETERMINED BY WHETHER KERBIN OR MUN
// TIME_OF_FREE_FALL.agc:116
//#	ORIGIN IS USED.  THE CALLER MUST LOCK OUT THE EXTENDED VERBS BEFORE PROVIDING STATE VECTOR IN RONE,
// TIME_OF_FREE_FALL.agc:117
//#	VONE AT PROPER SCALE.  THE EXTENDED VERBS MUST BE RESTORED WHEN THE CALLER IS FINISHED USING THE
// TIME_OF_FREE_FALL.agc:118
//#	TFF ROUTINES.
// TIME_OF_FREE_FALL.agc:119
//#
// TIME_OF_FREE_FALL.agc:120
//#	ENTRY POINT TFFCONMU EXPECTS THAT TFF/RTMU IS ALREADY LOADED.
// TIME_OF_FREE_FALL.agc:121
//#
// TIME_OF_FREE_FALL.agc:122
//#	TO SPECIFY MU:	DLOAD	CALL			 	IF MU ALREADY STORED:	CALL
// TIME_OF_FREE_FALL.agc:123
//#				YOURMU	1/RTMU E:(17) M:(14)					TFFCONMU
// TIME_OF_FREE_FALL.agc:124
//#				TFFCONIC
// TIME_OF_FREE_FALL.agc:125
//#	PUSHLOC = PDL+0, ARBITRARY IF LEQ 18D
// TIME_OF_FREE_FALL.agc:126
//#
// TIME_OF_FREE_FALL.agc:127
//# SUBROUTINES CALLED:  NONE
// TIME_OF_FREE_FALL.agc:128
//#
// TIME_OF_FREE_FALL.agc:129
//# NORMAL EXIT MODES:  RVQ
// TIME_OF_FREE_FALL.agc:130
//#
// TIME_OF_FREE_FALL.agc:131
//# ALARMS:  NONE
// TIME_OF_FREE_FALL.agc:132
//#
// TIME_OF_FREE_FALL.agc:133
//# OUTPUT:	THE FOLLOWING ARE STORED IN THE PUSH LIST AREA.
// TIME_OF_FREE_FALL.agc:134
//#		RMAG1		E:(-29) M:(-27)	M  RN, PRESENT RADIUS LENGTH.
// TIME_OF_FREE_FALL.agc:135
//#		NRMAG		E:(-29+NR)	M  RMAG, NORMALIZED
// TIME_OF_FREE_FALL.agc:136
//#				M:(-27+NR)
// TIME_OF_FREE_FALL.agc:137
//#		X1				-NR, NORM COUNT
// TIME_OF_FREE_FALL.agc:138
//#		TFFNP		E:(-38+2NR)	M  LCP, SEMI LATUS RECTUM, WEIGHTED BY NR.  	FOR VGAMCALC.
// TIME_OF_FREE_FALL.agc:139
//#				M:(-36+2NR)
// TIME_OF_FREE_FALL.agc:140
//#		TFF/RTMU	E:(17) M:(14)	1/SQRT(MU)
// TIME_OF_FREE_FALL.agc:141
//#		TFFVSQ		E:(20) M:(18)	1/M  -(V SQ/MU):  PRESENT VELOCITY, NORMALIZED. FOR VGAMCALC
// TIME_OF_FREE_FALL.agc:142
//#		TFFALFA		E:(26-NR)	1/M  ALFA, WEIGHTED BY NR
// TIME_OF_FREE_FALL.agc:143
//#				M:(24-NR)
// TIME_OF_FREE_FALL.agc:144
//#		TFFRTALF	E:(10+NA)	SQRT(ALFA), NORMALIZED
// TIME_OF_FREE_FALL.agc:145
//#				M:(9+NA)
// TIME_OF_FREE_FALL.agc:146
//# Page 1271
// TIME_OF_FREE_FALL.agc:147
//#		X2				-NA, NORMCOUNT
// TIME_OF_FREE_FALL.agc:148
//#		TFF1/ALF	E:(-22-2NA)	SIGNED SEMI MAJ AXIS, WEIGHTED BY NA
// TIME_OF_FREE_FALL.agc:149
//#				M:(-20-2NA)
// TIME_OF_FREE_FALL.agc:150
//#		PUSHLOC AT PDL+0
// TIME_OF_FREE_FALL.agc:151
//#
// TIME_OF_FREE_FALL.agc:152
//#	THE FOLLOWING IS STORED IN GENERAL ERASABLE
// TIME_OF_FREE_FALL.agc:153
//#		VONE'		E:(10) M:(9)	V/RT(MU), NORMALIZED VELOCITY
// TIME_OF_FREE_FALL.agc:154
//#
// TIME_OF_FREE_FALL.agc:155
//# ERASABLE INITIALIZATION REQUIRED:
// TIME_OF_FREE_FALL.agc:156
//#		RONE		E:(-29) M:(-27)	M  STATE VECTOR		LEFT BY CALLER
// TIME_OF_FREE_FALL.agc:157
//#		VONE		E:(-7) M:(-5)	M/CS  STATE VECTOR	LEFT BY CALLER
// TIME_OF_FREE_FALL.agc:158
//#		TFF/RTMU	E:(17) M:(14)	1/RT(CS SQ/M CUBE)	IF ENTER VIA TFFCONMU.
// TIME_OF_FREE_FALL.agc:159
//#
// TIME_OF_FREE_FALL.agc:160
//# DEBRIS:	QPRET		PDL+0 ... PDL+3
// TIME_OF_FREE_FALL.agc:161
//
// TIME_OF_FREE_FALL.agc:162
//		BANK	33
// TIME_OF_FREE_FALL.agc:163
//		SETLOC	TOF-FF
// TIME_OF_FREE_FALL.agc:164
//		BANK
// TIME_OF_FREE_FALL.agc:165
//
// TIME_OF_FREE_FALL.agc:166
//		COUNT*	$$/TFF
// TIME_OF_FREE_FALL.agc:167
//
// TIME_OF_FREE_FALL.agc:168
//TFFCONIC	STORE	TFF/RTMU	# 1/SQRT(MU)	E:(17) M:(14)
// slot 26352
    26352, 62
)).

