// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:223
//RUPTREG4	ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:224
//KEYTEMP1	EQUALS	RUPTREG4
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:225
//DSRUPTEM	EQUALS	RUPTREG4
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:226
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:227
