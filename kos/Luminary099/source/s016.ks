// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:100
//QRUPT		EQUALS	12
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:101
//SAMPTIME	EQUALS	13		# SAMPLED TIME 1 & 2.
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:102
//ZRUPT		EQUALS	15		# (13 AND 14 ARE SPARES.)
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:103
//BANKRUPT	EQUALS	16		# USUALLY HOLDS FBANK OR BBANK.
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:104
//BRUPT		EQUALS	17		# RESUME ADDRESS AS WELL.
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:105
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:106
//CYR		EQUALS	20
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:107
//SR		EQUALS	21
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:108
//CYL		EQUALS	22
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:109
//EDOP		EQUALS	23		# EDITS INTERPRETIVE OPERATION CODE PAIRS.
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:110
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:111
//TIME2		EQUALS	24
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:112
//TIME1		EQUALS	25
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:113
