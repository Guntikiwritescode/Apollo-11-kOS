//A		EQUALS	0
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:90
//L		EQUALS	1		# L AND Q ARE BOTH CHANNELS AND REGISTERS
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:91
//Q		EQUALS	2
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:92
//EBANK		EQUALS	3
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:93
//FBANK		EQUALS	4
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:94
//Z		EQUALS	5		# ADJACENT TO FBANK AND BBANK FOR DXCH Z
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:95
//BBANK		EQUALS	6		# (DTCB) AND DXCH FBANK (DTCF).
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:96
//					# REGISTER 7 IS A ZERO-SOURCE, USED BY ZL.
