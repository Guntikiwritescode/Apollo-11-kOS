//# Page 95
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:184
//# GENERAL ERASABLE ASSIGNMENTS
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:185
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:186
//		SETLOC	61
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:187
//# INTERRUPT TEMPORARY STORAGE POOL.	(11D)
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:188
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:189
//# (ITEMP1 THROUGH RUPTREG4)
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:190
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:191
//# ANY OF THESE MAY BE USED AS TEMPORARIES DURING INTERRUPT OR WITH INTERRUPT INHIBITED. THE ITEMP SERIES
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:192
//# IS USED DURING CALLS TO THE EXECUTIVE AND WAITLIST -- THE RUPTREGS ARE NOT.
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:193
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:194
//ITEMP1		ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:195
//WAITEXIT	EQUALS	ITEMP1
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:196
//EXECTEM1	EQUALS	ITEMP1
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:197
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:198
//ITEMP2		ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:199
//WAITBANK	EQUALS	ITEMP2
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:200
//EXECTEM2	EQUALS	ITEMP2
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:201
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:202
//ITEMP3		ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:203
//RUPTSTOR	EQUALS	ITEMP3
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:204
//WAITADR		EQUALS	ITEMP3
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:205
//NEWPRIO		EQUALS	ITEMP3
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:206
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:207
//ITEMP4		ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:208
//LOCCTR		EQUALS	ITEMP4
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:209
//WAITTEMP	EQUALS	ITEMP4
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:210
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:211
//ITEMP5		ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:212
//NEWLOC		EQUALS	ITEMP5
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:213
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:214
//ITEMP6		ERASE
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:215
//NEWLOC+1	EQUALS	ITEMP6		# DP ADDRESS.
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:216
//
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:217
//		SETLOC	67
// PORT: SOURCE ERASABLE_ASSIGNMENTS.agc:218
//NEWJOB		ERASE			# MUST BE AT LOC 67 DUE TO WIRING.
