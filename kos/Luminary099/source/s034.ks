// INTERPRETER.agc
// bank 03, slots 5151-5163
function agcAotUnit255 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5156 {
        if slot <= 5153 {
            if slot <= 5151 {
// INTERPRETER.agc:1
//# Copyright:	Public domain.
// INTERPRETER.agc:2
//# Filename:	INTERPRETER.agc
// INTERPRETER.agc:3
//# Purpose: 	Part of the source code for Luminary 1A build 099.
// INTERPRETER.agc:4
//#		It is part of the source code for the Munar Excursion Module's (LM)
// INTERPRETER.agc:5
//#		Apollo Guidance Computer (AGC), for Apollo 11.
// INTERPRETER.agc:6
//# Assembler:	yaYUL
// INTERPRETER.agc:7
//# Contact:	Burkey Kerman <info@sandroid.org>.
// INTERPRETER.agc:8
//# Website:	www.ibiblio.org/apollo.
// INTERPRETER.agc:9
//# Pages:	1002-1094
// INTERPRETER.agc:10
//# Mod history:	2009-05-25 RSB	Adapted from the corresponding
// INTERPRETER.agc:11
//#				Luminary131 file, using page
// INTERPRETER.agc:12
//#				images from Luminary 1A.
// INTERPRETER.agc:13
//#		2011-01-06 JL	Fixed pseudo-label indentation.
// INTERPRETER.agc:14
//#		2011-05-08 JL	Removed workarounds.
// INTERPRETER.agc:15
//
// INTERPRETER.agc:16
//# This source code has been transcribed or otherwise adapted from
// INTERPRETER.agc:17
//# digitized images of a hardcopy from the MIT Museum.  The digitization
// INTERPRETER.agc:18
//# was performed by Fjeld Kerman, and arranged for by Douglas Kerman of
// INTERPRETER.agc:19
//# the Museum.  Many thanks to both.  The images (with suitable reduction
// INTERPRETER.agc:20
//# in storage size and consequent reduction in image quality as well) are
// INTERPRETER.agc:21
//# available online at www.ibiblio.org/apollo.  If for some reason you
// INTERPRETER.agc:22
//# find that the images are illegible, contact me at info@sandroid.org
// INTERPRETER.agc:23
//# about getting access to the (much) higher-quality images which Fjeld Kerman
// INTERPRETER.agc:24
//# actually created.
// INTERPRETER.agc:25
//#
// INTERPRETER.agc:26
//# Notations on the hardcopy document read, in part:
// INTERPRETER.agc:27
//#
// INTERPRETER.agc:28
//#	Assemble revision 001 of AGC program LMY99 by NASA 2021112-061
// INTERPRETER.agc:29
//#	16:27 JULY 14, 1969
// INTERPRETER.agc:30
//
// INTERPRETER.agc:31
//# Page 1002
// INTERPRETER.agc:32
//# SECTION 1:  DISPATCHER
// INTERPRETER.agc:33
//#
// INTERPRETER.agc:34
//# ENTRY TO THE INTERPRETER.  INTPRET SETS LOC TO THE FIRST INSTRUCTION, BANKSET TO THE BBANK OF THE
// INTERPRETER.agc:35
//# OBJECT INTERPRETIVE PROGRAM, AND INTBIT15 TO THE BIT15 CONTENTS OF FBANK.  INTERPRETIVE PROGRAMS MAY BE IN
// INTERPRETER.agc:36
//# VIRTUALLY ALL BANKS PRESENT UNDER ANY SUPER-BANK SETTING, WITH THE RESTRICTION THAT PROGRAMS IN HIGH BANKS
// INTERPRETER.agc:37
//# (BIT15 OF FBANK = 1) DO NOT REFER TO LOWBANKS, AND VICE-VERSA.  THE INTERPRETER DOES NOT SWITCH SUPERBANKS.
// INTERPRETER.agc:38
//# E-BANK SWITCHING OCCURS WHENEVER GENERAL ERASABLE (100-3777) IS ADDRESSED.
// INTERPRETER.agc:39
//
// INTERPRETER.agc:40
//		BLOCK	03
// INTERPRETER.agc:41
//
// INTERPRETER.agc:42
//		COUNT*	$$/INTER
// INTERPRETER.agc:43
//INTPRET		RELINT
// slot 5151
                if slot <> 5151 or instruction <> 3 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 3, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5152 {
// INTERPRETER.agc:44
//		EXTEND				# SET LOC TO THE WORD FOLLOWING THE TC.
// slot 5152
                    if slot <> 5152 or instruction <> 6 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 6, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:45
//		QXCH	LOC
// slot 5153
                    if slot <> 5153 or instruction <> 9332 { return choose false if checkOnly else -1. }
                    if extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreExchange(words, 2, 116, readPhysical).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5154 {
// INTERPRETER.agc:46
//
// INTERPRETER.agc:47
// +2		CA	BBANK			# INTERPRETIVE BRANCHES FINISH HERE.
// slot 5154
                if slot <> 5154 or instruction <> 12294 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCA(words, 6).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5155 {
// INTERPRETER.agc:48
//		TS	BANKSET
// slot 5155
                    if slot <> 5155 or instruction <> 22645 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22645, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:49
//		MASK	BIT15			# GET 15TH BIT FOR INDEXABLE ADDRESSES.
// slot 5156
                    if slot <> 5156 or instruction <> 31197 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        set words[0] to agcOverflowCorrected(words[0]).
                        local fixedOperand is mod(readEffective:call(words, 2525), 32768).
                        if fixedOperand = 16384 {
                            set words[0] to agcSignExtend(mod(floor(words[0] / 16384), 2) * 16384).
                        } else {
                            set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                        }
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    } else {
        if slot <= 5159 {
            if slot <= 5157 {
// INTERPRETER.agc:50
//		TS	INTBIT15
// slot 5157
                if slot <> 5157 or instruction <> 22605 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22605, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5158 {
// INTERPRETER.agc:51
//
// INTERPRETER.agc:52
//		TS	EDOP			# MAKE SURE NO INSTRUCTIONS LEFT OVER
// slot 5158
                    if slot <> 5158 or instruction <> 22547 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22547, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:53
//
// INTERPRETER.agc:54
//		TCF	NEWOPS			# PICK UP OP CODE PAIR AND BEGIN.
// slot 5159
                    if slot <> 5159 or instruction <> 7224 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7224, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5161 {
                if slot <= 5160 {
// INTERPRETER.agc:55
//
// INTERPRETER.agc:56
//INTRSM		LXCH	BBANK			# RESUME SUSPENDED INTERPRETIVE JOB
// slot 5160
                    if slot <> 5160 or instruction <> 9222 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreExchange(words, 1, 6, readPhysical).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:57
//		TCF	INTPRET +3
// slot 5161
                    if slot <> 5161 or instruction <> 7202 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7202, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 5162 {
// INTERPRETER.agc:58
//
// INTERPRETER.agc:59
//# DLOAD LOADS MPAC, MPAC +1, LEAVING ZERO IN MPAC +2.
// INTERPRETER.agc:60
//
// INTERPRETER.agc:61
//DLOAD		EXTEND
// slot 5162
                    if slot <> 5162 or instruction <> 6 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 6, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:62
//		INDEX	ADDRWD
// slot 5163
                    if slot <> 5163 or instruction <> 20558 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20558, words[0], readEffective).
                    }
                    if extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20558, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    }
}
set agcAotRoutes[255] to agcAotUnit255@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:63
//		DCA	0			# LOAD DP C(C(ADDRWD)) INT MPAC,MPAC +1
// slot 5164
    5164, 24578
)).

// bank 03, slots 5165-5176
function agcAotUnit256 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5170 {
        if slot <= 5167 {
            if slot <= 5165 {
// INTERPRETER.agc:64
//SLOAD2		DXCH	MPAC
// slot 5165
                if slot <> 5165 or instruction <> 21613 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    if not agcCoreDoubleExchange(words, "DXCH", 109, readPhysical, readAdjacent) { return -1. }
                    return list(false, false, true, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5166 {
// INTERPRETER.agc:65
//		CAF	ZERO			# ZERO MPAC +2
// slot 5166
                    if slot <> 5166 or instruction <> 14829 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        local fixedOperand is mod(readEffective:call(words, 2541), 32768).
                        set words[0] to agcSignExtend(fixedOperand).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:66
//
// INTERPRETER.agc:67
//# Page 1003
// INTERPRETER.agc:68
//# AT THE END OF MOST INSTRUCTIONS, CONTROL IS GIVEN TO DANZIG TO DISPATCH THE NEXT OPERATION.
// INTERPRETER.agc:69
//
// INTERPRETER.agc:70
//		TS	MPAC 	+2		# AND DECLARE DP MODE
// slot 5167
                    if slot <> 5167 or instruction <> 22638 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22638, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5168 {
// INTERPRETER.agc:71
//
// INTERPRETER.agc:72
//NEWMODE		TS	MODE			# PROLOGUE FOR MODE-CHANGING INSTRUCTIONS.
// slot 5168
                if slot <> 5168 or instruction <> 22643 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22643, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5169 {
// INTERPRETER.agc:73
//
// INTERPRETER.agc:74
//DANZIG		CA	BANKSET			# SET BBANK BEFORE TESTING NEWJOB SO THAT
// slot 5169
                    if slot <> 5169 or instruction <> 12405 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCA(words, 117).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:75
//		TS 	BBANK			# IT MAY BE SAVED DIRECTLY BY CHANJOB.
// slot 5170
                    if slot <> 5170 or instruction <> 22534 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22534, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    } else {
        if slot <= 5173 {
            if slot <= 5171 {
// INTERPRETER.agc:76
//
// INTERPRETER.agc:77
//NOIBNKSW	CCS	EDOP			# SEE IF AN ORDER CODE IS LEFT OVER FROM
// slot 5171
                if slot <> 5171 or instruction <> 4115 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCCS(words, 19).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5172 {
// INTERPRETER.agc:78
//		TCF	OPJUMP			# THE LAST PAIR RETRIEVED.  IF SO, EXECUTE.
// slot 5172
                    if slot <> 5172 or instruction <> 7231 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7231, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:79
//						# EDOP IS SET TO ZERO ON ITS RE-EDITIING.
// INTERPRETER.agc:80
//
// INTERPRETER.agc:81
//		CCS	NEWJOB			# SEE IF A JOB OF HIGHER PRIORITY IS
// slot 5173
                    if slot <> 5173 or instruction <> 4151 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCCS(words, 55).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        } else {
            if slot <= 5174 {
// INTERPRETER.agc:82
//		TCF	CHANG2			# PRESENT, AND IF SO, CHANGE JOBS.
// slot 5174
                if slot <> 5174 or instruction <> 6742 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 6742, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5175 {
// INTERPRETER.agc:83
//
// INTERPRETER.agc:84
//		INCR	LOC			# ADVANCE THE LOCATION COUNTER.
// slot 5175
                    if slot <> 5175 or instruction <> 10356 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreINCR(words, 116).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:85
//
// INTERPRETER.agc:86
//# ITRACE (1) REFERS TO "NEWOPS"
// INTERPRETER.agc:87
//NEWOPS		INDEX	LOC			# ENTRY TO BEGIN BY PICKING OP CODE PAIR.
// slot 5176
                    if slot <> 5176 or instruction <> 20596 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20596, words[0], readEffective).
                    }
                    if extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20596, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    }
}
set agcAotRoutes[256] to agcAotUnit256@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:88
//		CA	0			# MAY BE AN OPCODE PAIR OR A STORE CODE.
// slot 5177
    5177, 24576
)).

// bank 03, slots 5178-5179
function agcAotUnit257 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5178 {
// INTERPRETER.agc:89
//		CCS	A			# TEST SIGN AND GET DABS(A).
// slot 5178
        if slot <> 5178 or instruction <> 4096 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreCCS(words, 0).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// INTERPRETER.agc:90
//		TCF	DOSTORE			# PROCESS STORE CODE.
// slot 5179
        if slot <> 5179 or instruction <> 7410 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 7410, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
set agcAotRoutes[257] to agcAotUnit257@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:91
//
// INTERPRETER.agc:92
//LOW7		OCT	177
// slot 5180
    5180, 254
)).

// bank 03, slots 5181-5190
function agcAotUnit258 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 5185 {
        if slot <= 5182 {
            if slot <= 5181 {
// INTERPRETER.agc:93
//
// INTERPRETER.agc:94
//		TS	EDOP			# OP CODE PAIR.  LEAVE THE OTHER IN EDOP
// slot 5181
                if slot <> 5181 or instruction <> 22547 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22547, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// INTERPRETER.agc:95
//		MASK	LOW7			# WHERE CCS EDOP WILL HONOR IT NEXT.
// slot 5182
                if slot <> 5182 or instruction <> 31804 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    set words[0] to agcOverflowCorrected(words[0]).
                    local fixedOperand is mod(readEffective:call(words, 3132), 32768).
                    if fixedOperand = 127 {
                        set words[0] to agcSignExtend(mod(floor(words[0] / 1), 128) * 1).
                    } else {
                        set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                    }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 5183 {
// INTERPRETER.agc:96
//
// INTERPRETER.agc:97
//OPJUMP		TS	CYR			# LOWWD ENTERS HERE IF A RIGHT-HAND OP
// slot 5183
                if slot <> 5183 or instruction <> 22544 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 22544, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5184 {
// INTERPRETER.agc:98
//		CCS	CYR			# CODE IS TO BE PROCESSED.  TEST PREFICES.
// slot 5184
                    if slot <> 5184 or instruction <> 4112 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCCS(words, 16).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:99
//		TCF	OPJUMP2			# TEST SECOND PREFIX BIT.
// slot 5185
                    if slot <> 5185 or instruction <> 7335 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7335, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            }
        }
    } else {
        if slot <= 5187 {
            if slot <= 5186 {
// INTERPRETER.agc:100
//
// INTERPRETER.agc:101
//		TCF	EXIT			# +0 OP CODE IS EXIT
// slot 5186
                if slot <> 5186 or instruction <> 7651 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 7651, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            } else {
// INTERPRETER.agc:102
//
// INTERPRETER.agc:103
//# Page 1004
// INTERPRETER.agc:104
//# PROCESS ADDRESSES WHICH MAY BE DIRECT, INDEXED, OR REFERENCE THE PUSHDOWN LIST.
// INTERPRETER.agc:105
//
// INTERPRETER.agc:106
//ADDRESS		MASK	BIT1			# SEE IF ADDRESS IS INDEXED.  CYR CONTAINED
// slot 5187
                if slot <> 5187 or instruction <> 31211 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    set words[0] to agcOverflowCorrected(words[0]).
                    local fixedOperand is mod(readEffective:call(words, 2539), 32768).
                    if fixedOperand = 1 {
                        set words[0] to agcSignExtend(mod(floor(words[0] / 1), 2) * 1).
                    } else {
                        set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                    }
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 5188 {
// INTERPRETER.agc:107
//		CCS	A			# 400XX, SO BIT 1 IS NOW AS IT WAS IN CYR.
// slot 5188
                if slot <> 5188 or instruction <> 4096 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCCS(words, 0).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 5189 {
// INTERPRETER.agc:108
//		TCF	INDEX			# FORM INDEXED ADDRESS.
// slot 5189
                    if slot <> 5189 or instruction <> 7270 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 7270, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
// INTERPRETER.agc:109
//
// INTERPRETER.agc:110
//DIRADRES	INDEX	LOC			# LOOK AHEAD TO NEXT WORD TO SEE IF
// slot 5190
                    if slot <> 5190 or instruction <> 20596 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 20596, words[0], readEffective).
