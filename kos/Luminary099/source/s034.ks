    if slot <= 3450 {
        if slot <= 3449 {
// INTERPRETER.agc:3060
//
// INTERPRETER.agc:3061
//		TCF	SWSKIP		# HERE ONLY ON BIT 15.
// slot 3449
            if slot <> 3449 or instruction <> 5503 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 5503, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
// INTERPRETER.agc:3062
//
// INTERPRETER.agc:3063
//		TC	CCSHOLE
// slot 3450
            if slot <> 3450 or instruction <> 3013 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 3013, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 3451 {
// INTERPRETER.agc:3064
//		TC	CCSHOLE
// slot 3451
            if slot <> 3451 or instruction <> 3013 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 3013, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
            if slot <= 3452 {
// INTERPRETER.agc:3065
//
// INTERPRETER.agc:3066
// +9D		CA	Q		# 10 -- BRANCH IF OFF.
// slot 3452
                if slot <> 3452 or instruction <> 12290 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCA(words, 2).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
// INTERPRETER.agc:3067
//		TCF	TEST
// slot 3453
                if slot <> 3453 or instruction <> 5493 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 5493, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        }
    }
}
set agcAotRoutes[80] to agcAotUnit80@.

agcAotInstallSourceRope(list(
// INTERPRETER.agc:3068
//
// INTERPRETER.agc:3069
//B3TOB4		OCT	0014
// slot 3454
    3454, 24
)).

// bank 01, slots 3455-3456
function agcAotUnit81 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 3455 {
// INTERPRETER.agc:3070
//SWSKIP		INCR	LOC
// slot 3455
        if slot <> 3455 or instruction <> 10356 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
            agcCoreINCR(words, 116).
            return list(false, false, inheritedTransient, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// INTERPRETER.agc:3071
//
// INTERPRETER.agc:3072
//SW/		EQUALS	SWITCHES
// INTERPRETER.agc:3073
//
// INTERPRETER.agc:3074
// +13D		TCF	DANZIG		# 11 -- NOOP.
// slot 3456
        if slot <> 3456 or instruction <> 7217 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 7217, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
set agcAotRoutes[81] to agcAotUnit81@.

