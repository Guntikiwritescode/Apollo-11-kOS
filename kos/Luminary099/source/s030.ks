// PORT: Physical bank 23. Shared continuation entries, slots 22298–22298.
function agcAotUnit1366 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
// PORT: SOURCE INFLIGHT_ALIGNMENT_ROUTINES.agc:201
//		TC	ALARM
// PORT: Fixed ROM slots 22298.
    if slot <> 22298 or instruction <> 2935 { return choose false if checkOnly else -1. }
    if not extended {
        if checkOnly { return true. }
        return agcCoreControlExecute(words, 2935, words[0], readEffective).
    }
    return choose false if checkOnly else -1.
}
set agcAotRoutes[1366] to agcAotUnit1366@.

