                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            }
        } else {
            if slot <= 36007 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1060
//		MASK	LOW11		# ESUBK (NO DP) OR (ESUBK)+1 (garbled) FOR DP
// slot 36007
                if slot <> 36007 or instruction <> 30958 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    set words[0] to agcOverflowCorrected(words[0]).
                    local fixedOperand is mod(readEffective:call(words, 2286), 32768).
                    if fixedOperand = 2047 {
                        set words[0] to agcSignExtend(mod(floor(words[0] / 1), 2048) * 1).
