// bank 02, slots 4228-4247
function agcAotUnit156 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4237 {
        if slot <= 4232 {
            if slot <= 4229 {
                if slot <= 4228 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3111
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3112
//# IF INTERNAL MACH CADR TO BE SPECIFIED, MPAC+2 WILL BE PLACED INTO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3113
//# NOUNCADR IN ENTPAS0 (INTMCTBS).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3114
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3115
//		SETLOC	NVSUBEND +2
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3116
//		COUNT*	$$/PIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3117
//					# FORCE BIT 15 OF MONSAVE1 TO 1.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3118
//KILMONON	CAF	BIT15		# 	THIS IS THE KILL MONITOR BIT.
// slot 4228
                    if slot <> 4228 or instruction <> 14813 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        local fixedOperand is mod(readEffective:call(words, 2525), 32768).
                        set words[0] to agcSignExtend(fixedOperand).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3119
//		TS	MONSAVE1	# TURN OFF BIT 14, THE EXTERNAL
// slot 4229
                    if slot <> 4229 or instruction <> 23057 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 23057, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4230 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3120
//					# 	MONITOR BIT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3121
//		TC	Q
// slot 4230
                    if slot <> 4230 or instruction <> 2 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 2, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4231 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3122
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3123
//# LOADSTAT	+0	INACTIVE (WAITING FOR DATA). SET BY NVSUB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3124
//#		+1	PROCEED NO DATA. SET BY SPECIAL VERB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3125
//#		-1	TERMINATE. SET BY SPECIAL VERB.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3126
//#		-0		DATA IN		SET BY END OF LOAD ROUTINE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3127
//#			OR 	RESEQUENCE	SET BY VERB 32
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3128
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3129
//# L TO ENDIDLE (FIXED FIXED)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3130
//# ROUTINES THAT REQUEST LOADS THROUGH NVSUB SHOULD USE ENDIDLE WHILE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3131
//# WAITING FOR THE DATA TO BE LOADED. ENDIDLE PUTS CURRENT JOB TO SLEEP.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3132
//# ENDIDLE CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3133
//# SINCE JOB SLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3134
//# RECALTST TESTS LOADSTAT AND WAKES JOB UP TO,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3135
//#	L+1	FOR TERMINATE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3136
//#	L+2	FOR PROCEED WITHOUT DATA
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3137
//#	L+3	FOR DATA IN, OR RESEQUENCE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3138
//# IT DOES NOTHING IF LOADSTAT INDICATES WAITING FOR DTA.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3139
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3140
//# ENDIDLE ABORTS (WITH CODE 1206) IF A SECOND JOB ATTEMPTS TO GO TO SLEEP
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3141
//# Page 455
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3142
//# IN PINBALL. IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO ENDIDLE WHEN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3143
