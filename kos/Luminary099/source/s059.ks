// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2758
//		COUNT*	$$/PIN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2759
//ALMCYCLE	TC	FALTON		# TURN ON CHECK FAIL LIGHT.
// PORT: Fixed ROM slots 4197.
            if slot <> 4197 or instruction <> 2292 { return choose false if checkOnly else -1. }
            if not extended {
