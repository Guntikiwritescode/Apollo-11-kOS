// bank 02, slots 4226-4227
function agcAotUnit155 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4226 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3033
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3034
//PINSUPBT	=	NVSBBBNK	# CONTAINS THE PINBALL SUPERBITS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3035
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3036
//NVSUBEND	DXCH	NVQTEM		# NVBNKTEM MUST = NVQTEM+1
// slot 4226
        if slot <> 4226 or instruction <> 22048 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            if not agcCoreDoubleExchange(words, "DXCH", 544, readPhysical, readAdjacent) { return -1. }
            return list(false, false, true, false, false).
        }
        return choose false if checkOnly else -1.
    } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3037
//		TC	SUPDXCHZ	# DTCB WITH SUPERBIT SWITCHING
// slot 4227
        if slot <> 4227 or instruction <> 2677 { return choose false if checkOnly else -1. }
        if not extended {
            if checkOnly { return true. }
            return agcCoreControlExecute(words, 2677, words[0], readEffective).
        }
        return choose false if checkOnly else -1.
    }
}
set agcAotRoutes[155] to agcAotUnit155@.

// bank 41, slots 36686-36690
function agcAotUnit2476 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 36687 {
        if slot <= 36686 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3038
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3039
//		SETLOC	ENDRQWT +1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3040
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3041
//		COUNT*	$$/PIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3042
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3043
//# BLANKDSP BLANKS DISPLAY ACCORDING TO OPTION NUMBER IN NVTEMP AS FOLLOWS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3044
//# Page 453
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3045
//#  -4 FULL BLANK, -3 LEAVE MODE, -2 LEAVE MODE AND VERB, -1 BLANK R'S ONLY.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3046
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3047
//BLANKDSP	AD	SEVEN		# 7,8,9, OR 10 (A HAD 0,1,2,OR 3)
// slot 36686
            if slot <> 36686 or instruction <> 27119 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                local entryA is words[0].
                local fixedOperand is mod(readEffective:call(words, 2543), 32768).
                set words[0] to agcAddSP16(entryA, agcSignExtend(fixedOperand)).
                return list(false, false, inheritedTransient, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3048
//		INHINT
// slot 36687
            if slot <> 36687 or instruction <> 4 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 4, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        }
    } else {
        if slot <= 36688 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3049
//		TS	CODE		# BLANK SPECIFIED DSPTABS
// slot 36688
            if slot <> 36688 or instruction <> 22612 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                return agcCoreControlExecute(words, 22612, words[0], readEffective).
            }
            return choose false if checkOnly else -1.
        } else {
            if slot <= 36689 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3050
//		CS	BIT12
// slot 36689
                if slot <> 36689 or instruction <> 18912 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local fixedOperand is mod(readEffective:call(words, 2528), 32768).
                    set words[0] to agcSignExtend(32767 - fixedOperand).
                    return list(false, false, true, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3051
//		INDEX	CODE
// slot 36690
                if slot <> 36690 or instruction <> 20564 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 20564, words[0], readEffective).
                }
                if extended {
                    if checkOnly { return true. }
                    return agcCoreControlExecute(words, 20564, words[0], readEffective).
                }
                return choose false if checkOnly else -1.
            }
        }
    }
}
set agcAotRoutes[2476] to agcAotUnit2476@.

