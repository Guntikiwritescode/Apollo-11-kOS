// PORT: Physical bank 02. Shared continuation entries, slots 4204–4224.
function agcAotUnit154 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 4213 {
        if slot <= 4208 {
            if slot <= 4205 {
                if slot <= 4204 {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2938
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2939
//ENDRELDS	EQUALS
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2940
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2941
//# Page 451
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2942
//# NVSUB IS USED FOR SUBROUTINE CALLS FROM WITHIN COMPUTER. IT CAN BE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2943
//# USED TO CALL THE COMBINATION OF ANY DISPLAY, LOAD, OR MONITOR VERB
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2944
//# TOGETHER WITH ANY NOUN AVAILABLE TO THE KEYBOARD.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2945
//# PLACE 0VVVVVVVNNNNNNN INTO A.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2946
//# V'S ARE THE 7-BIT VERB CODE.  N'S ARE THE 7-BIT NOUN CODE.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2947
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2948
//# IF NVSUB IS CALLED WTIH THE FOLLOWING NEGATIVE NUMBERS (RATHER THAN THE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2949
//# VERB-NOUN CODE) IN A, THEN THE DISPLAY IS BLANKED AS FOLLOWS -
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2950
//#  -4 FULL BLANK, -3 LEAVE MODE, -2 LEAVE MODE AND VERB, -1 BLANK R'S ONLY.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2951
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2952
//# NVSUB CAN BE USED WTIH MACH CADR TO BE SPEC BY PLACING THE CADR INTO
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2953
//# MPAC+2 BEFORE THE STANDARD NVSUB CALL.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2954
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2955
//# NVSUB RETURNS TO 2+ CALLING LOC AFTER PERFORMING TASK, IF DISPLAY
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2956
//# SYSTEM IS AVAIALBLE. THE NEW NOUN AND VERB CODES ARE DISPLAYED.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2957
//# IF V'S =0, THE NEW NOUN CODE IS DISPLAYED ONLY (RETURN WITH NO FURTHER
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2958
//# ACTION). IF N'S =0, THE NEW VERB CODE IS DISPLAYED ONLY (RETURN WITH NO
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2959
//# FURTHER ACTION).
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2960
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2961
//# IT RETURNS TO 1+ CALLING LOC WITHOUT PERFORMING TASK, IF DISPLAY
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2962
//# SYSTEM IS BLOCKED (NOTHING IS DISPLAYED IN THIS CASE).
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2963
//# IT DOES TC ABORT (WITH OCT 01501) IF IT ENCOUNTERS A DISPLAY PROGRAM
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2964
//# ALARM CONDITION BEFORE RETURN TO CALLER.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2965
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2966
//# THE DISPLAY SYSTEM IS BLOCKED BY THE DEPRESSION OF ANY
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2967
//# KEY, EXCEPT ERROR LIGHT RESET.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2968
//# IT IS RELEASED BY THE KEY RELEASE BUTTON, ALL EXTENDED VERBS,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2969
//# PROCED WITHOUT DATA, TERMINATE, RESEQUENCE, INITIALIZE EXECUTIVE,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2970
//# RECALL PART OF RECALTST IF ENDIDLE WAS USED,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2971
//# VB = REQUEST EXECUTIVE, VB = REQUEST WAITLIST,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2972
//# MONITOR SET UP.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2973
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2974
//# THE DISPLAY SYSTEM IS ALSO BLOCKED BY THE EXTERNAL MONITOR BIT, WHICH
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2975
//# INDICATES AND EXTERNALLY INITIATED MONITOR IS RUNNING (SEE MONITOR).
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2976
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2977
//# A NVSUB CALL THAT PASSES DSPLOCK AND THE EXTERNAL MONITOR BIT ENDS OLD
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2978
//# MONITOR.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2979
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2980
//# DSPLOCK IS THE INTERLOCK FOR USE OF KEYBOARD AND DISPLAY SYSTEM WHICH
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2981
//# LOCKS OUT INTERNAL USE WHENEVER THERE IS EXTERNAL KEYBOARD ACTION.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2982
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2983
//# NVSUB SHOULD BE USED TWICE IN SUCCESSION FOR 'PLEASE PERFORM' SITUATIONS
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2984
//# (SIMILARLY FOR PLEASE MARK).  FIRST PLACE THE CODED NUMBER FOR WHAT
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2985
//# ACTION IS DESIRED OF OPERATOR INTO THE REGISTERS REFERRED TO BY THE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2986
//# 'CHECKLIST' NOUN. GO TO NVSUB WITH A DISPLAY VERB AND THE 'CHECKLIST'
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2987
//# NOUN.  GO TO NVSUB AGAIN WTIH THE 'PLEASE PERFORM' VERB AND ZEROS IN THE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2988
//# LOW 7 BITS. THIS 'PASTES UP' THE 'PLEASE PERFORM' VERB INTO THE VERB
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2989
//# LIGHTS.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2990
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2991
//# NVMONOPT IS AN ENTRY SIMILAR TO NVSUB, BUT REQUIRING AN ADDITIONAL
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2992
//# Page 452
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2993
//# PARAMETER IN L. IT SHOULD BE USED ONLY WITH A MONITOR VERB-NOUN CODE IN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2994
//# A. AFTER EACH MONITOR DISPLAY A *PLEASE* VERB WILL BE PASED INT THE VERB
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2995
//# LIGHTS OR DATA WILL BE BLANKED (OR BOTH) ACCORDING TO THE OPTIONS
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2996
//# SPECIFIED IN L. IF BITS 8-14 OF L ARE OTHER THAN ZERO, THEN THEY WILL
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2997
//# BE INTERPRETED AS A VERB CODE AND PASTED IN THE VERB LIGHTS. (THIS VERB
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2998
//# CODE SHOULD DESIGNATE ONE OF THE *PLEASE* VERBS.)  IF BITS 1-3 OF L ARE
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2999
//# OTHER THAN ZERO, THEN THEY WILL BE USED TO BLANK DATA BY BEING FED TO
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3000
//# BLANKSUB.  IF NVMONOPT IS USED WITH A VERB OTHER THAN A MONITOR VERB,
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3001
//# THE PARAMETER IN L HAS NO EFFECT.
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3002
//#
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3003
//# NVSUB IN FIXED-FIXED PLACES 2+CALLING LOC INTO NVQTEM, TC NVSUBEND INTO
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3004
//# ENTRET. (THIS WILL RESTORE OLD CALLING BANK BITS)
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3005
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3006
//		SETLOC	ENDALM +1
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3007
//
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3008
//		COUNT*	$$/PIN
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3009
//NVSUB		LXCH	7		# ZERO NVMONOPT OPTIONS
// PORT: Fixed ROM slots 4204.
                    if slot <> 4204 or instruction <> 9223 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreExchange(words, 1, 7, readPhysical).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
// PORT: SOURCE PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3010
//NVMONOPT	TS	NVTEMP
// PORT: Fixed ROM slots 4205.
                    if slot <> 4205 or instruction <> 22611 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        return agcCoreControlExecute(words, 22611, words[0], readEffective).
                    }
                    return choose false if checkOnly else -1.
                }
