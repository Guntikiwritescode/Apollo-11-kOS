// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3537
//NVSUBUSY	TC	POSTJUMP	# TO BE ENTERED.
// slot 4386
                            if slot <> 4386 or instruction <> 2461 { return choose false if checkOnly else -1. }
                            if not extended {
                                if checkOnly { return true. }
                                return agcCoreControlExecute(words, 2461, words[0], readEffective).
                            }
                            return choose false if checkOnly else -1.
                        }
                    }
                }
            }
        }
    }
}
