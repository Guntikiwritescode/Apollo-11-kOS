//# Page 410
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1031
//# NNADTAB CONTAINS A RELATIVE ADDRESS, IDADDREL (IN LOW 10 BITS), REFERRING
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1032
//# TO WHERE 3 CONSECUTIVE ADDRESSES ARE STORED (IN IDADDTAB).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1033
