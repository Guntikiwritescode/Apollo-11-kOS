//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:1036
//MIXNOUN		CCS	NNADTEM
// slot 35985
                if slot <> 35985 or instruction <> 4198 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreCCS(words, 102).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
            } else {
                if slot <= 35986 {
