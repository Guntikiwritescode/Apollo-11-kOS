                    }
                    return choose false if checkOnly else -1.
                } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3151
//		CA	L		# DONT SET DSPLOC TO 1 SO CAN USE
// slot 4234
                    if slot <> 4234 or instruction <> 12289 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        agcCoreCA(words, 1).
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                }
            } else {
                if slot <= 4235 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3152
//		MASK	LOW10		# ENDIDLE WITH NVSUB INITIATED MONITOR.
// slot 4235
                    if slot <> 4235 or instruction <> 31242 { return choose false if checkOnly else -1. }
                    if not extended {
                        if checkOnly { return true. }
                        local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                        set words[0] to agcOverflowCorrected(words[0]).
                        local fixedOperand is mod(readEffective:call(words, 2570), 32768).
                        if fixedOperand = 1023 {
                            set words[0] to agcSignExtend(mod(floor(words[0] / 1), 1024) * 1).
                        } else {
                            set words[0] to agcSignExtend(agcAnd16(words[0], fixedOperand)).
                        }
                        return list(false, false, inheritedTransient, false, false).
                    }
                    return choose false if checkOnly else -1.
                } else {
                    if slot <= 4236 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3153
//		AD	FBANK		# SAME STRATEGY FOR CADR AS MAKECADR.
// slot 4236
                        if slot <> 4236 or instruction <> 24580 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                            agcCoreAD(words, 4).
                            return list(false, false, inheritedTransient, false, false).
                        }
                        return choose false if checkOnly else -1.
                    } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3154
//		TS	CADRSTOR
// slot 4237
                        if slot <> 4237 or instruction <> 23074 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            return agcCoreControlExecute(words, 23074, words[0], readEffective).
                        }
                        return choose false if checkOnly else -1.
                    }
                }
            }
        }
    } else {
        if slot <= 4242 {
