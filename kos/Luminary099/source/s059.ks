// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2903
//# AND THE EXTERNAL MONITOR BIT (FREEING THE DISPLAY SYSTEM FOR INTERNAL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2904
