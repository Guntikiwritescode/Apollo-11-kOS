// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3144
//#	EXCEEDED. (+-NZ INDICATES A JOB IS ALREADY ASLEEP DUE TO ENDIDDLE.)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3145
//# 2)	DSPLIST NOT= +0. THIS INDICATES A JOB IS ALREADY ASLEEP DUE TO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3146
//#	NVSUBUSY.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3147
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3148
//ENDIDLE		LXCH	Q		# RETURN ADDRESS INTO L.
// slot 4231
                        if slot <> 4231 or instruction <> 9218 { return choose false if checkOnly else -1. }
                        if not extended {
                            if checkOnly { return true. }
                            local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
