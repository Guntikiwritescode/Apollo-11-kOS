// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3157
//ENDINST		TC	ENDOFJOB
// slot 4239
                    if slot <> 4239 or instruction <> 2669 { return choose false if checkOnly else -1. }
                    if not extended {
