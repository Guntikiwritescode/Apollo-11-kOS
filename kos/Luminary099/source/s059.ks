// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3484
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3485
//# Page 463
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3486
//# INTERNAL USE OF KEYBOARD AND DISPLAY PROGRAM.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3487
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3488
//# USER MUST SCHEDULE CALLS TO NVSUB SO THAT THERE IS NO CONFLICT OF USE OR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3489
//# CONFUSION TO OPERATOR. THE OLD GRABLOCK (INTERNAL/INTERNAL INTERLOCK)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3490
//# HAS BEEN REMOVED AND THE INTERNAL USER NO LONGER HAS THE PROTECTION THIS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3491
//# OFFERED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3492
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3493
//# THERE ARE TWO WAYS A JOB CAN BE PUT TO SLEEP BY THE KEYBOARD + DISPLAY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3494
//# PROGRAM.	1) BY ENDIDLE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3495
//#		2) BY NVSUBUSY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3496
//# THE BASIC CONVENTION IS THAT ONLY ONE JOB WILL BE PERMITTED ASLEEP VIA
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3497
//# THE KEYBOARD + DISPLAY PROGRAM AT A TIME. IF A JOB ATTEMPTS TO GO TO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3498
//# SLEEP BY MEANS OF (1) OR (2) AND THERE IS ALREADY A JOB ASLEEP THAT WAS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3499
//# PUT TO SLEEP BY (1) OR (2), THEN AN ABORT IS CAUSED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3500
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3501
//# THE CALLING SEQUENCE FOR NVSUB IS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3502
//#			CAF		V/N
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3503
//#	L		TC		NVSUB
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3504
//#	L+1		RETURN HERE IF OPERATOR HAS INTERVENED
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3505
//#	L+2		RETURN HERE AFTER EXECUTION
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3506
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3507
//# A ROUTINE CALLED NVSUBUSY IS PROVIDED (USE IS OPTIONAL) TO PUT
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3508
//# YOUR JOB TO SLEEP UNTIL THE OPERATOR RELEASES THE KEYBOARD + DISPLAY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3509
//# SYSTEM. NVSUBUSY ALSO TURNS ON THE KEY RELEASE LIGHT.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3510
//# NVSUBUSY CANNOT BE CALLED FROM ERASABLE OR F/F MEMORY,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3511
//# SINCE JOBSLEEP AND JOBWAKE CAN HANDLE ONLY FIXED BANKS.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3512
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3513
//# THE CALLING SEQUENCE IS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3514
//#	CAF	WAKEFCADR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3515
//#	TC	NVSUBUSY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3516
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3517
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3518
//# .
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3519
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3520
//# NVSUBUSY IS INTENDED FOR USE WHEN AN INTERNAL PROGRAM FINDS THE OPERATOR
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3521
//# IS NOT USING THE KEYBOARD + DISPLAY PROGRAM (BY HIS OWN INITIATION). IT IS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3522
//# NOT INTENDED FOR USE WHEN ONE INTERNAL PROGRAM FINDS ANOTHER INTERNAL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3523
//# PROGRAM USING THE KEYBOARD + DISPLAY PROGRAM.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3524
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3525
//# NVSUBUSY ABORTS (WITH CODE 01206) IF A SECOND JOB ATTEMPTS TO GO TO
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3526
//# SLEEP IN PINBALL. IN PARTICULAR, IF AN ATTEMPT IS MADE TO GO TO NVSUBUSY
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3527
//# WHEN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3528
//# 1)	DSPLIST NOT= +0.  THIS IS THE CASE WHERE THE CAPACITY OF THE DSPLIST
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3529
//#	IS EXCEEDED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3530
//# 2) 	CADRSTOR NOT= +0.  THIS INDICATES THAT A JOB IS ALREADY USING
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3531
//# Page 464
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3532
//# ENDIDLE.  (+-NZ INDICATE A JOB IS ALREADY ASLEEP DUE TO ENDIDLE.)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3533
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3534
//PRENVBSY	CS	2K+3		# SPECIAL ENTRANCE FOR ROUTINES IN FIXED
// slot 4383
                            if slot <> 4383 or instruction <> 18724 { return choose false if checkOnly else -1. }
                            if not extended {
                                if checkOnly { return true. }
                                local fixedOperand is mod(readEffective:call(words, 2340), 32768).
                                set words[0] to agcSignExtend(32767 - fixedOperand).
                                return list(false, false, true, false, false).
                            }
                            return choose false if checkOnly else -1.
                        }
                    }
                } else {
                    if slot <= 4384 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:3535
//		AD	Q		# BANKS ONLY DESIRING THE FCADR OF (LOC
// slot 4384
