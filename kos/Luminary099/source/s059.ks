            }
            return choose false if checkOnly else -1.
        } else {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2760
//		CS	VERBSAVE	# GET ORIGINAL VERB THAT WAS EXECUTED
// slot 4198
