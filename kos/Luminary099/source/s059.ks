// bank 41, slots 36504-36510
function agcAotUnit2462 {
    parameter words, slot, instruction, extended, checkOnly, readPhysical, readAdjacent, readEffective, channelAdapter.
    if slot <= 36506 {
        if slot <= 36504 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2301
//ENDHMSS		EQUALS
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2302
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2303
//# Page 437
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2304
//# MONITOR ALLOWS OTHER KEYBOARD ACTIVITY. IT IS ENDED BY VERB TERMINATE,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2305
//# VERB PROCEED WITHOUT DATA, VERB RESEQUENCE,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2306
//# ANOTHER MONITOR, OR ANY NVSUB CALL THAT PASSES THE DSPLOCK (PROVIDED
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2307
//# THAT THE OPERATOR HAS SOMEHOW ALLOWED THE ENDING OF A MONITOR WHICH
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2308
//# HE HAS INITIATED THROUGH THE KEYBOARD).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2309
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2310
//# MONITOR ACTION IS SUSPENDED, BUT NOT ENDED, BY ANY KEYBOARD ACTION,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2311
//# EXCEPT ERROR LIGHT RESET. IT BEGINS AGAIN WHEN KEY RELEASE IS PERFORMED.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2312
//# MONITOR SAVES THE NOUN AND APPROPRIATE DISPLAY VERB IN MONSAVE. IT SAVES
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2313
//# NOUNCADR IN MONSAVE1, IF NOUN = MACHINE CADR TO BE SPECIFIED. BIT 15 OF
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2314
//# MONSAVE1 IS THE KILL MONITOR SIGNAL (KILLER BIT). BIT 14 OF MONSAVE1
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2315
//# INDICATES THE CURRENT MONITOR WAS EXTERNALLY INITIATED (EXTERNAL
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2316
//# MONITOR BIT). IT IS TURNED OFF BY RELDSP AND KILMONON.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2317
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2318
//# MONSAVE INDICATES IF MONITOR IS ON (+=ON, +0=OFF)
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2319
//# IF MONSAVE IS +, MONITOR ENTERS NO REQUEST, BUT TURNS KILLER BIT OFF.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2320
//# IF MONSAVE IS +0, MONITOR ENTERS REQUEST AND TURNS KILLER BIT OFF.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2321
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2322
//# NVSUB (IF EXTERNAL MONITOR BIT IS OFF), VB=PROCEED WITHOUT DATA,
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2323
//# VB=RESEQUENCE, AND VB=TERMINATE TURN KILL MONITOR BIT ON.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2324
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2325
//# IF KILLER BIT IS ON, MONREQ ENTERS NO FURTHER REQUESTS, ZEROS MONSAVE
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2326
//# AND MONSAVE1 (TURNING OFF KILLER BIT AND EXTERNAL MONITOR BIT).
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2327
//#
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2328
//# MONITOR DOESNT TEST FOR MATBS SINCE NVSUB CAN HANDLE INTERNAL MATBS NOW.
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2329
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2330
//		SETLOC	ENDRUTIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2331
//
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2332
//		COUNT*	$$/PIN
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2333
//MONITOR		CS	BIT15/14
// slot 36504
            if slot <> 36504 or instruction <> 18079 { return choose false if checkOnly else -1. }
            if not extended {
                if checkOnly { return true. }
                local fixedOperand is mod(readEffective:call(words, 1695), 32768).
                set words[0] to agcSignExtend(32767 - fixedOperand).
                return list(false, false, true, false, false).
            }
            return choose false if checkOnly else -1.
        } else {
            if slot <= 36505 {
// PINBALL_GAME_BUTTONS_AND_LIGHTS.agc:2334
//		MASK	NOUNCADR
// slot 36505
                if slot <> 36505 or instruction <> 29199 { return choose false if checkOnly else -1. }
                if not extended {
                    if checkOnly { return true. }
                    local inheritedTransient is agcCoreInheritedTCTransient(words, instruction).
                    agcCoreMASK(words, 527).
                    return list(false, false, inheritedTransient, false, false).
                }
                return choose false if checkOnly else -1.
